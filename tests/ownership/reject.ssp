// case shadow_linear E_RES_LEAK
profile sys

res type File = {fd: Int} drop close
res type Tok = {id: Int}

fn close(f: File)
= ()

fn open(fd: Int) -> File
= File{fd}

fn consume(f: File) -> Int
= f.fd

fn eat(t: Tok) -> Int
= do
  Tok{id} = t
  id

fn size(f: &File) -> Int
= f.fd

fn bump(f: &mut File)
= do
  f.fd := f.fd + 1
  ()

fn f() -> Int
= do
  t = Tok{id: 1}
  t = Tok{id: 2}
  eat(t)

// case linear_in_loop_break_return E_RES_LEAK
profile sys

res type File = {fd: Int} drop close
res type Tok = {id: Int}

fn close(f: File)
= ()

fn open(fd: Int) -> File
= File{fd}

fn consume(f: File) -> Int
= f.fd

fn eat(t: Tok) -> Int
= do
  Tok{id} = t
  id

fn size(f: &File) -> Int
= f.fd

fn bump(f: &mut File)
= do
  f.fd := f.fd + 1
  ()

fn f(x: Int) -> Int
= do
  t = Tok{id: 1}
  for i in 0..3
    if i == x then return i
  eat(t)

// case par_local_fn_race E_PAR_SHARE
fn f() -> Int
= do
  var s = 0
  fn bump(k: Int) -> Int
  = do
    s := s + k
    s
  (a, b) = par(bump(1), bump(2))
  s

// case par_nested_race E_PAR_RACE
fn f() -> Int
= do
  var s = 0
  for w in par(0..2)
    (a, b) = par(1, 2)
    s := a
  s

// case par_task_block_race E_PAR_RACE
fn f() -> Int
= do
  var s = 0
  (a, b) = par(do
      s := 1
      1, 2)
  s

// case par_nested_local_fn E_PAR_SHARE
fn f() -> Int
= do
  var s = 0
  fn bump(k: Int) -> Int
  = do
    s := s + k
    s
  fn twice(k: Int) -> Int
  = bump(k) + bump(k)
  (a, b) = par(twice(1), 2)
  s

// case par_fn_in_record E_PAR_SHARE
type H = {f: Int -> Int}
fn call(h: H, k: Int) -> Int
= do
  g = h.f
  g(k)
fn f() -> Int
= do
  var s = 0
  fn bump(k: Int) -> Int
  = do
    s := s + k
    s
  h = H{f: bump}
  (a, b) = par(call(h, 1), call(h, 2))
  s

// case par_generic_wrapper E_PAR_SHARE
type Box[T] = {v: T}
fn call(b: Box[Int -> Int], k: Int) -> Int
= do
  g = b.v
  g(k)
fn f() -> Int
= do
  var s = 0
  fn bump(k: Int) -> Int
  = do
    s := s + k
    s
  bx = Box{v: bump}
  (a, b) = par(call(bx, 1), call(bx, 2))
  s

// case par_for_fn_elems E_PAR_SHARE
type H = {f: Int -> Int}
fn call(h: H, k: Int) -> Int
= do
  g = h.f
  g(k)
fn f() -> Int
= do
  var s = 0
  fn bump(k: Int) -> Int
  = do
    s := s + k
    s
  hs = [H{f: bump}, H{f: bump}]
  for h in par(hs)
    x = call(h, 1)
  s
