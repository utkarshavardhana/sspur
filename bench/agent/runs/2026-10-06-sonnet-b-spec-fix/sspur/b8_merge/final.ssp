type ConfigErr = MissingKey{path: Str}

type J = JNull | JBool{b: Bool} | JNum{n: Int} | JStr{s: Str} | JArr{items: List[J]} | JObj{fields: List[(Str, J)]}

fn apply_entry(fs: List[(Str, J)], e: (Str, J)) -> List[(Str, J)]
= match e.1
| JNull => fs.filter(f => f.0 != e.0)
| v => if fs.any(f => f.0 == e.0) then fs.map(f => if f.0 == e.0 then (f.0, merge(f.1, v)) else f) else fs + [(e.0, merge(JNull, v))]

fn arr_at(items: List[J], k: Str) -> Opt[J]
= match k.to_int
| some(i) => if i >= 0 then items.get(i) else none
| none => none

fn base_fields(t: J) -> List[(Str, J)]
= match t
| JObj{fields} => fields
| _ => []

fn defaults() -> J
= JObj{fields: [("name", JStr{s: "app"}), ("port", JNum{n: 8080}), ("db", JObj{fields: [("host", JStr{s: "localhost"}), ("pool", JNum{n: 5})]}), ("tags", JArr{items: [JStr{s: "a"}]})]}

fn esc(s: Str) -> Str
= s.replace("\\", "\\\\").replace("\"", "\\\"")

fn get_field(j: J, key: Str) -> Opt[J]
= match j
| JObj{fields} => fields.find(_.0 == key).map(_.1)
| _ => none

fn get_path(j: J, path: Str) -> Opt[J]
= do
  var cur = some(j)
  for k in path.split(".")
    cur := match cur
    | some(v) => step(v, k)
    | none => none
  cur

fn main() -> Unit ! log
= log(render(merge(defaults(), JObj{fields: [("port", JNum{n: 9090})]})))

fn merge(target: J, patch: J) -> J
= match patch
| JObj{fields} => JObj{fields: fields.fold(base_fields(target), (acc, e) => apply_entry(acc, e))}
| _ => patch

fn merge_all(base: J, patches: List[J]) -> J
= patches.fold(base, (acc, p) => merge(acc, p))

fn o(fs: List[(Str, J)]) -> J
= JObj{fields: fs}

fn render(j: J) -> Str
= match j
| JNull => "null"
| JBool{b} => if b then "true" else "false"
| JNum{n} => n.str
| JStr{s} => "\"" + esc(s) + "\""
| JArr{items} => "[" + items.map(render).join(",") + "]"
| JObj{fields} => "\{" + fields.map(f => "\"" + esc(f.0) + "\":" + render(f.1)).join(",") + "}"

fn require(j: J, paths: List[Str]) -> Unit ! fail[ConfigErr]
= do
  for p in paths
    if get_path(j, p).is_none then raise MissingKey{path: p}

fn step(j: J, k: Str) -> Opt[J]
= match j
| JObj{fields} => fields.find(_.0 == k).map(_.1)
| JArr{items} => arr_at(items, k)
| _ => none

test arr_path = get_path(o([("servers", JArr{items: [o([("host", JStr{s: "a"})]), o([("host", JStr{s: "b"})])]})]), "servers.1.host") == some(JStr{s: "b"})

test arr_path_missing = get_path(o([("s", JArr{items: [JNull]})]), "s.1") == none and get_path(o([("s", JArr{items: [JNull]})]), "s.-1") == none and get_path(o([("s", JArr{items: [JNull]})]), "s.x") == none

test escapes = render(o([("k\"\\", JStr{s: "a\"b\\c"})])) == "\{\"k\\\"\\\\\":\"a\\\"b\\\\c\"}"

test merge_all_order = render(merge_all(o([("a", JNum{n: 1})]), [o([("a", JNum{n: 2}), ("b", JNum{n: 1})]), o([("a", JNull)]), o([("b", JNum{n: 5})])])) == "\{\"b\":5}"

test merges_top_level = get_path(merge(defaults(), JObj{fields: [("name", JStr{s: "web"})]}), "name") == some(JStr{s: "web"})

test order_kept = render(merge(o([("a", JNum{n: 1}), ("b", JNum{n: 2})]), o([("c", JNum{n: 3}), ("b", JNum{n: 9}), ("a", JNum{n: 8})]))) == "\{\"a\":8,\"b\":9,\"c\":3}"

test path = get_path(defaults(), "db.pool") == some(JNum{n: 5}) and get_path(defaults(), "db.user") == none

test renders = render(JObj{fields: [("a", JArr{items: [JNum{n: 1}, JBool{b: true}, JNull]})]}) == "\{\"a\":[1,true,null]}"

test require_missing = catch require(defaults(), ["name", "db.user", "x"]) == ()
| MissingKey{path} => path == "db.user"

test require_ok = catch require(defaults(), ["name", "db.pool"]) == ()
| _ => false

test rfc_array_replace = render(merge(o([("a", JArr{items: [JNum{n: 1}, JNum{n: 2}]})]), o([("a", JArr{items: [JNum{n: 3}]})]))) == "\{\"a\":[3]}"

test rfc_basic = render(merge(o([("a", JNum{n: 1}), ("b", JNum{n: 2})]), o([("a", JNull), ("c", JNum{n: 3})]))) == "\{\"b\":2,\"c\":3}"

test rfc_nested = render(merge(o([("a", o([("x", JNum{n: 1}), ("y", JNum{n: 2})]))]), o([("a", o([("x", JNull), ("z", JNum{n: 3})]))]))) == "\{\"a\":\{\"y\":2,\"z\":3}}"

test rfc_nonobj_patch = merge(o([("a", JNum{n: 1})]), JStr{s: "x"}) == JStr{s: "x"} and merge(o([("a", JNum{n: 1})]), JNull) == JNull

test rfc_nonobj_target = render(merge(JNum{n: 1}, o([("a", o([("b", JNull), ("c", JNum{n: 1})]))]))) == "\{\"a\":\{\"c\":1}}"
