fn scratch(tag: Str) -> Str ! env, time
= "{trim_end_slash(env_var("TMPDIR").or("/tmp"))}/sspur_handles_{tag}_{mono_ns()}"

fn trim_end_slash(p: Str) -> Str
= if p.ends_with("/") then p.take(p.len - 1) else p

fn short(r: Res[Unit, Str], p: Str) -> Str
= match r
  | ok(_) => "ok"
  | err(e) => e.drop(p.len + 2)

fn writer(p: Str, xs: List[Str]) -> Res[Int, Str] ! fs
= with_file(p, "w", f => xs.fold(0, (n, x) => if f.write(x + "\n").is_ok then n + 1 else n))

fn line_lengths(p: Str) -> Res[Res[List[Int], Str], Str] ! fs
= with_file(p, "r", f => f.fold_lines([], (acc, l) => acc.push(l.len)))

fn streaming(tag: Str) -> List[Str] ! fs, env, time
= do
  p = scratch(tag)
  w = writer(p, ["alpha", "", "gamma delta", "ünïcödé", "last"])
  ls = line_lengths(p)
  all = with_file(p, "r", f => f.lines)
  gone = remove_file(p)
  ["{w}", "{ls}", "{all}"]

fn seeking(tag: Str) -> List[Str] ! fs, env, time
= do
  p = scratch(tag)
  r = with_file(p, "w+", f => do
    a = f.write("0123456789")
    b = f.seek(3)
    c = f.read(4)
    d = f.tell
    e = f.seek(8)
    g = f.write("XYZ")
    h = f.size
    i = f.seek(0)
    j = f.read_all
    k = f.read_line
    "{c} {d} {h} {j} {k}")
  gone = remove_file(p)
  [r.or("")]

fn lines_crlf(tag: Str) -> List[Str] ! fs, env, time
= do
  p = scratch(tag)
  w = write_file(p, "one" + from_codes([13]).get + "\ntwo\n\nthree")
  r = with_file(p, "r", f => do
    a = f.read_line
    b = f.read_line
    c = f.read_line
    d = f.read_line
    e = f.read_line
    [a, b, c, d, e].map(x => "{x}"))
  gone = remove_file(p)
  r.or([])

fn closing(tag: Str) -> List[Str] ! fs, env, time
= do
  p = scratch(tag)
  r = match open_file(p, "a")
    | err(e) => [e]
    | ok(f) => do
      a = f.write("x")
      b = f.close
      c = f.close
      d = f.write("y")
      [short(a, p), short(b, p), short(c, p), short(d, p)]
  t = read_file(p)
  gone = remove_file(p)
  r.push("{t}")

fn failures(tag: Str) -> List[Str] ! fs, env, time
= do
  p = scratch(tag)
  missing = match open_file(p, "r")
    | ok(_) => "opened"
    | err(e) => e.drop(p.len + 2)
  wrote = write_file(p, "abc")
  ro = with_file(p, "r", f => short(f.write("no"), p))
  bin = with_file(p, "a", f => short(f.write_bytes([1, 300]), p))
  bytes = with_file(p, "a+", f => do
    w = f.write_bytes([0, 255])
    s = f.seek(0)
    f.read(100))
  gone = remove_file(p)
  [missing, "{ro}", "{bin}", "{bytes}"]

type Leak = Leak{f: File}

fn leak(p: Str) -> Res[Int, Str] ! fs, fail[Leak]
= with_file(p, "r", f => if f.size.or(0) > 0 then raise Leak{f} else 0)

fn raised(tag: Str) -> Str ! fs, env, time
= do
  p = scratch(tag)
  w = write_file(p, "data")
  r = catch "{leak(p)}"
    | Leak{f} => short(f.seek(1), p)
  gone = remove_file(p)
  "{r}"

fn escape(tag: Str) -> Str ! fs, env, time
= do
  p = scratch(tag)
  w = write_file(p, "data")
  h = with_file(p, "r", f => f)
  r = match h
    | ok(f) => short(f.read(2).map(x => ()), p)
    | err(e) => e
  gone = remove_file(p)
  r

test streams = streaming("s") == ["ok(5)", "ok(ok([5, 0, 11, 7, 4]))", "ok(ok([\"alpha\", \"\", \"gamma delta\", \"ünïcödé\", \"last\"]))"]
test seeks = seeking("k") == ["ok([51, 52, 53, 54]) ok(7) ok(11) ok(\"01234567XYZ\") ok(none)"]
test crlf = lines_crlf("c") == ["ok(some(\"one\"))", "ok(some(\"two\"))", "ok(some(\"\"))", "ok(some(\"three\"))", "ok(none)"]
test closes = closing("x") == ["ok", "ok", "file is closed", "file is closed", "ok(\"x\")"]
test fails = failures("f") == ["not found", "ok(\"not open for this operation\")", "ok(\"byte out of range\")", "ok(ok([97, 98, 99, 0, 255]))"]
test scoped = escape("e") == "file is closed"
test raise_closes = raised("r") == "file is closed"
