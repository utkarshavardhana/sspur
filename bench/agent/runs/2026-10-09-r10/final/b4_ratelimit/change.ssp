type LimitErr = ClockSkew{last: Int, now: Int} | TooLarge{n: Int, capacity: Int}

type Bucket = {capacity: Int, rate: Int, tokens: Int, last: Int}

type Keyed = {capacity: Int, rate: Int, buckets: List[(Str, Bucket)]}

fn allow(w: Window, now: Int) -> (Bool, Window) ! fail[LimitErr]
= do
  if now < w.start then raise ClockSkew{last: w.start, now: now}
  w2 = if now >= w.start + w.size then w with start := now, count := 0 else w
  if w2.count < w2.limit then (true, w2 with count := w2.count + 1) else (false, w2)

fn main() -> Unit ! log, fail[LimitErr]
= log(run_requests(new_window(3, 10), [0, 1, 2, 3, 12]).map(_.str).join(" "))

fn run_requests(w: Window, times: List[Int]) -> List[Bool] ! fail[LimitErr]
= do
  var cur = w
  var out = []
  for t in times
    (ok, next) = allow(cur, t)
    out := out.push(ok)
    cur := next
  out

fn new_bucket(capacity: Int, rate: Int, now: Int) -> Bucket
= Bucket{capacity: capacity, rate: rate, tokens: capacity, last: now}

fn refill(b: Bucket, now: Int) -> Bucket
= do
  t = b.tokens + (now - b.last) * b.rate
  b with tokens := if t > b.capacity then b.capacity else t, last := now

fn take(b: Bucket, now: Int, n: Int) -> (Bool, Bucket) ! fail[LimitErr]
= do
  if now < b.last then raise ClockSkew{last: b.last, now: now}
  r = refill(b, now)
  if r.tokens >= n then (true, r with tokens := r.tokens - n) else (false, r)

fn retry_after(b: Bucket, now: Int, n: Int) -> Int ! fail[LimitErr]
= do
  if n > b.capacity then raise TooLarge{n: n, capacity: b.capacity}
  if now < b.last then raise ClockSkew{last: b.last, now: now}
  r = refill(b, now)
  if r.tokens >= n then 0 else (n - r.tokens + b.rate - 1) / b.rate

fn new_keyed(capacity: Int, rate: Int) -> Keyed
= Keyed{capacity: capacity, rate: rate, buckets: []}

fn take_key(k: Keyed, key: Str, now: Int) -> (Bool, Keyed) ! fail[LimitErr]
= do
  b = k.buckets.find(p => p.0 == key).map(_.1).or(new_bucket(k.capacity, k.rate, now))
  (ok, nb) = take(b, now, 1)
  rest = k.buckets.filter(p => p.0 != key)
  have = k.buckets.any(p => p.0 == key)
  nbs = if have then k.buckets.map(p => if p.0 == key then (key, nb) else p) else k.buckets.push((key, nb))
  (ok, k with buckets := nbs)

test counts = allow(new_window(3, 10), 0).1.count == 1

test first_allowed = allow(new_window(3, 10), 0).0

test new_window_resets = run_requests(new_window(1, 10), [0, 10]).last == some(true)

test window_limit = run_requests(new_window(3, 10), [0, 1, 2, 3, 4]) == [true, true, true, false, false]

test bucket_new = new_bucket(5, 1, 7).tokens == 5

test bucket_take = take(new_bucket(5, 1, 0), 0, 2).1.tokens == 3

test bucket_deny = take(new_bucket(2, 1, 0), 0, 3).0 == false

test bucket_refill = take(take(new_bucket(5, 2, 0), 0, 5).1, 2, 3).1.tokens == 1

test bucket_cap = take(new_bucket(5, 2, 0), 100, 1).1.tokens == 4

test take_skew = catch take(new_bucket(5, 1, 10), 5, 1).0
  | ClockSkew{last, now} => last == 10 and now == 5
  | _ => false

test allow_skew = catch allow(Window{limit: 3, size: 10, start: 20, count: 0}, 5).0
  | ClockSkew{last, now} => last == 20 and now == 5
  | _ => false

test retry_now = retry_after(new_bucket(5, 1, 0), 0, 3) == 0

test retry_wait = retry_after(take(new_bucket(5, 2, 0), 0, 5).1, 0, 3) == 2

test retry_toolarge = catch retry_after(new_bucket(5, 1, 0), 0, 6) == 0
  | TooLarge{n, capacity} => n == 6 and capacity == 5
  | _ => false

test retry_skew = catch retry_after(new_bucket(5, 1, 10), 3, 1) == 0
  | ClockSkew{last, now} => last == 10
  | _ => false

test keyed_new = new_keyed(2, 1).buckets.len == 0

test keyed_flow = run_keys() == [true, true, false, true]

fn run_keys() -> List[Bool] ! fail[LimitErr]
= do
  k0 = new_keyed(2, 1)
  (a, k1) = take_key(k0, "x", 0)
  (b, k2) = take_key(k1, "x", 0)
  (c, k3) = take_key(k2, "x", 0)
  (d, k4) = take_key(k3, "y", 0)
  [a, b, c, d]
