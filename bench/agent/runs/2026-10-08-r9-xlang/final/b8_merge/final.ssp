type ConfigErr = MissingKey{path: Str}

type J = JNull | JBool{b: Bool} | JNum{n: Int} | JStr{s: Str} | JArr{items: List[J]} | JObj{fields: List[(Str, J)]}

fn defaults() -> J
= JObj{fields: [("name", JStr{s: "app"}), ("port", JNum{n: 8080}), ("db", JObj{fields: [("host", JStr{s: "localhost"}), ("pool", JNum{n: 5})]}), ("tags", JArr{items: [JStr{s: "a"}]})]}

fn esc(s: Str) -> Str
= s.replace("\\", "\\\\").replace("\"", "\\\"")

fn get_field(j: J, key: Str) -> Opt[J]
= match j
| JObj{fields} => fields.find(_.0 == key).map(_.1)
| _ => none

fn get_path(j: J, path: Str) -> Opt[J]
= do
  var cur = some(j)
  for k in path.split(".")
    cur := match cur
    | some(v) => get_step(v, k)
    | none => none
  cur

fn get_step(j: J, key: Str) -> Opt[J]
= match j
| JObj{fields} => fields.find(_.0 == key).map(_.1)
| JArr{items} => if not key.is_empty and key.chars.all(c => "0123456789".contains(c)) then do
    match key.to_int
    | some(i) => items.get(i)
    | none => none
  else none
| _ => none

fn main() -> Unit ! log
= log(render(merge(defaults(), JObj{fields: [("port", JNum{n: 9090})]})))

fn merge(target: J, patch: J) -> J
= match patch
| JObj{fields} => JObj{fields: fields.fold(obj_fields(target), merge_entry)}
| _ => patch

fn merge_all(base: J, patches: List[J]) -> J
= patches.fold(base, (acc, p) => merge(acc, p))

fn merge_entry(acc: List[(Str, J)], e: (Str, J)) -> List[(Str, J)]
= if e.1 == JNull then acc.filter(f => f.0 != e.0) else if acc.any(f => f.0 == e.0) then acc.map(f => if f.0 == e.0 then (f.0, merge(f.1, e.1)) else f) else acc + [(e.0, merge(JNull, e.1))]

fn obj_fields(j: J) -> List[(Str, J)]
= match j
| JObj{fields} => fields
| _ => []

fn render(j: J) -> Str
= match j
| JNull => "null"
| JBool{b} => if b then "true" else "false"
| JNum{n} => n.str
| JStr{s} => "\"" + esc(s) + "\""
| JArr{items} => "[" + items.map(render).join(",") + "]"
| JObj{fields} => "\{" + fields.map(f => "\"" + esc(f.0) + "\":" + render(f.1)).join(",") + "}"

fn require(j: J, paths: List[Str]) -> Unit ! fail[ConfigErr]
= do
  for p in paths
    if get_path(j, p).is_none then raise MissingKey{path: p}

test escape_str_key = render(JObj{fields: [("k\"\\", JStr{s: "a\"b\\c"})]}) == "\{\"k\\\"\\\\\":\"a\\\"b\\\\c\"}"

test merge_all_order = get_path(merge_all(defaults(), [JObj{fields: [("port", JNum{n: 1})]}, JObj{fields: [("port", JNum{n: 2})]}]), "port") == some(JNum{n: 2})

test merges_top_level = get_path(merge(defaults(), JObj{fields: [("name", JStr{s: "web"})]}), "name") == some(JStr{s: "web"})

test order_keep_and_append = render(merge(JObj{fields: [("a", JNum{n: 1}), ("b", JNum{n: 2})]}, JObj{fields: [("c", JNum{n: 3}), ("a", JNum{n: 9})]})) == "\{\"a\":9,\"b\":2,\"c\":3}"

test path = get_path(defaults(), "db.pool") == some(JNum{n: 5}) and get_path(defaults(), "db.user") == none

test path_array = get_path(JObj{fields: [("servers", JArr{items: [JObj{fields: [("host", JStr{s: "x"})]}, JObj{fields: [("host", JStr{s: "y"})]}]})]}, "servers.1.host") == some(JStr{s: "y"})

test path_array_missing = get_path(defaults(), "tags.5") == none and get_path(defaults(), "tags.-1") == none and get_path(defaults(), "tags.x") == none and get_path(defaults(), "tags.0") == some(JStr{s: "a"})

test renders = render(JObj{fields: [("a", JArr{items: [JNum{n: 1}, JBool{b: true}, JNull]})]}) == "\{\"a\":[1,true,null]}"

test require_missing = catch require(defaults(), ["name", "db.user", "zzz"]) == ()
| MissingKey{path} => path == "db.user"

test require_ok = catch require(defaults(), ["name", "db.pool"]) == ()
| _ => false

test rfc_array_replaced = render(merge(defaults(), JObj{fields: [("tags", JArr{items: [JStr{s: "b"}]})]})) == "\{\"name\":\"app\",\"port\":8080,\"db\":\{\"host\":\"localhost\",\"pool\":5},\"tags\":[\"b\"]}"

test rfc_nested = render(merge(defaults(), JObj{fields: [("db", JObj{fields: [("pool", JNum{n: 9}), ("host", JNull)]})]})) == "\{\"name\":\"app\",\"port\":8080,\"db\":\{\"pool\":9},\"tags\":[\"a\"]}"

test rfc_nonobj_patch = merge(defaults(), JArr{items: []}) == JArr{items: []}

test rfc_nonobj_target = render(merge(JNum{n: 1}, JObj{fields: [("a", JObj{fields: [("x", JNull), ("y", JNum{n: 1})]})]})) == "\{\"a\":\{\"y\":1}}"

test rfc_remove = render(merge(JObj{fields: [("a", JNum{n: 1}), ("b", JNum{n: 2})]}, JObj{fields: [("a", JNull)]})) == "\{\"b\":2}"
