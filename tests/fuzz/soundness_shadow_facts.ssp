// Facts about a name must not survive a new binding of the same name: match arms, loop variables, lambdas, catch arms and nested lets.
type S = A{x: Int} | B
type E = Bad{c: Int}

fn by_match(a: Int where _ > 0, s: S) -> Int
= match s
  | A{x: a} => 100 / a
  | B => 100 / a

fn by_for(a: Int where _ > 0, xs: List[Int]) -> Int
= do
  var t = 0
  for a in xs
    t := t + 100 / a
  t + 100 / a

fn by_lambda(a: Int where _ > 0, xs: List[Int]) -> Int
= xs.map(a => 100 / a).sum

fn by_catch(a: Int where _ > 0) -> Int
= catch risky(a)
  | Bad{c: a} => 100 / a

fn risky(a: Int) -> Int ! fail[E]
= if a > 3 then raise Bad{c: a - 4} else a

fn nested_let(a: Int where _ > 0) -> Int
= do
  b = a
  if a > 5 then do
    b = 0 - b
    if b > 0 then 1 else 100 / (b + 6)
  else 3

fn nested_dead(a: Int where _ > 0) -> Int
= do
  b = a
  r = if a > 5 then do
      b = 5 - b
      if b > 0 then 1 else 2
    else 3
  r

fn tuple_let(a: Int where _ > 0, p: (Int, Int)) -> Int
= do
  (a, c) = p
  100 / a + c

fn idx_match(xs: List[Int], s: S) -> Int
= do
  var t = 0
  for i in 0..xs.len
    t := t + (match s
      | A{x: i} => xs[i]
      | B => xs[i])
  t

fn local_fn_param(a: Int where _ > 0) -> Int
= do
  fn g(a: Int) -> Int
  = 100 / a
  g(a - 1)

fn probe_match() -> Int
= by_match(5, A{x: 0})

fn probe_for() -> Int
= by_for(5, [1, 0])

fn probe_lambda() -> Int
= by_lambda(5, [0])

fn probe_catch() -> Int
= by_catch(4)

fn probe_nested() -> Int
= nested_let(6)

fn probe_dead() -> Int
= nested_dead(10)

fn probe_tuple() -> Int
= tuple_let(3, (0, 1))

fn probe_idx() -> Int
= idx_match([1, 2], A{x: 7})

fn probe_local() -> Int
= local_fn_param(1)

test shadow_facts = nested_dead(10) == 2 and nested_dead(6) == 2 and nested_dead(1) == 3
