// Adversarial cases for SMT check removal: facts after raise or return must only hold on paths that really exited.
type E = Bad{c: Int}

fn raise_in_loop(xs: List[Int], k: Int, n: Int) -> Int ! fail[E]
= do
  for i in 0..n
    if k < 0 or k >= xs.len then raise Bad{c: i}
  xs[k]

fn return_in_loop(xs: List[Int], k: Int, n: Int) -> Int
= do
  for i in 0..n
    if k < 0 or k >= xs.len then return -1
  xs[k]

fn return_in_while(xs: List[Int], k: Int, n: Int) -> Int ! div
= do
  var c = 0
  while c < n
    if k < 0 or k >= xs.len then return -1
    c := c + 1
  xs[k]

fn caught(xs: List[Int], k: Int) -> Int
= do
  r = catch (if k < 0 or k >= xs.len then raise Bad{c: 0} else 1)
    | Bad{c} => c
  xs[k] + r

fn mutated(xs: List[Int], k: Int) -> Int
= do
  var j = k
  if j < 0 or j >= xs.len then return -1
  j := j + 1
  xs[j]

fn in_local(xs: List[Int], k: Int) -> Int ! fail[E]
= do
  fn check(z: Int) -> Int ! fail[E]
  = if k < 0 or k >= xs.len then raise Bad{c: z} else z
  if xs.len > 100 then check(1) else 0
  xs[k]

fn inner_block_return(xs: List[Int], k: Int, b: Bool) -> Int
= do
  x = if b then do
      if k < 0 or k >= xs.len then return -1
      1
    else 2
  xs[k] + x

fn overflow_after(a: Int, b: Int, n: Int) -> Int
= do
  for i in 0..n
    if a > 1000 or b > 1000 then return 0
  a * b

fn rel_pre(lo: Int, hi: Int, xs: List[Int]) -> Int
  pre lo <= hi and hi <= xs.len
= do
  var s = 0
  for i in lo..hi
    s := s + xs[i - lo]
  s

fn rel_pre_wrong(lo: Int, hi: Int, xs: List[Int]) -> Int
  pre lo <= hi and hi <= xs.len
= do
  var s = 0
  for i in lo..hi
    s := s + xs[i]
  s

fn post_after_loop(xs: List[Int], n: Int) -> Int
  post r >= 0
= do
  for i in 0..n
    if xs.len > 5 then return 1
  0 - xs.len

fn probe_raise_loop() -> Int
= catch raise_in_loop([1, 2], 5, 0)
  | Bad{c} => -100

fn probe_return_loop() -> Int
= return_in_loop([1, 2], 5, 0)

fn probe_return_while() -> Int ! div
= return_in_while([1, 2], -1, 0)

fn probe_caught() -> Int
= caught([1, 2], 9)

fn probe_mutated() -> Int
= mutated([1, 2], 1)

fn probe_local() -> Int
= catch in_local([1, 2], 7)
  | Bad{c} => -100

fn probe_inner() -> Int
= inner_block_return([1], 3, false)

fn probe_overflow() -> Int
= overflow_after(4294967296, 4294967296, 0)

fn probe_rel_wrong() -> Int
= rel_pre_wrong(1, 2, [1, 2])

fn probe_post_loop() -> Int
= post_after_loop([1, 2], 0)
