profile sys

res type File = {fd: Int} drop close

fn close(f: File)
= ()

fn open(fd: Int) -> File
= File{fd}

fn consume(f: File) -> Int
= f.fd

fn size(f: &File) -> Int
= f.fd

fn bump(f: &mut File)
= do
  f.fd := f.fd + 1
  ()

fn look_and_take(x: &File, y: File) -> Int
= x.fd + consume(y)

fn alias() -> Int
= do
  a = open(1)
  look_and_take(&a, a)
