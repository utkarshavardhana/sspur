fn is_prime(p: Int) -> Bool
= do
  var ok = p >= 2
  for d in 2..p
    if ok and d * d <= p and p % d == 0 then ok := false
  ok

fn primes_from_two(n: Int) -> List[Int]
= do
  var acc = []
  for p in 2..(n + 1)
    if is_prime(p) then acc := acc.push(p)
  acc

fn primes_upto(n: Int) -> List[Int]
= if n < 2 then [] else primes_from_two(n)
