type InvErr = UnknownSku{sku: Str} | OutOfStock{sku: Str, wanted: Int, have: Int} | DuplicateSku{sku: Str}

fn total_value(inv: List[Item]) -> Int
= inv.map(i => i.qty * i.price).sum

fn low_stock(inv: List[Item], threshold: Int) -> List[Str]
= inv.filter(_.qty < threshold).map(_.sku).sort

fn remove_stock(inv: List[Item], sku: Str, n: Int where _ > 0) -> List[Item] ! fail[InvErr]
= do
  it = find_item(inv, sku).ok_or(UnknownSku{sku: sku})
  if n > it.qty then raise OutOfStock{sku: sku, wanted: n, have: it.qty}
  inv.map(i => if i.sku == sku then i with qty := i.qty - n else i)

fn add_item(inv: List[Item], item: Item) -> List[Item] ! fail[InvErr]
= if find_item(inv, item.sku).is_some then raise DuplicateSku{sku: item.sku} else inv.push(item)

test total_value_sum = total_value(sample()) == 704

test low_stock_sorted = low_stock(sample(), 50) == ["a1", "b2", "c3"]

test remove_ok = catch remove_stock(sample(), "b2", 15).map(_.qty) == [7, 25, 2]
| _ => false

test remove_unknown = catch remove_stock(sample(), "zz", 1).len == 0
| UnknownSku{sku} => sku == "zz"
| _ => false

test remove_too_many = catch remove_stock(sample(), "a1", 3).len == 0
| OutOfStock{sku, wanted, have} => sku == "a1" and wanted == 3 and have == 2
| _ => false

test add_ok = catch add_item(sample(), Item{sku: "d4", name: "drill", qty: 1, price: 5}).map(_.sku) == ["c3", "b2", "a1", "d4"]
| _ => false

test add_dup = catch add_item(sample(), Item{sku: "b2", name: "x", qty: 1, price: 1}).len == 0
| DuplicateSku{sku} => sku == "b2"
| _ => false
