fn scratch(tag: Str) -> Str ! env, time
= "{trim_end_slash(env_var("TMPDIR").or("/tmp"))}/sspur_files_{tag}_{mono_ns()}"

fn trim_end_slash(p: Str) -> Str
= if p.ends_with("/") then p.take(p.len - 1) else p

fn reason(r: Res[Unit, Str], p: Str) -> Str
= match r
  | ok(_) => "ok"
  | err(e) => e.drop(p.len + 2)

fn bytes_round_trip(tag: Str, bs: List[Int]) -> Res[List[Int], Str] ! fs, env, time
= do
  p = scratch(tag)
  w = write_bytes(p, bs)
  r = if w.is_err then err("write failed") else read_bytes(p)
  gone = remove_file(p)
  r

fn bad_byte(tag: Str) -> Str ! fs, env, time
= do
  p = scratch(tag)
  r = reason(write_bytes(p, [1, 256]), p)
  "{r} {exists(p)}"

fn tree(tag: Str) -> List[Str] ! fs, env, time
= do
  root = scratch(tag)
  made = mkdir_all(root + "/a/b/c")
  again = mkdir_all(root + "/a/b")
  w = write_file(root + "/a/b/c/f.txt", "hello")
  size = file_size(root + "/a/b/c/f.txt").or(-1)
  kinds = [exists(root + "/a/b/c/f.txt"), is_dir(root + "/a/b/c/f.txt"), is_dir(root + "/a/b"), exists(root + "/zz")]
  moved = rename(root + "/a/b/c/f.txt", root + "/a/g.txt")
  listing = list_dir(root + "/a").or([])
  busy = reason(remove_dir(root + "/a"), root + "/a")
  clean = [remove_file(root + "/a/g.txt"), remove_dir(root + "/a/b/c"), remove_dir(root + "/a/b"), remove_dir(root + "/a"), remove_dir(root)].all(_.is_ok)
  [reason(made, root), reason(again, root), size.str, kinds.str, reason(moved, root), listing.join(","), busy, clean.str]

fn dir_errors(tag: Str) -> List[Str] ! fs, env, time
= do
  root = scratch(tag)
  first = mkdir(root)
  twice = reason(mkdir(root), root)
  w = write_file(root + "/f", "x")
  under_file = reason(mkdir_all(root + "/f/g"), root + "/f/g")
  missing = reason(mkdir(root + "/x/y"), root + "/x/y")
  gone = remove_file(root + "/f")
  rd = remove_dir(root)
  [reason(first, root), twice, under_file, missing, reason(mkdir_all(""), "")]

fn fresh_mtime(tag: Str) -> Bool ! fs, env, time
= do
  p = scratch(tag)
  before = now_ms()
  w = write_file(p, "t")
  m = modified_ms(p).or(0)
  gone = remove_file(p)
  m > before - 5000 and m < before + 5000

fn warn(s: Str) -> Int ! io
= do
  eprint("warning: " + s)
  s.len

test round_trip = bytes_round_trip("rt", [0, 1, 127, 128, 254, 255]) == ok([0, 1, 127, 128, 254, 255]) and bytes_round_trip("empty", []) == ok([])
test binary_not_utf8 = bytes_round_trip("bin", [255, 254, 0]).is_ok
test out_of_range = bad_byte("bad") == "byte out of range false"
test directories = tree("tree") == ["ok", "ok", "5", "[true, false, true, false]", "ok", "b,g.txt", "directory not empty", "true"]
test dir_failures = dir_errors("errs") == ["ok", "already exists", "already exists", "not found", "not found"]
test mtime = fresh_mtime("mt")
test missing_meta = file_size("/definitely/not/here").is_err and not exists("/definitely/not/here") and is_dir("/")
test stderr = warn("low disk") == 8
