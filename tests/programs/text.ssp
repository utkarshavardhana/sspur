fn is_palindrome(s: Str) -> Bool
= do
  cs = s.lower.chars.filter(_.is_alpha)
  cs == cs.reverse

fn shift(c: Str, k: Int) -> Str
= do
  alpha = "abcdefghijklmnopqrstuvwxyz"
  match alpha.chars.enumerate.find(_.1 == c)
  | some((i, _)) => alpha.chars[(i + k % 26 + 26) % 26]
  | none => c

fn caesar(s: Str, k: Int) -> Str
= s.chars.map(c => shift(c, k)).join("")

fn rle(s: Str) -> Str
= do
  var out = ""
  var prev = ""
  var n = 0
  for c in s.chars
    if c == prev then n := n + 1 else do
      if n > 0 then out := out + "{n}{prev}"
      prev := c
      n := 1
  if n > 0 then out := out + "{n}{prev}"
  out

fn main() -> Unit ! log
= do
  log(caesar("hello world", 3))
  log(rle("aaabccdddd"))

test pal = is_palindrome("A man, a plan, a canal: Panama")
test not_pal = not is_palindrome("sspur")
test caesar_round = caesar(caesar("hello", 3), -3) == "hello"
test caesar_shift = caesar("abc xyz", 1) == "bcd yza"
test rle_ok = rle("aaabccdddd") == "3a1b2c4d"
test rle_empty = rle("") == ""
