// A fused map or filter over range(a, b, step) that builds a list declared the step and the output counter with the same C name, so the whole program failed to compile natively.

fn evens(n: Int) -> List[Int]
= range(-2, n % 50, 1).filter(x => x % 2 == 0)

fn down(n: Int) -> List[Int]
= range(n % 40, 0, -3).map(x => x * 2)

fn both(n: Int) -> List[Int]
= range(0, n % 30, 2).filter(x => x > 3).map(x => x - 1)

test stepped = evens(7) == [-2, 0, 2, 4, 6] and down(10) == [20, 14, 8, 2] and both(12) == [3, 5, 7, 9]
