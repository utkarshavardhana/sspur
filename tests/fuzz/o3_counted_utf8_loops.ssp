type P135R = {a: Int, b: Int where _ > -100}
type P135S = P135A{x: Int} | P135B{x: Int, y: Int} | P135C
type P135T = P135Lf | P135Nd{l: P135T, v: Int, r: P135T}
type P135E = P135Bad{c: Int} | P135Worse
type P135G[T] = P135Nil | P135Cons{h: T, t: P135G[T]}
type P135P[A, B] = {fst: A, snd: B}
effect p135ask(x: Int) -> Int

fn p135_ins(t: P135T, x: Int) -> P135T
= match t
  | P135Lf => P135Nd{l: P135Lf, v: x, r: P135Lf}
  | P135Nd{l, v, r} => if x > v then P135Nd{l: p135_ins(l, x), v: v, r: r} else P135Nd{l: l, v: v, r: p135_ins(r, x)}

fn p135_inc(t: P135T, d: Int) -> P135T
= match t
  | P135Lf => P135Lf
  | P135Nd{l, v, r} => P135Nd{l: p135_inc(l, d), v: v + d, r: p135_inc(r, d)}

fn p135_tsum(t: P135T) -> Int
= match t
  | P135Lf => 0
  | P135Nd{l, v, r} => p135_tsum(l) + v + p135_tsum(r)

fn p135_items(t: P135T) -> List[Int]
= match t
  | P135Lf => []
  | P135Nd{l, v, r} => p135_items(l) + [v] + p135_items(r)

fn p135_build(xs: List[Int]) -> P135T
= do
  var t = P135Lf
  for x in xs
    t := p135_ins(t, x)
  t

fn p135_mkmap(xs: List[Int]) -> Map[Int, Int]
= xs.fold(empty_map(), (m, x) => m.put(x / 3, m.get(x / 3).or(0) + x))

fn p135_mkhm(xs: List[Int]) -> HashMap[Str, Int]
= xs.fold(hash_map(), (m, x) => m.put("k{x % 5}", x))

fn p135_gfrom[T](xs: List[T]) -> P135G[T]
= xs.reverse.fold(P135Nil, (acc, x) => P135Cons{h: x, t: acc})

fn p135_gto[T](g: P135G[T]) -> List[T]
= match g
  | P135Nil => []
  | P135Cons{h, t} => [h] + p135_gto(t)

fn p135_glen[T](g: P135G[T]) -> Int
= match g
  | P135Nil => 0
  | P135Cons{t} => 1 + p135_glen(t)

fn p135_gmap[A, B](g: P135G[A], f: A -> B) -> P135G[B]
= match g
  | P135Nil => P135Nil
  | P135Cons{h, t} => P135Cons{h: f(h), t: p135_gmap(t, f)}

fn p135_gnth[T](g: P135G[T], k: Int, d: T) -> T
= match g
  | P135Nil => d
  | P135Cons{h, t} => if k <= 0 then h else p135_gnth(t, k - 1, d)

fn p135_swap[A, B](q: P135P[A, B]) -> P135P[B, A]
= P135P{fst: q.snd, snd: q.fst}

fn p135_pick[T](b: Bool, x: T, y: T) -> T
= if b then x else y

fn p135_gapp[A, e](x: A, f: A -> A ! e) -> A ! e
