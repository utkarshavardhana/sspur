fn transpose(m: List[List[Int]]) -> List[List[Int]]
= if m.is_empty then []
  else
    do
      var cols = m.first.get.len
      if cols == 0 then []
      else
        do
          var result = []
          for col_idx in 0..cols do
            var col = []
            for row in m do
              col := col.push(row.get(col_idx))
            result := result.push(col)
          result
