fn area(s: Shape) -> F64
= match s
  | Circle{r} => 3.14159 * r * r
  | Rect{w, h} => w * h
  | Square{s: side} => side * side

fn pick(best: Opt[Shape], x: Shape) -> Opt[Shape]
= match best
  | none => some(x)
  | some(b) => if area(x) > area(b) then some(x) else best

fn largest_area(xs: List[Shape]) -> Opt[Shape]
= xs.fold(none, pick)
