profile sys

res type File = {fd: Int} drop close
res type Tok = {id: Int}

fn close(f: File)
= ()

fn open(fd: Int) -> File
= File{fd}

fn consume(f: File) -> Int
= f.fd

fn eat(t: Tok) -> Int
= do
  Tok{id} = t
  id

fn size(f: &File) -> Int
= f.fd

fn bump(f: &mut File)
= do
  f.fd := f.fd + 1
  ()

fn f(x: Int) -> Int
= do
  t = Tok{id: 1}
  for i in 0..3
    if i == x then return i
  eat(t)
