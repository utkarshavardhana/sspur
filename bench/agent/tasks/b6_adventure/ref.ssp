type Room = {name: Str, exits: List[(Str, Str)], items: List[Str], locked: List[Str]}
type Game = {room: Str, rooms: List[Room], inventory: List[Str], moves: Int}

fn world() -> List[Room]
= [Room{name: "hall", exits: [("north", "vault"), ("east", "kitchen")], items: [], locked: ["north"]}, Room{name: "kitchen", exits: [("west", "hall")], items: ["key", "bread"], locked: []}, Room{name: "vault", exits: [("south", "hall")], items: ["gold"], locked: []}]

fn new_game() -> Game
= Game{room: "hall", rooms: world(), inventory: [], moves: 0}

fn current(g: Game) -> Room
= g.rooms.find(_.name == g.room).get

fn look(g: Game) -> Str
= do
  r = current(g)
  items = if r.items.is_empty then "" else " Items: " + r.items.sort.join(", ") + "."
  "You are in the {r.name}. Exits: " + r.exits.map(_.0).sort.join(", ") + "." + items

fn go(g: Game, dir: Str) -> (Game, Str)
= match current(g).exits.find(_.0 == dir)
  | some(e) => if current(g).locked.contains(dir) and not g.inventory.contains("key") then (g, "The door is locked.") else do
    g2 = g with room := e.1, moves := g.moves + 1
    (g2, look(g2))
  | none => (g, "You can't go that way.")

fn set_items(g: Game, items: List[Str]) -> Game
= g with rooms := g.rooms.map(r => if r.name == g.room then r with items := items else r)

fn take(g: Game, item: Str) -> (Game, Str)
= if current(g).items.contains(item) then (set_items(g, current(g).items.filter(_ != item)) with inventory := g.inventory.push(item), "Taken.") else (g, "There is no {item} here.")

fn drop(g: Game, item: Str) -> (Game, Str)
= if g.inventory.contains(item) then (set_items(g, current(g).items.push(item)) with inventory := g.inventory.filter(_ != item), "Dropped.") else (g, "You don't have {item}.")

fn step(g: Game, cmd: Str) -> (Game, Str)
= do
  w = cmd.lower.split(" ").filter(s => not s.is_empty)
  if w == ["look"] then (g, look(g))
  else if w == ["inventory"] then (g, if g.inventory.is_empty then "You carry nothing." else "You carry: " + g.inventory.sort.join(", ") + ".")
  else if w.len == 2 and w[0] == "go" then go(g, w[1])
  else if w.len == 2 and w[0] == "take" then take(g, w[1])
  else if w.len == 2 and w[0] == "drop" then drop(g, w[1])
  else (g, "I don't understand.")

fn run(cmds: List[Str]) -> (Game, List[Str])
= do
  var g = new_game()
  var out = []
  for c in cmds
    (g2, msg) = step(g, c)
    g := g2
    out := out.push(msg)
  (g, out)

fn play(cmds: List[Str]) -> List[Str]
= run(cmds).1

fn score(g: Game) -> Int
= g.inventory.len * 10 + (if g.room == "vault" then 25 else 0)

fn main() -> Unit ! log
= do
  for line in play(["look", "go east", "go west"])
    log(line)

test starts_in_hall = play(["look"]) == ["You are in the hall. Exits: east, north."]

test walks = play(["go east", "go west"]).last == some("You are in the hall. Exits: east, north.")

test blocked = play(["go up"]) == ["You can't go that way."]

test counts_moves = run(["go east", "go west"]).0.moves == 2

test locked = play(["go north"]) == ["The door is locked."]

test takes = play(["go east", "take key", "inventory"]).last == some("You carry: key.")

test scored = score(run(["go east", "take key"]).0) == 10
