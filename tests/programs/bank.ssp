type AccountId = new Str
type Account = {id: AccountId, owner: Str, balance: Int where _ >= 0}
type BankErr = Insufficient{needed: Int, available: Int} | SameAccount

fn deposit(a: Account, amount: Int where _ > 0) -> Account
  post r.balance == a.balance + amount
= {id: a.id, owner: a.owner, balance: a.balance + amount}

fn withdraw(a: Account, amount: Int where _ > 0) -> Account ! fail[BankErr]
  post r.balance == a.balance - amount
= if amount > a.balance then raise Insufficient{needed: amount, available: a.balance} else {id: a.id, owner: a.owner, balance: a.balance - amount}

fn transfer(from: Account, to: Account, amount: Int where _ > 0) -> (Account, Account) ! fail[BankErr]
= if from.id == to.id then raise SameAccount else (withdraw(from, amount), deposit(to, amount))

fn describe(a: Account) -> Str
= "{a.owner} has {a.balance}"

fn show_pair(p: (Account, Account)) -> Str
= "{describe(p.0)}; {describe(p.1)}"

fn attempt(from: Account, to: Account, amount: Int where _ > 0) -> Str
= catch show_pair(transfer(from, to, amount))
  | Insufficient{needed, available} => "declined: needs {needed}, has {available}"
  | SameAccount => "declined: same account"

fn alice() -> Account
= Account{id: AccountId("a1"), owner: "alice", balance: 100}

fn bob() -> Account
= Account{id: AccountId("b1"), owner: "bob", balance: 20}

fn main() -> Unit ! log
= do
  log(attempt(alice(), bob(), 30))
  log(attempt(bob(), alice(), 50))
  log(attempt(alice(), alice(), 1))

test ok_transfer = attempt(alice(), bob(), 30) == "alice has 70; bob has 50"
test declined = attempt(bob(), alice(), 50) == "declined: needs 50, has 20"
test same = attempt(alice(), alice(), 1) == "declined: same account"
test ids_compare = AccountId("x") == AccountId("x")
