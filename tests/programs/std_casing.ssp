fn fold(s: Str) -> Str
= s.fold_case

fn ci(a: Str, b: Str) -> Int
= a.compare_ci(b)

fn sort_ci(xs: List[Str]) -> List[Str]
= xs.sort_with((a, b) => a.compare_ci(b))

fn same_word(a: Str, b: Str) -> Bool
= a.compare_ci(b) == 0

test folds = fold("Straße") == "strasse" and fold("ΣΊΣΥΦΟΣ") == fold("σίσυφος") and fold("ABC") == "abc" and fold("") == ""
test casing = "straße".upper == "STRASSE" and "ÀÉÎ".lower == "àéî" and "ǅ".lower == "ǆ"
test compares = ci("Apple", "apple") == 0 and ci("apple", "Banana") == -1 and ci("zeta", "Alpha") == 1 and same_word("STRASSE", "straße")
test sorting = sort_ci(["banana", "Apple", "cherry", "apple", "Banana"]) == ["Apple", "apple", "banana", "Banana", "cherry"]
