fn album_bucket(x: Album) -> Str
= if album_value(x) >= 2000 then "large" else if album_value(x) >= 500 then "medium" else "small"

fn album_count_active(xs: List[Album]) -> Int
= xs.filter(_.active).len

fn album_deactivate(x: Album) -> Album
= x with active := false

fn album_discounted(x: Album, p: Int) -> Album
= x with price := x.price - pct(x.price, clamp(p, 0, 100))

fn album_find(xs: List[Album], id: Int) -> Opt[Album]
= xs.find(_.id == id)

fn album_gross(x: Album) -> Int
= album_value(x) + album_tax(x)

fn album_in_region(xs: List[Album], r: Str) -> List[Album]
= xs.filter(_.region == r)

fn album_label(x: Album) -> Str
= label_of(x.name, x.id)

fn album_line(x: Album) -> Str
= album_label(x) + ": " + money(album_gross(x))

fn album_names(xs: List[Album]) -> List[Str]
= xs.map(_.name).sort

fn album_new(id: Int, name: Str, qty: Int, price: Int, region: Str) -> Album
= Album{id: id, name: name, qty: qty, price: price, region: region, active: true}

fn album_report(xs: List[Album]) -> Str
= join_lines(xs.map(album_line))

fn album_restock(x: Album, n: Int) -> Album
= x with qty := x.qty + n

fn album_sample() -> List[Album]
= [album_new(1, "alpha30", 4, 270, "US"), album_new(2, "beta30", 0, 900, "APAC"), album_new(3, "gamma30", 7, 105, "UK")]

fn album_score(x: Album) -> Int
= album_value(x) / 5 + (if x.active then 1 else 0)

fn album_tax(x: Album) -> Int
= pct(album_value(x), tax_rate(x.region))

fn album_top(xs: List[Album], n: Int) -> List[Album]
= xs.sort_by(x => -album_value(x)).take(n)

fn album_total(xs: List[Album]) -> Int
= xs.map(album_gross).sum

fn album_valid(x: Album) -> Bool
= x.qty >= 0 and x.price >= 0 and not x.name.is_empty

fn album_value(x: Album) -> Int
= x.qty * x.price

