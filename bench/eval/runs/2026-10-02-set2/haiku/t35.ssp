fn merge_sorted(a: List[Int], b: List[Int]) -> List[Int]
= do
  var result = []
  var i = 0
  var j = 0
  for _ in 0..(a.len + b.len) do
    if i < a.len and (j >= b.len or a.get(i).get <= b.get(j).get) then
      result := result.push(a.get(i).get)
      i := i + 1
    else if j < b.len then
      result := result.push(b.get(j).get)
      j := j + 1
  result
