// A binding that shadows an earlier one in the same block replaced the variable in place in the interpreter, so closures and local functions created before it saw the new value (or a value of another type).
// Native code captured lexically.

fn lam(a: Int) -> Int
= do
  x = a
  f = k => x + k
  x = a * 10
  f(1) + x

fn retyped(a: Int) -> Int
= do
  x = a
  f = k => x + k
  x = "s"
  f(0) + x.len

fn local(a: Int) -> Int
= do
  x = 1
  fn g(k: Int) -> Int
  = x + k
  x = 5
  fn h(k: Int) -> Int
  = g(k) * 2
  h(0) * 10 + x

fn still_shared(a: Int) -> Int
= do
  var x = a
  f = k => x + k
  x := x + 1
  f(0)

test lexical = lam(2) == 23 and retyped(4) == 5 and local(0) == 25 and still_shared(3) == 4
