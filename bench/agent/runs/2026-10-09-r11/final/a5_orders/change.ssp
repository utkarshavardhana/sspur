remove subtotal
remove subtotal_sample

fn gross(o: Order) -> Int
= o.lines.map(_.qty * _.unit).sum

fn discount(o: Order) -> Int
= if o.coupon == "SAVE10" then gross(o) * 10 / 100 else if o.coupon == "BIG20" && gross(o) >= 10000 then gross(o) * 20 / 100 else 0

fn net(o: Order) -> Int
= gross(o) - discount(o)

fn shipping(o: Order) -> Int
= if net(o) >= 5000 || o.coupon == "FREESHIP" then 0 else 499

fn tax(o: Order) -> Int
= net(o) * 8 / 100

fn total(o: Order) -> Int
= net(o) + shipping(o) + tax(o)

fn invoice(o: Order) -> Str
= "order {o.id}: gross {money(gross(o))}, discount {money(discount(o))}, shipping {money(shipping(o))}, tax {money(tax(o))}, total {money(total(o))}"

fn big_order(coupon: Str) -> Order
= Order{id: 8, lines: [Line{sku: "box", qty: 1, unit: 10000}], coupon: coupon}

test invoice_sample = invoice(sample_order()) == "order 7: gross 31.50, discount 0.00, shipping 4.99, tax 2.52, total 39.01"

test gross_sample = gross(sample_order()) == 3150

test total_sample = total(sample_order()) == 3150 + 499 + 252

test save10 = discount(big_order("SAVE10")) == 1000 && total(big_order("SAVE10")) == 9000 + 720

test save10_rounds_down = discount(sample_order() with coupon := "SAVE10") == 315 && discount(Order{id: 1, lines: [Line{sku: "x", qty: 1, unit: 99}], coupon: "SAVE10"}) == 9

test big20_applies = discount(big_order("BIG20")) == 2000 && total(big_order("BIG20")) == 8000 + 640

test big20_below_threshold = discount(sample_order() with coupon := "BIG20") == 0 && discount(Order{id: 1, lines: [Line{sku: "x", qty: 1, unit: 9999}], coupon: "BIG20"}) == 0

test other_coupons = discount(big_order("")) == 0 && discount(big_order("FREESHIP")) == 0 && discount(big_order("nope")) == 0

test freeship = shipping(sample_order() with coupon := "FREESHIP") == 0 && total(sample_order() with coupon := "FREESHIP") == 3150 + 252

test shipping_uses_net = shipping(Order{id: 1, lines: [Line{sku: "x", qty: 1, unit: 5400}], coupon: "SAVE10"}) == 499 && shipping(Order{id: 1, lines: [Line{sku: "x", qty: 1, unit: 5000}], coupon: ""}) == 0

test invoice_coupon = invoice(big_order("BIG20")) == "order 8: gross 100.00, discount 20.00, shipping 0.00, tax 6.40, total 86.40"
