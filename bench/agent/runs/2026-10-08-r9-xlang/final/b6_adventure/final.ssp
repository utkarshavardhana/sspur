type Game = {room: Str, rooms: List[Room], inventory: List[Str], moves: Int}

type Room = {name: Str, exits: List[(Str, Str)], items: List[Str], locked: List[Str]}

fn current(g: Game) -> Room
= g.rooms.find(_.name == g.room).get

fn drop(g: Game, item: Str) -> (Game, Str)
= if g.inventory.contains(item) then (g with rooms := g.rooms.map(r => if r.name == g.room then r with items := r.items.push(item) else r), inventory := g.inventory.filter(_ != item), "Dropped.") else (g, "You don't have {item}.")

fn go(g: Game, dir: Str) -> (Game, Str)
= match current(g).exits.find(_.0 == dir)
| some(e) => if current(g).locked.contains(dir) and not g.inventory.contains("key") then (g, "The door is locked.") else do
  g2 = g with room := e.1, moves := g.moves + 1
  (g2, look(g2))
| none => (g, "You can't go that way.")

fn inv(g: Game) -> Str
= if g.inventory.is_empty then "You carry nothing." else "You carry: " + g.inventory.sort.join(", ") + "."

fn look(g: Game) -> Str
= do
  r = current(g)
  exs = r.exits.map(_.0).sort.join(", ")
  if r.items.is_empty then "You are in the {r.name}. Exits: {exs}." else "You are in the {r.name}. Exits: {exs}. Items: " + r.items.sort.join(", ") + "."

fn main() -> Unit ! log
= do
  for line in play(["look", "go east", "go west"])
    log(line)

fn new_game() -> Game
= Game{room: "hall", rooms: world(), inventory: [], moves: 0}

fn play(cmds: List[Str]) -> List[Str]
= run(cmds).1

fn run(cmds: List[Str]) -> (Game, List[Str])
= do
  var g = new_game()
  var out = []
  for c in cmds
    (g2, msg) = step(g, c)
    g := g2
    out := out.push(msg)
  (g, out)

fn score(g: Game) -> Int
= g.inventory.len * 10 + (if g.room == "vault" then 25 else 0)

fn step(g: Game, cmd: Str) -> (Game, Str)
= do
  w = cmd.lower.trim.split(" ").filter(x => x != "")
  if w.len == 1 and w[0] == "look" then (g, look(g)) else if w.len == 1 and w[0] == "inventory" then (g, inv(g)) else if w.len == 2 and w[0] == "go" then go(g, w[1]) else if w.len == 2 and w[0] == "take" then take(g, w[1]) else if w.len == 2 and w[0] == "drop" then drop(g, w[1]) else (g, "I don't understand.")

fn take(g: Game, item: Str) -> (Game, Str)
= if current(g).items.contains(item) then (g with rooms := g.rooms.map(r => if r.name == g.room then r with items := r.items.filter(_ != item) else r), inventory := g.inventory.push(item), "Taken.") else (g, "There is no {item} here.")

fn world() -> List[Room]
= [Room{name: "hall", exits: [("north", "vault"), ("east", "kitchen")], items: [], locked: ["north"]}, Room{name: "kitchen", exits: [("west", "hall")], items: ["key", "bread"], locked: []}, Room{name: "vault", exits: [("south", "hall")], items: ["gold"], locked: []}]

test blocked = play(["go up"]) == ["You can't go that way."]

test counts_moves = run(["go east", "go west"]).0.moves == 2

test forgiving = play(["  GO   East ", "LOOK"]) == ["You are in the kitchen. Exits: west. Items: bread, key.", "You are in the kitchen. Exits: west. Items: bread, key."]

test inv_empty = play(["inventory"]) == ["You carry nothing."]

test locked_door = run(["go north"]).1 == ["The door is locked."] and run(["go north"]).0.moves == 0

test not_understood = play(["", "   ", "dance", "go", "go a b"]) == ["I don't understand.", "I don't understand.", "I don't understand.", "I don't understand.", "I don't understand."]

test scoring = score(run(["go east", "take key", "take bread", "go west", "go north"]).0) == 45 and score(new_game()) == 0

test starts_in_hall = play(["look"]) == ["You are in the hall. Exits: east, north."]

test take_drop_inv = play(["go east", "take key", "take key", "take bread", "inventory", "drop bread", "inventory", "look", "drop bread"]) == ["You are in the kitchen. Exits: west. Items: bread, key.", "Taken.", "There is no key here.", "Taken.", "You carry: bread, key.", "Dropped.", "You carry: key.", "You are in the kitchen. Exits: west. Items: bread.", "You don't have bread."]

test unlocked = run(["go east", "take key", "go west", "go north"]).0.room == "vault"

test walks = play(["go east", "go west"]).last == some("You are in the hall. Exits: east, north.")
