type Shape = Circle{r: F64} | Rect{w: F64, h: F64} | Dot
type Point = {x: Int, y: Int} derive Eq
type Age = Int where _ >= 0 and _ < 150
type MathErr = DivZero | Overflow{at: Int}

fn area(s: Shape) -> F64
= match s
  | Circle{r} => 3.14159 * r * r
  | Rect{w, h} => w * h
  | Dot => 0.0

fn safe_div(a: Int, b: Int) -> Int ! fail[MathErr]
  pre a >= 0
  post r <= a
= if b == 0 then raise DivZero else a / b

fn sum_sq(xs: List[Int]) -> Int
= xs.map(_ * _).fold(0, (acc, x) => acc + x)

fn describe(p: Point) -> Str
= "point({p.x}, {p.y}) has norm {p.x ** 2 + p.y ** 2} and literal \{braces}"

fn count_to(n: Int) -> List[Int] ! log
= do
  var out = []
  for i in 0..n
    log("at {i}")
    out := out.push(i)
  out

fn first_even(xs: List[Int]) -> Opt[Int]
= do
  for x in xs
    if x % 2 == 0 then return some(x)
  none

fn div_or_zero(a: Int, b: Int) -> Int
= catch safe_div(a, b)
  | DivZero => 0
  | Overflow{at} => at

fn main() -> Unit ! log
= do
  (a, b) = (3, 4)
  p = Point{x: a, y: b}
  log(describe(p))
  log("area {area(Rect{w: 2.0, h: 3.5})}")
  log("sum_sq {sum_sq([1, 2, 3])}")
  log("div {div_or_zero(10, 0)} {div_or_zero(10, 3)}")
  match first_even([1, 3, 6, 7])
  | some(x) if x > 4 => log("big even {x}")
  | some(x) => log("even {x}")
  | none => log("no even")

test area_dot = area(Dot) == 0.0
test sum_sq_ok = sum_sq([1, 2, 3]) == 14
test div_zero = div_or_zero(1, 0) == 0
