fn fib(n: Int where _ >= 0) -> Int
= if n < 2 then n else fib(n - 1) + fib(n - 2)

fn collatz_len(n: Int where _ > 0) -> Int ! div
= do
  var x = n
  var steps = 0
  while x != 1
    x := if x % 2 == 0 then x / 2 else 3 * x + 1
    steps := steps + 1
  steps

fn longest_collatz(limit: Int) -> Int ! div
= do
  var best = 0
  var arg = 1
  for i in 1..limit
    l = collatz_len(i)
    if l > best then do
      best := l
      arg := i
  arg

fn is_prime(n: Int) -> Bool ! div
= do
  var d = 2
  var ok = n >= 2
  while ok and d * d <= n
    if n % d == 0 then ok := false
    d := d + 1
  ok

fn count_primes(limit: Int) -> Int ! div
= do
  var c = 0
  for i in 0..limit
    if is_prime(i) then c := c + 1
  c

fn gcd(a: Int, b: Int) -> Int
  pre a >= 0 and b >= 0
= if b == 0 then a else gcd(b, a % b)

fn gcd_sum(n: Int) -> Int
  post r >= 0
= do
  var s = 0
  for i in 1..n
    for j in 1..n
      s := s + gcd(i, j)
  s

fn main() -> Unit ! log, div
= do
  log("fib(30) = {fib(30)}")
  log("longest collatz below 300000 starts at {longest_collatz(300000)}")
  log("primes below 200000: {count_primes(200000)}")
  log("gcd sum 600: {gcd_sum(600)}")
