type Vec2 = {x: Int, y: Int} derive Eq, Show
type Money = {cents: Int}
type Frac = {num: Int, den: Int where _ > 0}
type Row = {cells: List[F64]}

impl Add for Vec2
  fn add(a: Vec2, b: Vec2) -> Vec2 = Vec2{x: a.x + b.x, y: a.y + b.y}

impl Sub for Vec2
  fn sub(a: Vec2, b: Vec2) -> Vec2 = Vec2{x: a.x - b.x, y: a.y - b.y}

impl Mul for Vec2
  fn mul(a: Vec2, b: Vec2) -> Vec2 = Vec2{x: a.x * b.x, y: a.y * b.y}

impl Neg for Vec2
  fn neg(a: Vec2) -> Vec2 = Vec2{x: -a.x, y: -a.y}

impl Add for Money
  fn add(a: Money, b: Money) -> Money = Money{cents: a.cents + b.cents}

impl Div for Money
  fn div(a: Money, b: Money) -> Money = Money{cents: a.cents / b.cents}

impl Eq for Frac
  fn eq(a: Frac, b: Frac) -> Bool = a.num * b.den == b.num * a.den

impl Ord for Frac
  fn cmp(a: Frac, b: Frac) -> Int = a.num * b.den - b.num * a.den

impl Mul for Frac
  fn mul(a: Frac, b: Frac) -> Frac = Frac{num: a.num * b.num, den: a.den * b.den}

impl Index[Int, F64] for Row
  fn index(r: Row, i: Int) -> F64 = r.cells[i]

fn sum_all[T: Add](xs: List[T], zero: T) -> T
= xs.fold(zero, (a, b) => a + b)

fn smallest[T: Ord](xs: List[T], first: T) -> T
= xs.fold(first, (m, x) => if x < m then x else m)

fn same_all[T: Eq](xs: List[T], x: T) -> Bool
= xs.all(_ == x)

fn at[R: Index[Int, F64]](r: R, i: Int) -> F64 = r[i]

fn negate_all[T: Neg](xs: List[T]) -> List[T]
= xs.map(x => -x)

fn third(r: Row) -> F64 = r[2]

test vec_ops = Vec2{x: 1, y: 2} + Vec2{x: 3, y: 4} - Vec2{x: 1, y: 1} == Vec2{x: 3, y: 5}
test vec_mul = Vec2{x: 2, y: 3} * Vec2{x: 4, y: 5} == Vec2{x: 8, y: 15}
test vec_neg = -Vec2{x: 1, y: -2} == Vec2{x: -1, y: 2}
test money_sum = sum_all([Money{cents: 5}, Money{cents: 7}], Money{cents: 0}).cents == 12
test money_div = (Money{cents: 9} / Money{cents: 2}).cents == 4
test int_sum = sum_all([1, 2, 3], 0) == 6 and sum_all(["a", "b"], "") == "ab"
test frac_eq = Frac{num: 1, den: 2} == Frac{num: 2, den: 4} and Frac{num: 1, den: 2} != Frac{num: 1, den: 3}
test frac_ord = Frac{num: 1, den: 3} < Frac{num: 1, den: 2} and Frac{num: 2, den: 3} >= Frac{num: 4, den: 6}
test frac_min = smallest([Frac{num: 3, den: 4}, Frac{num: 1, den: 8}], Frac{num: 1, den: 1}).num == 1
test frac_mul = Frac{num: 1, den: 2} * Frac{num: 2, den: 3} == Frac{num: 1, den: 3}
test generic_eq_uses_impl = same_all([Frac{num: 1, den: 2}, Frac{num: 3, den: 6}], Frac{num: 2, den: 4})
test generic_eq_builtin = same_all([1, 1], 1) and not same_all([1, 2], 1)
test index_impl = third(Row{cells: [1.0, 2.0, 3.5]}) == 3.5 and at(Row{cells: [4.0]}, 0) == 4.0
test neg_generic = negate_all([1, -2]) == [-1, 2] and negate_all([Vec2{x: 1, y: 1}]) == [Vec2{x: -1, y: -1}]
test builtin_list_eq_is_structural = [Frac{num: 1, den: 2}] != [Frac{num: 2, den: 4}]
