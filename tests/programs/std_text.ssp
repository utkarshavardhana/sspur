// std_text

type Row = {name: Str, price: F64, qty: Int}

fn parse_kv(line: Str) -> Opt[(Str, Str)]
= line.split_once("=").map(p => (p.0.trim, p.1.trim))

fn config(text: Str) -> Map[Str, Str]
= text.split("\n").fold(empty_map(), (m, l) => match parse_kv(l)
  | some((k, v)) => m.put(k, v)
  | none => m)

fn table(rows: List[Row]) -> Str
= do
  w = rows.map(_.name.len).max.or(0)
  rows.fold(str_buf(), (b, r) => b.add(r.name.pad_right(w, " ")).add(" | ").add(r.price.fmt(2).pad_left(8, " ")).add(" | ").add(r.qty.str.pad_left(3, "0")).add("\n")).str

fn sum_floats(s: Str) -> F64
= s.split(",").map(x => x.to_f64.or(0.0)).sum

fn finds(s: Str) -> List[Opt[Int]]
= [s.index_of("é"), s.index_of("lo"), s.index_of(""), s.index_of("zz")]

fn utf8(s: Str) -> Str
= "{s.bytes.len} {s.codes} {from_codes(s.codes) == some(s)} {from_bytes(s.bytes) == some(s)} {from_bytes([255])} {from_codes([55296])}"

fn floats() -> List[Str]
= [3.14159.fmt(2), 2.5.fmt(0), (-0.004).fmt(2), 1e21.fmt(1), 0.125.fmt(2), 1.0.fmt(5), (0.0 / 0.0).fmt(3), 100.0.fmt(0)]

fn parses() -> List[Opt[F64]]
= ["1.5", " -2e3 ", ".5", "5.", "1e", "abc", "+7", "inf", "1_0", ""].map(_.to_f64)

fn build(n: Int) -> Int
= (0..n).fold(str_buf(), (b, i) => b.add("{i % 10}")).byte_len

fn pads() -> List[Str]
= ["ab".pad_left(5, "xy"), "abc".pad_left(2, "-"), "é".pad_right(3, "·"), "x".pad_left(4, "")]

test kv = parse_kv(" host = example.com ") == some(("host", "example.com"))
test kv_none = parse_kv("no equals") == none
test cfg = config("a=1\nb = two\n\nc=x=y").items == [("a", "1"), ("b", "two"), ("c", "x=y")]
test tbl = table([Row{name: "tea", price: 3.5, qty: 7}, Row{name: "coffee", price: 12.25, qty: 120}]) == "tea    |     3.50 | 007\ncoffee |    12.25 | 120\n"
test float_sum = sum_floats("1.5,2.25,x,-0.75") == 3.0
test find_chars = finds("héllo") == [some(1), some(3), some(0), none]
test utf8_round = utf8("aé日") == "6 [97, 233, 26085] true true none none"
test fixed = floats() == ["3.14", "2", "-0.00", "1000000000000000000000.0", "0.12", "1.00000", "NaN", "100"]
test parse_floats = parses() == [some(1.5), some(-2000.0), some(0.5), some(5.0), none, none, some(7.0), none, none, none]
test builder = build(100000) == 100000
test padding = pads() == ["xyxab", "abc", "é··", "x"]


// std_regex

type Entry = {level: Str, code: Int, msg: Str}

fn re(p: Str) -> Regex
= match regex(p)
  | ok(r) => r
  | err(_) => re("")

fn parse_log(line: Str) -> Opt[Entry]
= re("^\\[(\\w+)\\] (\\d+): (.*)$").captures(line).map(g => Entry{level: g[1], code: g[2].to_int.or(0), msg: g[3]})

fn emails(text: Str) -> List[Str]
= re("[\\w.+-]+@[\\w-]+\\.[\\w.]+").find_all(text)

fn redact(text: Str) -> Str
= re("\\d\{3}-\\d\{4}").replace(text, "XXX-XXXX")

fn swap_names(s: Str) -> Str
= re("(\\w+), (\\w+)").replace(s, "$2 $1")

fn tokens(s: Str) -> List[Str]
= re("\\s*[,;]\\s*").split(s)

fn error_of(p: Str) -> Str
= match regex(p)
  | ok(_) => "ok"
  | err(e) => e

fn search(p: Str, s: Str) -> List[Str]
= match regex(p)
  | ok(r) => [r.is_match(s).str, r.find(s).or("-"), r.span(s).str, r.find_all(s).str, r.captures(s).str, r.replace(s, "<$0>"), r.split(s).str]
  | err(e) => [e]

test logs = parse_log("[WARN] 42: disk low") == some(Entry{level: "WARN", code: 42, msg: "disk low"}) and parse_log("WARN 42") == none
test mail = emails("write to ana@example.com or bo.b+x@mail.co.uk today") == ["ana@example.com", "bo.b+x@mail.co.uk"]
test phone = redact("call 555-1234 or 555-9876") == "call XXX-XXXX or XXX-XXXX"
test groups = swap_names("Doe, Jane; Roe, Rick") == "Jane Doe; Rick Roe" and re("(a)|(b)").captures("b") == some(["b", "", "b"])
test splitting = tokens("a, b;c ,d") == ["a", "b", "c", "d"] and re(",").split("") == [""] and re("x*").split("ab") == ["", "a", "b", ""]
test greedy_lazy = re("a+").find("caaat") == some("aaa") and re("a+?").find("caaat") == some("a") and re("<.*>").find("<a><b>") == some("<a><b>") and re("<.*?>").find("<a><b>") == some("<a>")
test leftmost_first = re("a|ab").find("ab") == some("a") and re("ab|a").find("ab") == some("ab") and re("(a|ab)(c|bcd)").captures("abcd") == some(["abcd", "a", "bcd"])
test anchors = re("^ab$").is_match("ab") and not re("^ab$").is_match("abc") and re("\\bcat\\b").find_all("cat concat cat.") == ["cat", "cat"] and re("\\Bcat").find_all("cat concat") == ["cat"]
test counted = re("^a{2,3}$").is_match("aaa") and not re("^a{2,3}$").is_match("aaaa") and re("^a\{2}$").is_match("aa") and re("x{2,}").find("xxxxx") == some("xxxxx") and re("a{,2}").find("a{,2}") == some("a{,2}")
test classes = re("[^a-c]+").find("abcxyzab") == some("xyz") and re("[\\d.]+").find("v1.2.3!") == some("1.2.3") and re("[]a]+").find("x]a]") == some("]a]") and re("[a-]+").find("b-a-") == some("-a-") and re("\\W+").find("ab, cd") == some(", ")
test unicode = re("é+").find("caféé!") == some("éé") and re(".").find_all("añb") == ["a", "ñ", "b"] and re("[à-ü]").find("xyzö") == some("ö") and re("ñ").span("añb") == some((1, 2))
test empty_matches = re("a*").find_all("baa") == ["", "aa", ""] and re("").replace("ab", "-") == "-a-b-" and re("x*").replace("abc", "!") == "!a!b!c!"
test dots = re("a.c").is_match("abc") and not re("a.c").is_match("a\nc") and re("\\.").find_all("a.b.c") == [".", "."]
test escapes = re("\\t\\n").is_match("x\t\ny") and re("\\$\\(\\)").is_match("$()") and re("a\\|b").find("a|b") == some("a|b")
test replace_refs = re("(\\w)(\\d)").replace("a1 b2", "$2$1 $$ $9") == "1a $ $9 2b $ $9" and re("o").replace("foo", "0") == "f00"
test errors = [error_of("a("), error_of("a)"), error_of("[a-"), error_of("*a"), error_of("a**"), error_of("a{3,2}"), error_of("\\q"), error_of("[z-a]"), error_of("(?x)"), error_of("a\{1001}"), error_of("(x\{999})\{999}")] == ["unclosed group", "unmatched ')'", "unclosed class", "nothing to repeat", "nothing to repeat", "bad repetition", "bad escape", "bad class range", "bad group", "bad repetition", "regex too large"]
test values = re("a+").str == "/a+/" and re("a") == re("a") and re("a") != re("b") and [re("b"), re("a")].sort == [re("a"), re("b")]
test probe = search("(\\d+)-(\\d+)", "x 10-20 y 3-4") == ["true", "10-20", "some((2, 7))", "[\"10-20\", \"3-4\"]", "some([\"10-20\", \"10\", \"20\"])", "x <10-20> y <3-4>", "[\"x \", \" y \", \"\"]"]

fn built_re(k: Int, j: Int, m: Int) -> List[Str]
= do
  atoms = ["a", "b", ".", "[ab]", "[^a]", "\\d", "\\w", "(a|b)", "(?:ab|a)", "x", "^", "$", "\\b", "é", "(a*)", "[a-c\\s]"]
  quants = ["", "*", "+", "?", "*?", "+?", "\{1,2}", "\{2}", "??", "\{0,3}?"]
  p = (0..4).map(i => atoms[k.shr(i * 4).band(15)] + quants[j.shr(i * 4).band(15) % 10]).join("")
  s = (0..m.band(15)).map(i => ["a", "b", "1", " ", "é", "x", "ab", "\n"][m.shr(4 + i * 3).band(7)]).join("")
  search(p, s) + [p]

test built_ok = built_re(1, 2, 37).len == 8


// std_casing

fn fold(s: Str) -> Str
= s.fold_case

fn ci(a: Str, b: Str) -> Int
= a.compare_ci(b)

fn sort_ci(xs: List[Str]) -> List[Str]
= xs.sort_with((a, b) => a.compare_ci(b))

fn same_word(a: Str, b: Str) -> Bool
= a.compare_ci(b) == 0

test folds = fold("Straße") == "strasse" and fold("ΣΊΣΥΦΟΣ") == fold("σίσυφος") and fold("ABC") == "abc" and fold("") == ""
test casing = "straße".upper == "STRASSE" and "ÀÉÎ".lower == "àéî" and "ǅ".lower == "ǆ"
test compares = ci("Apple", "apple") == 0 and ci("apple", "Banana") == -1 and ci("zeta", "Alpha") == 1 and same_word("STRASSE", "straße")
test sorting = sort_ci(["banana", "Apple", "cherry", "apple", "Banana"]) == ["Apple", "apple", "banana", "Banana", "cherry"]


// std_format

type RowFormat = {name: Str, qty: Int, price: F64}

fn row(r: RowFormat) -> Str
= "{r.name.format("<10")}|{r.qty.format(">5")}|{r.price.format(">10,.2f")}"

fn table_format(rows: List[RowFormat]) -> List[Str]
= [["item".format("<10"), "qty".format(">5"), "price".format(">10")].join("|"), "-".repeat(27)] + rows.map(row)

fn hex_dump(bs: List[Int]) -> Str
= bs.map(_.format("02x")).join(" ")

fn ints(n: Int, spec: Str) -> Str
= n.format(spec)

fn floats_format(x: F64, spec: Str) -> Str
= x.format(spec)

fn strs(s: Str, spec: Str) -> Str
= s.format(spec)

fn try_spec(spec: Str) -> Str
= 42.format(spec)

test aligned = table_format([RowFormat{name: "apple", qty: 3, price: 1234.5}, RowFormat{name: "kiwi", qty: 12, price: 0.25}]) == ["item      |  qty|     price", "---------------------------", "apple     |    3|  1,234.50", "kiwi      |   12|      0.25"]
test hex = hex_dump([0, 15, 255, 16]) == "00 0f ff 10" and 255.format("#X") == "0XFF" and 255.format("#06x") == "0x00ff" and (0 - 255).format("x") == "-ff"
test radix = 5.format("b") == "101" and 5.format("#010b") == "0b00000101" and 8.format("o") == "10" and 8.format("#o") == "0o10"
test signs = 7.format("+") == "+7" and (0 - 7).format("+") == "-7" and 7.format(" ") == " 7" and (0 - 7).format("05") == "-0007"
test centered = "ab".format("^6") == "  ab  " and "ab".format("*^7") == "**ab***" and 5.format("x^5") == "xx5xx"
test grouping = 1234567.format(",") == "1,234,567" and (0 - 1234567).format(",") == "-1,234,567" and 999.format(",") == "999"
test fixed_format = 3.14159.format(".2f") == "3.14" and 2.5.format(".0f") == "2" and 1.0.format("f") == "1.000000" and (0.0 - 0.5).format("+.1f") == "-0.5"
test sci = 12345.678.format(".3e") == "1.235e+04" and 0.00012.format("E") == "1.200000E-04" and 1.0e100.format(".1e") == "1.0e+100"
test percent = 0.256.format(".1%") == "25.6%" and 1.0.format("%") == "100.000000%"
test plain_float = 1.5.format("") == "1.5" and 1.5.format("8") == "     1.5" and (0.0 - 1.5).format("<8") == "-1.5    " and 2.0.format("08") == "000002.0"
test specials = nan().format(".2f") == "NaN" and (0.0 - inf()).format("6") == "  -inf" and inf().format("+") == "+inf"
test truncate = "hello world".format(".5") == "hello" and "héllo".format(">7.3") == "    hél" and "€".format("€>3") == "€€€"
test unicode_fill = 3.format("é<3") == "3éé"

fn float_spec(k: Int, w: Int, p: Int) -> Str
= do
  aligns = ["", "<", ">", "^", "=", "*<", "0>"]
  signs = ["", "+", " ", "-"]
  tys = ["", "f", "e", "E", "%"]
  prec = if p % 3 == 0 then "" else "." + (p % 25).str
  aligns[k % 7] + signs[k / 7 % 4] + (if k % 2 == 0 then "0" else "") + (w % 30).str + (if w % 5 == 0 then "," else "") + prec + tys[k / 28 % 5]

fn float_built(k: Int, w: Int, p: Int, x: F64) -> Str
= x.format(float_spec(k.band(1023), w.band(1023), p.band(1023)))

fn int_built(k: Int, w: Int, n: Int) -> Str
= do
  aligns = ["", "<", ">", "^", "=", "_^"]
  tys = ["", "d", "x", "X", "o", "b"]
  k2 = k.band(1023)
  spec = aligns[k2 % 6] + ["", "+", " "][k2 / 6 % 3] + (if k2 % 4 == 0 then "#" else "") + (if k2 % 3 == 0 then "0" else "") + (w.band(63)).str + (if w % 7 == 0 then "," else "") + tys[k2 / 18 % 6]
  n.format(spec)

test built_specs = float_built(5, 12, 4, 3.75) == float_built(5, 12, 4, 3.75) and int_built(20, 9, 255).len >= 3


// std_locale

fn loc(tag: Str) -> Locale
= locale(tag).get

fn tags() -> List[Str]
= ["en-US", "en-GB", "de-DE", "fr-FR", "ja-JP", "hi-IN"]

fn every(f: Locale -> Str) -> List[Str]
= tags().map(t => f(loc(t)))

fn moment() -> Time
= datetime(2026, 3, 7, 15, 4, 5).get

fn midnight() -> Time
= datetime(2026, 12, 25, 0, 30, 0).get

fn words() -> List[Str]
= ["zebra", "Äpfel", "apfel", "Apfel", "äpfel", "abc", "Zürich", "zurich", "côte", "cote", "coté", "côté", "straße", "strasse", "Ab", "ab", "a b", "10", "9", "Ω", "日本", "éclair", "Eclair", "œuvre", "oeuvre", "Łódź", "lodz"]

fn sign(n: Int) -> Int
= if n < 0 then -1 else if n > 0 then 1 else 0

fn agrees(l: Locale, xs: List[Str]) -> Bool
= do
  ys = l.sort(xs)
  ys.windows(2).all(p => l.compare(p[0], p[1]) < 0) and xs.all(x => l.compare(x, x) == 0) and xs.all(a => xs.all(b => sign(l.compare(a, b)) == -sign(l.compare(b, a))))

test tags_parse = locale("de-DE").map(l => l.tag) == some("de-DE") and locale("de_DE") == none and locale("xx-YY") == none and locale("") == none
test collation = loc("en-US").sort(words()) == ["10", "9", "a b", "ab", "Ab", "abc", "apfel", "Apfel", "äpfel", "Äpfel", "cote", "coté", "côte", "côté", "Eclair", "éclair", "lodz", "Łódź", "oeuvre", "œuvre", "strasse", "straße", "zebra", "zurich", "Zürich", "Ω", "日本"]
test collation_is_total = agrees(loc("fr-FR"), words()) and agrees(loc("ja-JP"), ["カ", "か", "が", "漢字", "a", "A", ""])
test decomposed = loc("de-DE").compare(from_codes([101, 769]).get, "é") != 0 and loc("de-DE").compare("ée", from_codes([101, 769, 102]).get) < 0 and loc("de-DE").compare("Ä", from_codes([97, 776]).get) > 0
test same_rules_everywhere = tags().all(t => loc(t).sort(words()) == loc("en-US").sort(words()))
test integers = every(l => l.format_int(-1234567)) == ["-1,234,567", "-1,234,567", "-1.234.567", "-1{nb()}234{nb()}567", "-1,234,567", "-12,34,567"]
test small_integers = every(l => l.format_int(999)) == ["999", "999", "999", "999", "999", "999"] and loc("hi-IN").format_int(-9223372036854775807 - 1) == "-92,23,37,20,36,85,47,75,808"
test floats_locale = every(l => l.format_f64(1234567.891, 2)) == ["1,234,567.89", "1,234,567.89", "1.234.567,89", "1{nb()}234{nb()}567,89", "1,234,567.89", "12,34,567.89"] and loc("de-DE").format_f64(0.5, 0) == "0" and loc("de-DE").format_f64(inf(), 2) == "inf"
test decimals = loc("fr-FR").format_dec(decimal("-98765.4321").get) == "-98{nb()}765,4321" and loc("hi-IN").format_dec(decimal("100000").get) == "1,00,000"
test dates = every(l => l.format_date(moment())) == ["3/7/2026", "07/03/2026", "07.03.2026", "07/03/2026", "2026/03/07", "7/3/2026"]
test long_dates = every(l => l.format_date_long(moment())) == ["March 7, 2026", "7 March 2026", "7. März 2026", "7 mars 2026", "2026年3月7日", "7 मार्च 2026"]
test times = every(l => l.format_time(moment())) == ["3:04 PM", "15:04", "15:04", "15:04", "15:04", "3:04 pm"] and every(l => l.format_time(midnight())) == ["12:30 AM", "00:30", "00:30", "00:30", "0:30", "12:30 am"]
test months = loc("hi-IN").format_date_long(midnight()) == "25 दिसंबर 2026" and loc("fr-FR").format_date_long(date(2026, 8, 1).get) == "1 août 2026"
test encode = json.encode(loc("ja-JP")) == "\{\"tag\":\"ja-JP\"}"

fn nb() -> Str
= from_codes([8239]).get


// text

fn is_palindrome(s: Str) -> Bool
= do
  cs = s.lower.chars.filter(_.is_alpha)
  cs == cs.reverse

fn shift(c: Str, k: Int) -> Str
= do
  alpha = "abcdefghijklmnopqrstuvwxyz"
  match alpha.chars.enumerate.find(_.1 == c)
  | some((i, _)) => alpha.chars[(i + k % 26 + 26) % 26]
  | none => c

fn caesar(s: Str, k: Int) -> Str
= s.chars.map(c => shift(c, k)).join("")

fn rle(s: Str) -> Str
= do
  var out = ""
  var prev = ""
  var n = 0
  for c in s.chars
    if c == prev then n := n + 1 else do
      if n > 0 then out := out + "{n}{prev}"
      prev := c
      n := 1
  if n > 0 then out := out + "{n}{prev}"
  out

fn main() -> Unit ! log
= do
  log(caesar("hello world", 3))
  log(rle("aaabccdddd"))

test pal = is_palindrome("A man, a plan, a canal: Panama")
test not_pal = not is_palindrome("sspur")
test caesar_round = caesar(caesar("hello", 3), -3) == "hello"
test caesar_shift = caesar("abc xyz", 1) == "bcd yza"
test rle_ok = rle("aaabccdddd") == "3a1b2c4d"
test rle_empty = rle("") == ""
