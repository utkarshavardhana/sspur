type Room = {name: Str, exits: List[(Str, Str)], items: List[Str], locked: List[Str]}

fn go(g: Game, dir: Str) -> (Game, Str)
= match current(g).exits.find(_.0 == dir)
| some(e) => if current(g).locked.contains(dir) and not g.inventory.contains("key") then (g, "The door is locked.") else do
  g2 = g with room := e.1, moves := g.moves + 1
  (g2, look(g2))
| none => (g, "You can't go that way.")

fn look(g: Game) -> Str
= do
  r = current(g)
  base = "You are in the {r.name}. Exits: " + r.exits.map(_.0).sort.join(", ")
  if r.items.len == 0 then base + "." else base + ". Items: " + r.items.sort.join(", ") + "."

fn set_items(g: Game, items: List[Str]) -> List[Room]
= g.rooms.map(r => if r.name == g.room then r with items := items else r)

fn take_item(g: Game, item: Str) -> (Game, Str)
= if current(g).items.contains(item) then ((g with rooms := set_items(g, current(g).items.filter(_ != item)), inventory := g.inventory.push(item)), "Taken.") else (g, "There is no {item} here.")

fn drop_item(g: Game, item: Str) -> (Game, Str)
= if g.inventory.contains(item) then ((g with rooms := set_items(g, current(g).items.push(item)), inventory := g.inventory.filter(_ != item)), "Dropped.") else (g, "You don't have {item}.")

fn inv_text(g: Game) -> Str
= if g.inventory.len == 0 then "You carry nothing." else "You carry: " + g.inventory.sort.join(", ") + "."

fn score(g: Game) -> Int
= g.inventory.len * 10 + (if g.room == "vault" then 25 else 0)

fn dispatch(g: Game, w: List[Str]) -> (Game, Str)
= if w.len == 1 and w[0] == "look" then (g, look(g))
  else if w.len == 1 and w[0] == "inventory" then (g, inv_text(g))
  else if w.len == 2 and w[0] == "go" then go(g, w[1])
  else if w.len == 2 and w[0] == "take" then take_item(g, w[1])
  else if w.len == 2 and w[0] == "drop" then drop_item(g, w[1])
  else (g, "I don't understand.")

fn step(g: Game, cmd: Str) -> (Game, Str)
= dispatch(g, cmd.lower.split(" ").filter(_.len > 0))

fn world() -> List[Room]
= [Room{name: "hall", exits: [("north", "vault"), ("east", "kitchen")], items: [], locked: ["north"]}, Room{name: "kitchen", exits: [("west", "hall")], items: ["key", "bread"], locked: []}, Room{name: "vault", exits: [("south", "hall")], items: ["gold"], locked: []}]

test starts_in_hall = play(["look"]) == ["You are in the hall. Exits: east, north."]

test walks = play(["go east", "go west"]).last == some("You are in the hall. Exits: east, north.")

test forgiving = play(["  GO   East ", "", "   ", "dance", "go"]) == ["You are in the kitchen. Exits: west. Items: bread, key.", "I don't understand.", "I don't understand.", "I don't understand.", "I don't understand."]

test take_drop_inv = play(["inventory", "take key", "take key", "go east", "take Bread", "inventory", "drop key", "drop key", "look"]) == ["You carry nothing.", "There is no key here.", "There is no key here.", "You are in the kitchen. Exits: west. Items: bread, key.", "Taken.", "You carry: bread.", "You don't have key.", "You don't have key.", "You are in the kitchen. Exits: west. Items: key."]

test locked_door = play(["go north"]) == ["The door is locked."]

test locked_no_move = run(["go north"]).0.moves == 0

test key_opens = run(["go east", "take key", "go west", "go north"]).0.room == "vault"

test score_test = score(run(["go east", "take key", "take bread", "go west", "go north"]).0) == 45

test score_start = score(new_game()) == 0

test drop_ok = play(["go east", "take key", "take bread", "drop bread", "look", "inventory"]).drop(3) == ["Dropped.", "You are in the kitchen. Exits: west. Items: bread.", "You carry: key."]
