// str_find computed its end pointer as h.p + h.len - n.len + 1 before checking lengths. With an empty runtime string (null data) and a longer needle,
// the end pointer wrapped and memchr read address 0: the native build segfaulted (or hung in a long run).

type R = {a: Int, b: Int where _ != 0}

fn scan(a: Int) -> Set[Int]
= do
  for i in 0..3
    for j in 0..i % 8
      if "".replace("a", "xy").contains(" x y ") then do
        var v = R{a: 1, b: j}
  [a].to_set

fn finds(s: Str) -> Int
= s.replace("q", "").index_of("long needle").or(-1) + (if s.replace("q", "").contains("zzzzzz") then 1 else 0)

test empty_haystack = scan(2) == [2].to_set and finds("") == -1 and finds("qq") == -1
