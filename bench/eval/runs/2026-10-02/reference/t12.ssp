fn area(s: Shape) -> F64
= match s
  | Circle{r} => 3.14159 * r * r
  | Rect{w, h} => w * h
  | Square{s} => s * s

fn largest_area(xs: List[Shape]) -> Opt[Shape]
= xs.fold(none, (best, x) => pick(best, x))

fn pick(best: Opt[Shape], x: Shape) -> Opt[Shape]
= match best
  | some(b) if area(b) >= area(x) => some(b)
  | _ => some(x)
