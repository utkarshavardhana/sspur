type ConfigErr = MissingKey{path: Str}

type J = JNull | JBool{b: Bool} | JNum{n: Int} | JStr{s: Str} | JArr{items: List[J]} | JObj{fields: List[(Str, J)]}

fn arr_get(items: List[J], k: Str) -> Opt[J]
= match k.to_int
| some(i) => if i >= 0 and i < items.len then some(items[i]) else none
| none => none

fn defaults() -> J
= JObj{fields: [("name", JStr{s: "app"}), ("port", JNum{n: 8080}), ("db", JObj{fields: [("host", JStr{s: "localhost"}), ("pool", JNum{n: 5})]}), ("tags", JArr{items: [JStr{s: "a"}]})]}

fn esc(s: Str) -> Str
= s.replace("\\", "\\\\").replace("\"", "\\\"")

fn get_field(j: J, key: Str) -> Opt[J]
= match j
| JObj{fields} => fields.find(_.0 == key).map(_.1)
| JArr{items} => arr_get(items, key)
| _ => none

fn get_path(j: J, path: Str) -> Opt[J]
= do
  var cur = some(j)
  for k in path.split(".")
    cur := match cur
    | some(v) => get_field(v, k)
    | none => none
  cur

fn is_null(j: J) -> Bool
= match j
| JNull => true
| _ => false

fn main() -> Unit ! log
= log(render(merge(defaults(), JObj{fields: [("port", JNum{n: 9090})]})))

fn merge(target: J, patch: J) -> J
= match patch
| JObj{fields: p} => do
  var cur = obj_fields(target)
  for kv in p
    k = kv.0
    v = kv.1
    if is_null(v) then cur := cur.filter(f => f.0 != k) else if cur.any(f => f.0 == k) then cur := cur.map(f => if f.0 == k then (k, merge(f.1, v)) else f) else cur := cur + [(k, merge(JNull, v))]
  JObj{fields: cur}
| _ => patch

fn merge_all(base: J, patches: List[J]) -> J
= patches.fold(base, (acc, p) => merge(acc, p))

fn obj2(a: Str, x: J, b: Str, y: J) -> J
= JObj{fields: [(a, x), (b, y)]}

fn obj_fields(j: J) -> List[(Str, J)]
= match j
| JObj{fields} => fields
| _ => []

fn render(j: J) -> Str
= match j
| JNull => "null"
| JBool{b} => if b then "true" else "false"
| JNum{n} => n.str
| JStr{s} => "\"" + esc(s) + "\""
| JArr{items} => "[" + items.map(render).join(",") + "]"
| JObj{fields} => "\{" + fields.map(f => "\"" + esc(f.0) + "\":" + render(f.1)).join(",") + "}"

fn require(j: J, paths: List[Str]) -> Unit ! fail[ConfigErr]
= do
  for p in paths
    if get_path(j, p).is_none then raise MissingKey{path: p}
  ()

test array_path = get_path(JObj{fields: [("servers", JArr{items: [JObj{fields: [("host", JStr{s: "x"})]}, JObj{fields: [("host", JStr{s: "y"})]}]})]}, "servers.1.host") == some(JStr{s: "y"})

test array_path_missing = get_path(JObj{fields: [("s", JArr{items: [JNull]})]}, "s.1") == none and get_path(JObj{fields: [("s", JArr{items: [JNull]})]}, "s.-1") == none and get_path(JObj{fields: [("s", JArr{items: [JNull]})]}, "s.x") == none

test escapes = render(JObj{fields: [("k\"\\", JStr{s: "a\"b\\c"})]}) == "\{\"k\\\"\\\\\":\"a\\\"b\\\\c\"}"

test key_order = render(merge(obj2("b", JNum{n: 1}, "a", JNum{n: 2}), obj2("c", JNum{n: 3}, "a", JNum{n: 4}))) == "\{\"b\":1,\"a\":4,\"c\":3}"

test merge_all_order = get_path(merge_all(defaults(), [JObj{fields: [("port", JNum{n: 1})]}, JObj{fields: [("port", JNum{n: 2}), ("name", JNull)]}]), "port") == some(JNum{n: 2}) and get_path(merge_all(defaults(), [JObj{fields: [("name", JNull)]}]), "name") == none

test merge_array_replaced = render(merge(defaults(), JObj{fields: [("tags", JArr{items: [JNum{n: 1}]})]})) == "\{\"name\":\"app\",\"port\":8080,\"db\":\{\"host\":\"localhost\",\"pool\":5},\"tags\":[1]}"

test merge_nested = render(merge(defaults(), JObj{fields: [("db", JObj{fields: [("pool", JNum{n: 9})]})]})) == "\{\"name\":\"app\",\"port\":8080,\"db\":\{\"host\":\"localhost\",\"pool\":9},\"tags\":[\"a\"]}"

test merge_non_object_target = render(merge(JNum{n: 1}, JObj{fields: [("a", JObj{fields: [("x", JNull), ("y", JNum{n: 2})]})]})) == "\{\"a\":\{\"y\":2}}"

test merge_null_removes = render(merge(obj2("a", JNum{n: 1}, "b", JNum{n: 2}), JObj{fields: [("a", JNull)]})) == "\{\"b\":2}"

test merge_scalar_patch = merge(defaults(), JNum{n: 3}) == JNum{n: 3}

test merges_top_level = get_path(merge(defaults(), JObj{fields: [("name", JStr{s: "web"})]}), "name") == some(JStr{s: "web"})

test path = get_path(defaults(), "db.pool") == some(JNum{n: 5}) and get_path(defaults(), "db.user") == none

test renders = render(JObj{fields: [("a", JArr{items: [JNum{n: 1}, JBool{b: true}, JNull]})]}) == "\{\"a\":[1,true,null]}"

test require_missing = catch require(defaults(), ["name", "db.user", "zzz"]) == ()
| MissingKey{path} => path == "db.user"

test require_ok = catch require(defaults(), ["name", "db.host"]) == ()
| _ => false
