type ConfigErr = MissingKey{path: Str}

type J = JNull | JBool{b: Bool} | JNum{n: Int} | JStr{s: Str} | JArr{items: List[J]} | JObj{fields: List[(Str, J)]}

fn apply_key(fields: List[(Str, J)], k: Str, v: J) -> List[(Str, J)]
= match v
| JNull => fields.filter(f => f.0 != k)
| _ => match fields.find(f => f.0 == k)
| some(_) => fields.map(f => if f.0 == k then (k, merge(f.1, v)) else f)
| none => fields + [(k, merge(JNull, v))]

fn base_fields(t: J) -> List[(Str, J)]
= match t
| JObj{fields} => fields
| _ => []

fn defaults() -> J
= JObj{fields: [("name", JStr{s: "app"}), ("port", JNum{n: 8080}), ("db", JObj{fields: [("host", JStr{s: "localhost"}), ("pool", JNum{n: 5})]}), ("tags", JArr{items: [JStr{s: "a"}]})]}

fn esc(s: Str) -> Str
= s.replace("\\", "\\\\").replace("\"", "\\\"")

fn get_field(j: J, key: Str) -> Opt[J]
= match j
| JObj{fields} => fields.find(_.0 == key).map(_.1)
| _ => none

fn get_path(j: J, path: Str) -> Opt[J]
= do
  var cur = some(j)
  for k in path.split(".")
    cur := match cur
    | some(v) => step(v, k)
    | none => none
  cur

fn idx(items: List[J], k: Str) -> Opt[J]
= match k.to_int
| some(n) => if n >= 0 then items.get(n) else none
| none => none

fn main() -> Unit ! log
= log(render(merge(defaults(), JObj{fields: [("port", JNum{n: 9090})]})))

fn merge(target: J, patch: J) -> J
= match patch
| JObj{fields: p} => JObj{fields: p.fold(base_fields(target), (acc, kv) => apply_key(acc, kv.0, kv.1))}
| _ => patch

fn merge_all(base: J, patches: List[J]) -> J
= patches.fold(base, (acc, p) => merge(acc, p))

fn render(j: J) -> Str
= match j
| JNull => "null"
| JBool{b} => if b then "true" else "false"
| JNum{n} => n.str
| JStr{s} => "\"" + esc(s) + "\""
| JArr{items} => "[" + items.map(render).join(",") + "]"
| JObj{fields} => "\{" + fields.map(f => "\"" + esc(f.0) + "\":" + render(f.1)).join(",") + "}"

fn require(j: J, paths: List[Str]) -> Unit ! fail[ConfigErr]
= do
  for p in paths
    if get_path(j, p).is_none then raise MissingKey{path: p}

fn step(v: J, k: Str) -> Opt[J]
= match v
| JArr{items} => idx(items, k)
| _ => get_field(v, k)

test array_paths = get_path(JObj{fields: [("servers", JArr{items: [JObj{fields: [("host", JStr{s: "a"})]}, JObj{fields: [("host", JStr{s: "b"})]}]})]}, "servers.1.host") == some(JStr{s: "b"}) and get_path(JArr{items: [JNull]}, "5") == none and get_path(JArr{items: [JNull]}, "-1") == none and get_path(JArr{items: [JNull]}, "x") == none

test escaping = render(JObj{fields: [("k\"q", JStr{s: "a\\b\"c"})]}) == "\{\"k\\\"q\":\"a\\\\b\\\"c\"}"

test key_order = render(merge(JObj{fields: [("a", JNum{n: 1}), ("b", JNum{n: 2})]}, JObj{fields: [("c", JNum{n: 3}), ("a", JNum{n: 9})]})) == "\{\"a\":9,\"b\":2,\"c\":3}"

test merge_all_order = render(merge_all(JObj{fields: [("a", JNum{n: 0})]}, [JObj{fields: [("a", JNum{n: 1})]}, JObj{fields: [("a", JNum{n: 2}), ("b", JNull)]}])) == "\{\"a\":2}"

test merges_top_level = get_path(merge(defaults(), JObj{fields: [("name", JStr{s: "web"})]}), "name") == some(JStr{s: "web"})

test path = get_path(defaults(), "db.pool") == some(JNum{n: 5}) and get_path(defaults(), "db.user") == none

test renders = render(JObj{fields: [("a", JArr{items: [JNum{n: 1}, JBool{b: true}, JNull]})]}) == "\{\"a\":[1,true,null]}"

test require_missing = catch require(defaults(), ["name", "db.user", "zzz"]) == ()
| MissingKey{path} => path == "db.user"

test require_ok = catch require(defaults(), ["name", "db.host"]) == ()
| _ => false

test rfc_arrays_replaced = render(merge(JObj{fields: [("a", JArr{items: [JNum{n: 1}, JNum{n: 2}]})]}, JObj{fields: [("a", JArr{items: [JNum{n: 3}]})]})) == "\{\"a\":[3]}"

test rfc_nested = render(merge(JObj{fields: [("a", JObj{fields: [("x", JNum{n: 1})]})]}, JObj{fields: [("a", JObj{fields: [("y", JNum{n: 2})]})]})) == "\{\"a\":\{\"x\":1,\"y\":2}}"

test rfc_nonobj_patch = merge(JObj{fields: [("a", JNum{n: 1})]}, JNum{n: 5}) == JNum{n: 5}

test rfc_nonobj_target = render(merge(JNum{n: 1}, JObj{fields: [("a", JObj{fields: [("b", JNull)]})]})) == "\{\"a\":\{}}"

test rfc_null_removes = render(merge(JObj{fields: [("a", JNum{n: 1}), ("b", JNum{n: 2})]}, JObj{fields: [("a", JNull)]})) == "\{\"b\":2}"
