// Inside a local function, captured variables are reached through the closure environment pointer e_.
// Several library expansions declared their own e_ before evaluating an argument, which shadowed the environment and broke the C build.

fn hm(b: List[Int]) -> Int
= do
  var acc = 0
  fn g(k: Int) -> Int
  = do
    acc := hash_map().put("a", acc + k).put("b", acc).len + acc
    acc
  g(1) + g(2)

fn stepped(n: Int) -> Int
= do
  var step = 2
  fn g(k: Int) -> Int
  = do
    step := step + k
    range(0, 20, step).sum
  g(1) + g(n % 3)

fn pw(n: Int) -> Int
= do
  var e = 3
  fn g(k: Int) -> Int
  = do
    e := e + k % 3
    big(2).pow(e).to_int.or(0)
  g(n)

test captured = hm([1]) == 6 and stepped(1) == 103 and pw(0) == 8
