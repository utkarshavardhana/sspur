fn run_str(c: Str, n: Int) -> Str
= if n == 1 then c else c + n.str

fn compress(s: Str) -> Str
= do
  var out = ""
  var cur = ""
  var cnt = 0
  for c in s.chars
    if c == cur then cnt := cnt + 1 else do
      if cnt > 0 then out := out + run_str(cur, cnt)
      cur := c
      cnt := 1
  if cnt > 0 then out := out + run_str(cur, cnt)
  out

test z1 = compress("aaabcc") == "a3bc2"
test z2 = compress("") == ""
test z3 = compress("abc") == "abc"
