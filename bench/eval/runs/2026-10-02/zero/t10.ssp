fn emit(c: Str, n: Int) -> Str
= if n == 0 then "" else if n == 1 then c else "{c}{n}"

fn compress(s: Str) -> Str
= do
  var out = ""
  var prev = ""
  var n = 0
  for c in s.chars
    if n > 0 and c == prev then n := n + 1 else do
      out := out + emit(prev, n)
      prev := c
      n := 1
  out + emit(prev, n)
