type DepErr = Unknown{name: Str} | Missing{pkg: Str, dep: Str} | Cycle{path: List[Str]} | Stuck{names: List[Str]}

fn visit(reg: List[Pkg], name: Str, chain: List[Str], done: List[Str]) -> List[Str] ! fail[DepErr]
= do
  if chain.contains(name) then raise Cycle{path: chain.drop(chain.index_of(name).or(0)).push(name)}
  if done.contains(name) then done else do
    p = find_pkg(reg, name)
    var acc = done
    for d in p.deps
      if not reg.any(_.name == d) then raise Missing{pkg: name, dep: d}
      acc := visit(reg, d, chain.push(name), acc)
    acc.push(name)

fn install_order(reg: List[Pkg], target: Str) -> List[Str] ! fail[DepErr]
= visit(reg, target, [], [])

fn plan(reg: List[Pkg], target: Str) -> Str
= catch install_order(reg, target).join(" -> ")
| Unknown{name} => "error: unknown package {name}"
| Missing{pkg, dep} => "error: {pkg} needs missing {dep}"
| Cycle{path} => "error: cycle {path.join(" -> ")}"
| Stuck{names} => "error: stuck {names.join(", ")}"

fn full_rec(reg: List[Pkg], rem: List[Str], done: List[Str]) -> List[Str] ! fail[DepErr]
= if rem.len == 0 then done else do
  ready = rem.filter(n => reg.any(p => p.name == n and p.deps.all(d => done.contains(d))))
  if ready.len == 0 then raise Stuck{names: rem}
  pick = ready.first.get
  full_rec(reg, rem.filter(_ != pick), done.push(pick))

fn full_order(reg: List[Pkg]) -> List[Str] ! fail[DepErr]
= full_rec(reg, reg.map(_.name).unique.sort, [])

fn grow(reg: List[Pkg], name: Str, found: List[Str]) -> List[Str]
= do
  fresh = reg.filter(p => p.name != name and not found.contains(p.name) and p.deps.any(d => d == name or found.contains(d))).map(_.name)
  if fresh.len == 0 then found else grow(reg, name, fresh.fold(found, (a, x) => a.push(x)))

fn dependents(reg: List[Pkg], name: Str) -> List[Str] ! fail[DepErr]
= do
  p = find_pkg(reg, name)
  grow(reg, name, []).sort

fn tregd() -> List[Pkg]
= [Pkg{name: "app", deps: ["web", "db"]}, Pkg{name: "web", deps: ["http", "log"]}, Pkg{name: "db", deps: ["log"]}, Pkg{name: "http", deps: []}, Pkg{name: "log", deps: []}]

fn tcyc() -> List[Pkg]
= [Pkg{name: "a", deps: ["b"]}, Pkg{name: "b", deps: ["c"]}, Pkg{name: "c", deps: ["a"]}, Pkg{name: "s", deps: ["s"]}, Pkg{name: "t", deps: ["a"]}, Pkg{name: "m", deps: ["zz"]}]

test dedupe = catch install_order(tregd(), "app") == ["http", "log", "web", "db", "app"]
| _ => false

test missing = plan(tcyc(), "m") == "error: m needs missing zz"

test missing_raise = catch install_order(tcyc(), "m") == []
| Missing{pkg, dep} => pkg == "m" and dep == "zz"
| _ => false

test unknown_raise = catch install_order(tregd(), "nope") == []
| Unknown{name} => name == "nope"
| _ => false

test cycle_path = catch install_order(tcyc(), "t") == []
| Cycle{path} => path == ["a", "b", "c", "a"]
| _ => false

test cycle_self = catch install_order(tcyc(), "s") == []
| Cycle{path} => path == ["s", "s"]
| _ => false

test cycle_plan = plan(tcyc(), "a") == "error: cycle a -> b -> c -> a"

test full_ok = catch full_order(tregd()) == ["http", "log", "db", "web", "app"]
| _ => false

test full_stuck = catch full_order(tcyc()) == []
| Stuck{names} => names == ["a", "b", "c", "m", "s", "t"]
| _ => false

test deps_of_log = catch dependents(tregd(), "log") == ["app", "db", "web"]
| _ => false

test deps_of_app = catch dependents(tregd(), "app") == []
| _ => false

test deps_unknown = catch dependents(tregd(), "x") == []
| Unknown{name} => name == "x"
| _ => false
