fn cents(v: Vending) -> Int
= match v
  | Idle => 0
  | HasCoins{cents} => cents

fn step(v: Vending, a: Action) -> (Vending, Str)
= match a
  | Coin{cents: c} => (HasCoins{cents: cents(v) + c}, "")
  | Buy{price} => if cents(v) >= price then (Idle, "vend change {cents(v) - price}") else (v, "need {price - cents(v)}")
  | Refund => (Idle, "refund {cents(v)}")

fn simulate(actions: List[Action]) -> List[Str]
= do
  var v = Idle
  var out = []
  for a in actions
    (nv, msg) = step(v, a)
    v := nv
    if msg != "" then out := out.push(msg)
  out
