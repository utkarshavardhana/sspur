type CalcErr = BadChar{ch: Str} | DivByZero | BadSyntax

type Tok = Num{v: Int} | Op{c: Str}

fn calc(s: Str) -> Int ! fail[CalcErr]
= do
  toks = tokenize(s)
  (v, j) = parse_expr(toks, 0)
  if j != toks.len then raise BadSyntax
  v

fn expr_rest(toks: List[Tok], acc: Int, i: Int) -> (Int, Int) ! fail[CalcErr]
= do
  c = op_at(toks, i)
  if c == "+" or c == "-" then do
      (v, j) = parse_term(toks, i + 1)
      expr_rest(toks, if c == "+" then acc + v else acc - v, j)
    else (acc, i)

fn is_digit(ch: Str) -> Bool
= "0123456789".contains(ch)

fn main() -> Unit ! log
= log(show_result("12 + 30 - 2"))

fn op_at(toks: List[Tok], i: Int) -> Str
= match toks.get(i)
| some(Op{c}) => c
| _ => ""

fn parse_expr(toks: List[Tok], i: Int) -> (Int, Int) ! fail[CalcErr]
= do
  (v, j) = parse_term(toks, i)
  expr_rest(toks, v, j)

fn parse_factor(toks: List[Tok], i: Int) -> (Int, Int) ! fail[CalcErr]
= match toks.get(i)
| some(Num{v}) => (v, i + 1)
| some(Op{c}) => parse_op_factor(toks, c, i)
| _ => raise BadSyntax

fn parse_op_factor(toks: List[Tok], c: Str, i: Int) -> (Int, Int) ! fail[CalcErr]
= if c == "-" then do
    (v, j) = parse_factor(toks, i + 1)
    (0 - v, j)
  else if c == "(" then do
      (v, j) = parse_expr(toks, i + 1)
      if op_at(toks, j) != ")" then raise BadSyntax
      (v, j + 1)
    else raise BadSyntax

fn parse_term(toks: List[Tok], i: Int) -> (Int, Int) ! fail[CalcErr]
= do
  (v, j) = parse_factor(toks, i)
  term_rest(toks, v, j)

fn show_result(s: Str) -> Str
= catch "{s} = {calc(s)}"
| BadChar{ch} => "{s} = error: bad character {ch}"
| DivByZero => "{s} = error: division by zero"
| BadSyntax => "{s} = error: syntax"

fn term_rest(toks: List[Tok], acc: Int, i: Int) -> (Int, Int) ! fail[CalcErr]
= do
  c = op_at(toks, i)
  if c == "*" or c == "/" then do
      (v, j) = parse_factor(toks, i + 1)
      if c == "/" and v == 0 then raise DivByZero
      term_rest(toks, if c == "*" then acc * v else acc / v, j)
    else (acc, i)

fn tokenize(s: Str) -> List[Tok] ! fail[CalcErr]
= do
  var toks = []
  var num = ""
  for ch in s.chars
    if is_digit(ch) then num := num + ch else do
      if not num.is_empty then do
        toks := toks.push(Num{v: num.to_int.or(0)})
        num := ""
      if "+-*/()".contains(ch) then toks := toks.push(Op{c: ch}) else if ch != " " then raise BadChar{ch: ch}
  if not num.is_empty then toks := toks.push(Num{v: num.to_int.or(0)})
  toks

test adds = catch calc("1 + 2 + 3") == 6
| _ => false

test bad_char = catch calc("2 $ 3") == 0
| BadChar{ch} => ch == "$"

test div_neg = catch calc("-7 / 2") == -3
| _ => false

test div_trunc = catch calc("7 / 2") == 3
| _ => false

test div_zero = catch calc("1 / 0") == 0
| DivByZero => true
| _ => false

test left_assoc = catch calc("100 / 10 / 5 - 3 - 1") == -2
| _ => false

test nested = catch calc("2 * (3 + (4 - 1))") == 12
| _ => false

test parens = catch calc("(1 + 2) * 3") == 9
| _ => false

test prec = catch calc("2 + 3 * 4") == 14
| _ => false

test prec2 = catch calc("2 * 3 + 4") == 10
| _ => false

test show_div = show_result("1 / 0") == "1 / 0 = error: division by zero"

test show_syn = show_result("1 +") == "1 + = error: syntax"

test shown = show_result("7 - 2") == "7 - 2 = 5"

test subtracts = catch calc("10 - 4 - 3") == 3
| _ => false

test syn_close = catch calc("1 + 2)") == 0
| BadSyntax => true
| _ => false

test syn_empty = catch calc("   ") == 0
| BadSyntax => true
| _ => false

test syn_empty_par = catch calc("()") == 0
| BadSyntax => true
| _ => false

test syn_lead = catch calc("* 2") == 0
| BadSyntax => true
| _ => false

test syn_missing = catch calc("1 +") == 0
| BadSyntax => true
| _ => false

test syn_open = catch calc("(1 + 2") == 0
| BadSyntax => true
| _ => false

test syn_two = catch calc("1 2") == 0
| BadSyntax => true
| _ => false

test unary1 = catch calc("-3") == -3
| _ => false

test unary2 = catch calc("2 * -3") == -6
| _ => false

test unary3 = catch calc("-(1 + 2)") == -3
| _ => false
