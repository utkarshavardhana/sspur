fn route_label(x: Route) -> Str
= label_of(x.name, x.id)

fn route_line(x: Route) -> Str
= route_label(x) + ": " + money(route_gross(x))

fn route_names(xs: List[Route]) -> List[Str]
= xs.map(_.name).sort

fn route_new(id: Int, name: Str, qty: Int, price: Int, region: Str) -> Route
= Route{id: id, name: name, qty: qty, price: price, region: region, active: true}

fn route_report(xs: List[Route]) -> Str
= join_lines(xs.map(route_line))

fn route_restock(x: Route, n: Int) -> Route
= x with qty := x.qty + n

fn route_sample() -> List[Route]
= [route_new(1, "alpha13", 3, 185, "APAC"), route_new(2, "beta13", 0, 900, "UK"), route_new(3, "gamma13", 8, 88, "US")]

fn route_score(x: Route) -> Int
= route_value(x) / 9 + (if x.active then 1 else 0)

fn route_tax(x: Route) -> Int
= pct(route_value(x), tax_rate(x.region))

fn route_top(xs: List[Route], n: Int) -> List[Route]
= xs.sort_by(x => -route_value(x)).take(n)

fn route_total(xs: List[Route]) -> Int
= xs.map(route_gross).sum

fn route_valid(x: Route) -> Bool
= x.qty >= 0 and x.price >= 0 and not x.name.is_empty

fn route_value(x: Route) -> Int
= x.qty * x.price

