type CalcErr = BadChar{ch: Str} | DivByZero | BadSyntax

type Tok = Num{v: Int} | Op{c: Str}

fn abs_int(a: Int) -> Int
= if a < 0 then 0 - a else a

fn calc(s: Str) -> Int ! fail[CalcErr]
= do
  toks = tokenize(s)
  r = parse_expr(toks, 0)
  if r.1 != toks.len then raise BadSyntax
  r.0

fn div_trunc(a: Int, b: Int) -> Int
= do
  q = abs_int(a) / abs_int(b)
  if a < 0 != (b < 0) then 0 - q else q

fn expr_loop(toks: List[Tok], acc: Int, i: Int) -> (Int, Int) ! fail[CalcErr]
= do
  op = tok_op(toks, i)
  if op == "+" then do
      r = parse_term(toks, i + 1)
      expr_loop(toks, acc + r.0, r.1)
    else if op == "-" then do
        r = parse_term(toks, i + 1)
        expr_loop(toks, acc - r.0, r.1)
      else (acc, i)

fn is_digit(ch: Str) -> Bool
= "0123456789".contains(ch)

fn main() -> Unit ! log
= log(show_result("12 + 30 - 2"))

fn num_of(t: Tok) -> Int
= match t
| Num{v} => v
| Op{c} => 0

fn op_of(t: Tok) -> Str
= match t
| Num{v} => "$num"
| Op{c} => c

fn parse_atom(toks: List[Tok], i: Int) -> (Int, Int) ! fail[CalcErr]
= do
  op = tok_op(toks, i)
  if op == "$num" then (tok_num(toks, i), i + 1) else if op == "(" then do
      r = parse_expr(toks, i + 1)
      if tok_op(toks, r.1) != ")" then raise BadSyntax
      (r.0, r.1 + 1)
    else raise BadSyntax

fn parse_expr(toks: List[Tok], i: Int) -> (Int, Int) ! fail[CalcErr]
= do
  r = parse_term(toks, i)
  expr_loop(toks, r.0, r.1)

fn parse_term(toks: List[Tok], i: Int) -> (Int, Int) ! fail[CalcErr]
= do
  r = parse_unary(toks, i)
  term_loop(toks, r.0, r.1)

fn parse_unary(toks: List[Tok], i: Int) -> (Int, Int) ! fail[CalcErr]
= do
  op = tok_op(toks, i)
  if op == "-" then do
      r = parse_unary(toks, i + 1)
      (0 - r.0, r.1)
    else parse_atom(toks, i)

fn show_result(s: Str) -> Str
= catch "{s} = {calc(s)}"
| BadChar{ch} => "{s} = error: bad character {ch}"
| DivByZero => "{s} = error: division by zero"
| BadSyntax => "{s} = error: syntax"

fn term_loop(toks: List[Tok], acc: Int, i: Int) -> (Int, Int) ! fail[CalcErr]
= do
  op = tok_op(toks, i)
  if op == "*" then do
      r = parse_unary(toks, i + 1)
      term_loop(toks, acc * r.0, r.1)
    else if op == "/" then do
        r = parse_unary(toks, i + 1)
        if r.0 == 0 then raise DivByZero
        term_loop(toks, div_trunc(acc, r.0), r.1)
      else (acc, i)

fn tok_num(toks: List[Tok], i: Int) -> Int
= num_of(toks.drop(i).first.or(Op{c: "$end"}))

fn tok_op(toks: List[Tok], i: Int) -> Str
= op_of(toks.drop(i).first.or(Op{c: "$end"}))

fn tokenize(s: Str) -> List[Tok] ! fail[CalcErr]
= do
  var toks = []
  var num = ""
  for ch in s.chars
    if is_digit(ch) then num := num + ch else do
      if not num.is_empty then do
        toks := toks.push(Num{v: num.to_int.or(0)})
        num := ""
      if "+-*/()".contains(ch) then toks := toks.push(Op{c: ch}) else if ch != " " then raise BadChar{ch: ch}
  if not num.is_empty then toks := toks.push(Num{v: num.to_int.or(0)})
  toks

test adds = catch calc("1 + 2 + 3") == 6
| _ => false

test bad_char = catch calc("2 $ 3") == 0
| BadChar{ch} => ch == "$"

test badchar2 = catch calc("2 & 3") == 0
| BadChar{ch} => ch == "&"
| _ => false

test divneg = catch calc("-7 / 2") == -3
| _ => false

test divneg2 = catch calc("7 / -2") == -3
| _ => false

test divtrunc = catch calc("7 / 2") == 3
| _ => false

test divzero = catch calc("1 / (2 - 2)") == 0
| DivByZero => true
| _ => false

test leftassoc = catch calc("100 / 5 / 2 - 2 - 1") == 7
| _ => false

test nested = catch calc("((2 + 3) * (4 - 1))") == 15
| _ => false

test parens = catch calc("(1 + 2) * 3") == 9
| _ => false

test prec = catch calc("2 + 3 * 4") == 14
| _ => false

test prec2 = catch calc("2 * 3 + 4 * 5 - 6 / 2") == 23
| _ => false

test show_div = show_result("1 / 0") == "1 / 0 = error: division by zero"

test show_ok = show_result("2 * 3") == "2 * 3 = 6"

test show_syn = show_result("1 +") == "1 + = error: syntax"

test shown = show_result("7 - 2") == "7 - 2 = 5"

test subtracts = catch calc("10 - 4 - 3") == 3
| _ => false

test syn_close = catch calc("1 + 2)") == 0
| BadSyntax => true
| _ => false

test syn_empty = catch calc("   ") == 0
| BadSyntax => true
| _ => false

test syn_empty_paren = catch calc("()") == 0
| BadSyntax => true
| _ => false

test syn_missing = catch calc("1 +") == 0
| BadSyntax => true
| _ => false

test syn_missing2 = catch calc("* 2") == 0
| BadSyntax => true
| _ => false

test syn_open = catch calc("(1 + 2") == 0
| BadSyntax => true
| _ => false

test syn_two = catch calc("1 2") == 0
| BadSyntax => true
| _ => false

test unary1 = catch calc("-3") == -3
| _ => false

test unary2 = catch calc("2 * -3") == -6
| _ => false

test unary3 = catch calc("-(1 + 2)") == -3
| _ => false

test unary4 = catch calc("2 - -3") == 5
| _ => false
