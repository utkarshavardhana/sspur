fn inorder(t: Tree) -> List[Int]
= match t
  | Leaf => []
  | Node{left, value, right} => inorder(left) + [value] + inorder(right)

fn is_bst(t: Tree) -> Bool
= do
  xs = inorder(t)
  xs.zip(xs.drop(1)).all(p => p.0 < p.1)

test bst_leaf = is_bst(Leaf)
test bst_yes = is_bst(Node{left: Node{left: Leaf, value: 1, right: Leaf}, value: 2, right: Node{left: Leaf, value: 3, right: Leaf}})
test bst_no = not is_bst(Node{left: Node{left: Leaf, value: 3, right: Leaf}, value: 2, right: Leaf})
test bst_dup = not is_bst(Node{left: Node{left: Leaf, value: 2, right: Leaf}, value: 2, right: Leaf})
