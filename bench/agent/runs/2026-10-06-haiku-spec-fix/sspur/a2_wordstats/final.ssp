fn fmt_pair(p: (Str, Int)) -> Str
= "{p.0}={p.1}"

fn longest_word(text: Str) -> Opt[Str]
= do
  words = words_of(text, [])
  if words.is_empty then none else some(words.fold("", (max, w) => if w.len > max.len then w else max))

fn main() -> Unit ! log
= log(summary("The cat and the hat. The end!", []))

fn summary(text: Str, stop: List[Str]) -> Str
= do
  n = words_of(text, stop).len
  d = word_freq(text, stop).len
  "{n} words, {d} distinct, top: {top_line(text, 3, stop)}"

fn top_k(text: Str, k: Int where _ >= 0, stop: List[Str]) -> List[(Str, Int)]
= word_freq(text, stop).sort_with((a, b) => if a.1 != b.1 then b.1 - a.1 else if a.0 < b.0 then -1 else if a.0 > b.0 then 1 else 0).take(k)

fn top_line(text: Str, k: Int where _ >= 0, stop: List[Str]) -> Str
= top_k(text, k, stop).map(fmt_pair).join(" ")

fn word_freq(text: Str, stop: List[Str]) -> List[(Str, Int)]
= words_of(text, stop).counts

fn words_of(text: Str, stop: List[Str]) -> List[Str]
= do
  stop_lower = stop.map(_.lower)
  text.lower.words.filter(w => not stop_lower.contains(w))

test freq_basic = word_freq("a b a", []) == [("a", 2), ("b", 1)]

test longest_word_basic = longest_word("hello world") == some("hello")

test longest_word_empty = longest_word("") == none

test longest_word_single = longest_word("a") == some("a")

test longest_word_tie_first = longest_word("cat dog") == some("cat")

test summary_basic = summary("b a b", []) == "3 words, 2 distinct, top: b=2 a=1"

test summary_with_stop = summary("the cat and the dog", ["the", "and"]) == "2 words, 2 distinct, top: cat=1 dog=1"

test top_k_tie_ordering = top_k("a a b b c", 2, []) == [("a", 2), ("b", 2)]

test top_one = top_k("x y y z", 1, []) == [("y", 2)]

test words_of_stop = words_of("the cat sat on the mat", ["the"]) == ["cat", "sat", "on", "mat"]
