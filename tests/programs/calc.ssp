type Expr = Num{v: Int} | Add{a: Expr, b: Expr} | Mul{a: Expr, b: Expr} | Neg{e: Expr} | Div{a: Expr, b: Expr}
type CalcErr = DivByZero

fn divide(x: Int, y: Int) -> Int ! fail[CalcErr]
= if y == 0 then raise DivByZero else x / y

fn eval(e: Expr) -> Int ! fail[CalcErr]
= match e
  | Num{v} => v
  | Add{a, b} => eval(a) + eval(b)
  | Mul{a, b} => eval(a) * eval(b)
  | Neg{e} => -eval(e)
  | Div{a, b} => divide(eval(a), eval(b))

fn show(e: Expr) -> Str
= match e
  | Num{v} => v.str
  | Add{a, b} => "({show(a)} + {show(b)})"
  | Mul{a, b} => "{show(a)} * {show(b)}"
  | Neg{e} => "-{show(e)}"
  | Div{a, b} => "{show(a)} / {show(b)}"

fn simplify(e: Expr) -> Expr
= match e
  | Add{a: Num{v: 0}, b} => simplify(b)
  | Add{a, b: Num{v: 0}} => simplify(a)
  | Mul{a: Num{v: 1}, b} => simplify(b)
  | Mul{a, b: Num{v: 1}} => simplify(a)
  | Add{a, b} => Add{a: simplify(a), b: simplify(b)}
  | Mul{a, b} => Mul{a: simplify(a), b: simplify(b)}
  | Neg{e} => Neg{e: simplify(e)}
  | Div{a, b} => Div{a: simplify(a), b: simplify(b)}
  | Num{v} => Num{v}

fn run(e: Expr) -> Str
= catch "{show(e)} = {eval(e)}"
  | DivByZero => "{show(e)} = error: division by zero"

fn main() -> Unit ! log
= do
  log(run(Add{a: Num{v: 2}, b: Mul{a: Num{v: 3}, b: Num{v: 4}}}))
  log(run(Div{a: Num{v: 1}, b: Num{v: 0}}))
  log(show(simplify(Add{a: Num{v: 0}, b: Mul{a: Num{v: 1}, b: Num{v: 7}}})))

test eval_ok = run(Add{a: Num{v: 2}, b: Mul{a: Num{v: 3}, b: Num{v: 4}}}) == "(2 + 3 * 4) = 14"
test div_zero = run(Div{a: Num{v: 1}, b: Num{v: 0}}) == "1 / 0 = error: division by zero"
test simplify_ok = show(simplify(Add{a: Num{v: 0}, b: Mul{a: Num{v: 1}, b: Num{v: 7}}})) == "7"
test neg = run(Neg{e: Num{v: 5}}) == "-5 = -5"
