type DepErr = Unknown{name: Str} | Missing{pkg: Str, dep: Str} | Cycle{path: List[Str]} | Stuck{names: List[Str]}

type Pkg = {name: Str, deps: List[Str]}

fn dependents(reg: List[Pkg], name: Str) -> List[Str] ! fail[DepErr]
= do
  find_pkg(reg, name)
  walk(reg, [name], []).filter(n => n != name).sort

fn find_pkg(reg: List[Pkg], name: Str) -> Pkg ! fail[DepErr]
= reg.find(_.name == name).ok_or(Unknown{name: name})

fn full_order(reg: List[Pkg]) -> List[Str] ! fail[DepErr]
= full_step(reg, [])

fn full_step(reg: List[Pkg], done: List[Str]) -> List[Str] ! fail[DepErr]
= do
  rem = reg.map(_.name).sort.filter(n => not done.contains(n))
  if rem.is_empty then done else pick_next(reg, done, rem)

fn install_order(reg: List[Pkg], target: Str) -> List[Str] ! fail[DepErr]
= visit(reg, target, [], [])

fn main() -> Unit ! log
= log(plan(registry(), "app"))

fn pick_next(reg: List[Pkg], done: List[Str], rem: List[Str]) -> List[Str] ! fail[DepErr]
= match rem.find(n => ready(reg, done, n))
| some(n) => full_step(reg, done.push(n))
| none => raise Stuck{names: rem}

fn plan(reg: List[Pkg], target: Str) -> Str
= catch install_order(reg, target).join(" -> ")
| Unknown{name} => "error: unknown package {name}"
| Missing{pkg, dep} => "error: {pkg} needs missing {dep}"
| Cycle{path} => "error: cycle {path.join(" -> ")}"
| Stuck{names} => "error: stuck {names.join(", ")}"

fn ready(reg: List[Pkg], done: List[Str], n: Str) -> Bool
= reg.find(_.name == n).map(p => p.deps.all(d => done.contains(d))).or(false)

fn registry() -> List[Pkg]
= [Pkg{name: "app", deps: ["web", "db"]}, Pkg{name: "web", deps: ["http", "log"]}, Pkg{name: "db", deps: ["log"]}, Pkg{name: "http", deps: []}, Pkg{name: "log", deps: []}]

fn visit(reg: List[Pkg], name: Str, chain: List[Str], done: List[Str]) -> List[Str] ! fail[DepErr]
= do
  if chain.contains(name) then raise Cycle{path: chain.drop(chain.index_of(name).or(0)).push(name)}
  p = find_pkg(reg, name)
  var acc = done
  for d in p.deps
    if reg.find(_.name == d).is_none then raise Missing{pkg: name, dep: d}
    if not acc.contains(d) then acc := visit(reg, d, chain.push(name), acc)
  if acc.contains(name) then acc else acc.push(name)

fn walk(reg: List[Pkg], todo: List[Str], seen: List[Str]) -> List[Str]
= if todo.is_empty then seen else walk_step(reg, todo, seen)

fn walk_step(reg: List[Pkg], todo: List[Str], seen: List[Str]) -> List[Str]
= do
  x = todo[0]
  fresh = reg.filter(p => p.deps.contains(x)).map(_.name).filter(n => not seen.contains(n)).unique
  walk(reg, todo.drop(1).concat(fresh), seen.concat(fresh))

test app_order = catch install_order(registry(), "app") == ["http", "log", "web", "db", "app"]
| _ => false

test cycle3 = catch install_order([Pkg{name: "a", deps: ["b"]}, Pkg{name: "b", deps: ["c"]}, Pkg{name: "c", deps: ["a"]}], "a") == []
| Cycle{path} => path == ["a", "b", "c", "a"]
| _ => false

test cycle_self = catch install_order([Pkg{name: "a", deps: ["a"]}], "a") == []
| Cycle{path} => path == ["a", "a"]
| _ => false

test cycle_tail = catch install_order([Pkg{name: "r", deps: ["a"]}, Pkg{name: "a", deps: ["b"]}, Pkg{name: "b", deps: ["a"]}], "r") == []
| Cycle{path} => path == ["a", "b", "a"]
| _ => false

test db_first_log = catch install_order(registry(), "db") == ["log", "db"]
| _ => false

test deps_none = catch dependents(registry(), "app") == []
| _ => false

test deps_trans = catch dependents(registry(), "log") == ["app", "db", "web"]
| _ => false

test deps_unknown = catch dependents(registry(), "nope") == []
| Unknown{name} => name == "nope"
| _ => false

test full_ok = catch full_order(registry()) == ["http", "log", "db", "web", "app"]
| _ => false

test full_stuck = catch full_order([Pkg{name: "z", deps: []}, Pkg{name: "b", deps: ["c"]}, Pkg{name: "c", deps: ["b"]}]) == []
| Stuck{names} => names == ["b", "c"]
| _ => false

test leaf = catch install_order(registry(), "http") == ["http"]
| _ => false

test missing = catch install_order([Pkg{name: "a", deps: ["x"]}], "a") == []
| Missing{pkg, dep} => pkg == "a" and dep == "x"
| _ => false

test plan_cycle = plan([Pkg{name: "a", deps: ["b"]}, Pkg{name: "b", deps: ["a"]}], "a") == "error: cycle a -> b -> a"

test plan_missing = plan([Pkg{name: "a", deps: ["x"]}], "a") == "error: a needs missing x"

test shared_once = catch install_order([Pkg{name: "a", deps: ["b", "c"]}, Pkg{name: "b", deps: ["d"]}, Pkg{name: "c", deps: ["d"]}, Pkg{name: "d", deps: []}], "a") == ["d", "b", "c", "a"]
| _ => false

test unknown = plan(registry(), "nope") == "error: unknown package nope"
