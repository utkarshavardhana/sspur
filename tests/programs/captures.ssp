fn reads(xs: List[Int]) -> Int
= do
  var k = 1
  for i in 0..3
    k := k * 2
  xs.map(x => x * k).sum

fn reads_live(n: Int) -> Int
= do
  var k = 0
  var s = 0
  for i in 0..n
    k := k + i
    s := s + [1, 2, 3].map(x => x + k).sum
  s

fn k0(i: Int) -> Int = i

fn make_acc(n: Int) -> Int
= do
  var hits = 0
  fn bump(k: Int) -> Int
  = do
    hits := hits + k
    hits
  for i in 0..n
    hits := bump(i) - k0(i)
  hits

test c1 = reads([1, 2, 3]) == 48
test c2 = reads_live(4) == 6 * 4 + 3 * 10 + 0
test c3 = make_acc(5) == 0

fn nest(n: Int) -> Int
= do
  var a = 1
  fn outer(k: Int) -> Int
  = do
    fn inner(j: Int) -> Int
    = do
      a := a + j
      a
    inner(k) * 2
  for i in 0..n
    a := outer(i) - a
  a

fn closure_read(n: Int) -> Int
= do
  var m = 3
  f = x => x * m
  m := 5
  g = apply(f, n)
  m := 7
  g + apply(f, n)

fn apply(f: Int -> Int, x: Int) -> Int = f(x)

fn per_iter(n: Int) -> Int
= do
  var s = 0
  for i in 0..n
    var c = i
    fn bump(k: Int) -> Int
    = do
      c := c + k
      c
    s := s + bump(10) + c
  s

test c5 = nest(4) != 0
test c6 = closure_read(2) == 24
test c7 = per_iter(5) > 0
