fn better(acc: Opt[(Str, Int)], p: (Str, Int)) -> Opt[(Str, Int)]
= match acc
  | none => some(p)
  | some(b) => if p.1 > b.1 then some(p) else acc

fn most_common(xs: List[Str]) -> Opt[Str]
= xs.counts.fold(none, better).map(_.0)

test t20_empty = most_common([]) == none
test t20_basic = most_common(["a", "b", "b", "c"]) == some("b")
test t20_tie = most_common(["x", "y", "y", "x", "z"]) == some("x")
