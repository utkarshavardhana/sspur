= if voucher_value(x) >= 3200 then "large" else if voucher_value(x) >= 800 then "medium" else "small"

fn voucher_count_active(xs: List[Voucher]) -> Int
= xs.filter(_.active).len

fn voucher_deactivate(x: Voucher) -> Voucher
= x with active := false

fn voucher_discounted(x: Voucher, p: Int) -> Voucher
= x with price := x.price - pct(x.price, clamp(p, 0, 100))

fn voucher_find(xs: List[Voucher], id: Int) -> Opt[Voucher]
= xs.find(_.id == id)

fn voucher_gross(x: Voucher) -> Int
= voucher_value(x) + voucher_tax(x)

fn voucher_in_region(xs: List[Voucher], r: Str) -> List[Voucher]
= xs.filter(_.region == r)

fn voucher_label(x: Voucher) -> Str
= label_of(x.name, x.id)

fn voucher_line(x: Voucher) -> Str
= voucher_label(x) + ": " + money(voucher_gross(x))

fn voucher_names(xs: List[Voucher]) -> List[Str]
= xs.map(_.name).sort

fn voucher_new(id: Int, name: Str, qty: Int, price: Int, region: Str) -> Voucher
= Voucher{id: id, name: name, qty: qty, price: price, region: region, active: true}

fn voucher_report(xs: List[Voucher]) -> Str
= join_lines(xs.map(voucher_line))

fn voucher_restock(x: Voucher, n: Int) -> Voucher
= x with qty := x.qty + n

fn voucher_sample() -> List[Voucher]
= [voucher_new(1, "alpha43", 5, 335, "APAC"), voucher_new(2, "beta43", 0, 900, "UK"), voucher_new(3, "gamma43", 8, 118, "US")]

fn voucher_score(x: Voucher) -> Int
= voucher_value(x) / 4 + (if x.active then 1 else 0)

fn voucher_tax(x: Voucher) -> Int
= pct(voucher_value(x), tax_rate(x.region))

fn voucher_top(xs: List[Voucher], n: Int) -> List[Voucher]
= xs.sort_by(x => -voucher_value(x)).take(n)

fn voucher_total(xs: List[Voucher]) -> Int
= xs.map(voucher_gross).sum

fn voucher_valid(x: Voucher) -> Bool
= x.qty >= 0 and x.price >= 0 and not x.name.is_empty

fn voucher_value(x: Voucher) -> Int
= x.qty * x.price

fn warehouse_bucket(x: Warehouse) -> Str
= if warehouse_value(x) >= 2400 then "large" else if warehouse_value(x) >= 600 then "medium" else "small"

fn warehouse_count_active(xs: List[Warehouse]) -> Int
= xs.filter(_.active).len

fn warehouse_deactivate(x: Warehouse) -> Warehouse
= x with active := false

fn warehouse_discounted(x: Warehouse, p: Int) -> Warehouse
= x with price := x.price - pct(x.price, clamp(p, 0, 100))

fn warehouse_find(xs: List[Warehouse], id: Int) -> Opt[Warehouse]
= xs.find(_.id == id)

fn warehouse_gross(x: Warehouse) -> Int
= warehouse_value(x) + warehouse_tax(x)

fn warehouse_in_region(xs: List[Warehouse], r: Str) -> List[Warehouse]
= xs.filter(_.region == r)

fn warehouse_label(x: Warehouse) -> Str
= label_of(x.name, x.id)

fn warehouse_line(x: Warehouse) -> Str
= warehouse_label(x) + ": " + money(warehouse_gross(x))

fn warehouse_names(xs: List[Warehouse]) -> List[Str]
= xs.map(_.name).sort

fn warehouse_new(id: Int, name: Str, qty: Int, price: Int, region: Str) -> Warehouse
= Warehouse{id: id, name: name, qty: qty, price: price, region: region, active: true}

fn warehouse_report(xs: List[Warehouse]) -> Str
= join_lines(xs.map(warehouse_line))

fn warehouse_restock(x: Warehouse, n: Int) -> Warehouse
= x with qty := x.qty + n

fn warehouse_restock_all(ws: List[Warehouse], n: Int) -> List[Warehouse]
= ws.map(w => if w.active then warehouse_restock(w, n) else w)

fn warehouse_sample() -> List[Warehouse]
= [warehouse_new(1, "alpha6", 4, 150, "US"), warehouse_new(2, "beta6", 0, 900, "APAC"), warehouse_new(3, "gamma6", 7, 81, "UK")]

fn warehouse_score(x: Warehouse) -> Int
= warehouse_value(x) / 9 + (if x.active then 1 else 0)

fn warehouse_tax(x: Warehouse) -> Int
= pct(warehouse_value(x), tax_rate(x.region))

fn warehouse_top(xs: List[Warehouse], n: Int) -> List[Warehouse]
= xs.sort_by(x => -warehouse_value(x)).take(n)

fn warehouse_total(xs: List[Warehouse]) -> Int
= xs.map(warehouse_gross).sum

fn warehouse_valid(x: Warehouse) -> Bool
= x.qty >= 0 and x.price >= 0 and not x.name.is_empty

fn warehouse_value(x: Warehouse) -> Int
= x.qty * x.price

