fn draws(seed: Int, n: Int, f: Int -> (Int, Int)) -> List[Int]
= (0..n).fold(([], seed), (acc, k) => do
    (v, s) = f(acc.1)
    (acc.0.push(v), s)).0

fn fdraws(seed: Int, n: Int, f: Int -> (F64, Int)) -> List[F64]
= (0..n).fold(([], seed), (acc, k) => do
    (v, s) = f(acc.1)
    (acc.0.push(v), s)).0

fn mean(xs: List[Int]) -> F64
= xs.sum.to_f64 / xs.len.to_f64

fn fmean(xs: List[F64]) -> F64
= xs.sum / xs.len.to_f64

fn fvar(xs: List[F64]) -> F64
= do
  m = fmean(xs)
  xs.map(x => (x - m) * (x - m)).sum / xs.len.to_f64

fn binomials(seed: Int, k: Int, n: Int, p: F64) -> List[Int]
= draws(seed, k, s => rand_binomial(s, n, p))

fn poissons(seed: Int, k: Int, mu: F64) -> List[Int]
= draws(seed, k, s => rand_poisson(s, mu))

fn geometrics(seed: Int, k: Int, p: F64) -> List[Int]
= draws(seed, k, s => rand_geometric(s, p))

fn gammas(seed: Int, k: Int, shape: F64, scale: F64) -> List[F64]
= fdraws(seed, k, s => rand_gamma(s, shape, scale))

fn betas(seed: Int, k: Int, a: F64, b: F64) -> List[F64]
= fdraws(seed, k, s => rand_beta(s, a, b))

fn picks(seed: Int, k: Int, ws: List[F64]) -> List[Int]
= draws(seed, k, s => rand_weighted(s, ws))

fn one_binomial(seed: Int, n: Int, p: F64) -> (Int, Int)
= rand_binomial(seed, n, p)

fn one_poisson(seed: Int, mu: F64) -> (Int, Int)
= rand_poisson(seed, mu)

fn one_geometric(seed: Int, p: F64) -> (Int, Int)
= rand_geometric(seed, p)

fn one_gamma(seed: Int, shape: F64, scale: F64) -> (F64, Int)
= rand_gamma(seed, shape, scale)

fn one_beta(seed: Int, a: F64, b: F64) -> (F64, Int)
= rand_beta(seed, a, b)

fn one_weighted(seed: Int, ws: List[F64]) -> (Int, Int)
= rand_weighted(seed, ws)

fn rolls(r: Rng, n: Int) -> (List[Int], Rng)
= (0..n).fold(([], r), (acc, k) => do
    (v, q) = acc.1.int(1, 7)
    (acc.0.push(v), q))

fn mixed(r: Rng) -> (List[F64], Rng)
= do
  (a, r1) = r.f64
  (b, r2) = r1.normal(0.0, 1.0)
  (c, r3) = r2.gamma(2.0, 1.5)
  (d, r4) = r3.beta(2.0, 3.0)
  (e, r5) = r4.uniform(-1.0, 1.0)
  (f, r6) = r5.exp(3.0)
  (g, r7) = r6.poisson(4.5)
  (h, r8) = r7.binomial(40, 0.25)
  (i, r9) = r8.geometric(0.2)
  (j, r10) = r9.weighted([1.0, 0.0, 2.0])
  (k, r11) = r10.bool(0.5)
  (l, r12) = r11.next
  ([a, b, c, d, e, f, g.to_f64, h.to_f64, i.to_f64, j.to_f64, if k then 1.0 else 0.0, (l % 1000).to_f64], r12)

fn streams(r: Rng, n: Int) -> List[Int]
= (0..n).map(k => r.stream(k).int(0, 1000000).0)

fn split_draws(r: Rng) -> (Int, Int, Int)
= do
  (a, b) = r.split
  (x, _) = a.int(0, 1000000)
  (y, _) = b.int(0, 1000000)
  (z, _) = r.int(0, 1000000)
  (x, y, z)

test binomial_moments = do
  xs = binomials(7, 3000, 50, 0.3)
  (mean(xs) - 15.0).abs < 0.3 and xs.all(x => x >= 0 and x <= 50)
test binomial_large = do
  xs = binomials(8, 400, 1000000, 0.4)
  (mean(xs) - 400000.0).abs < 100.0 and xs.all(x => x >= 0 and x <= 1000000)
test binomial_edges = binomials(1, 20, 30, 0.0).all(_ == 0) and binomials(1, 20, 30, 1.0).all(_ == 30) and binomials(1, 5, 0, 0.5).all(_ == 0)
test poisson_small = (mean(poissons(3, 4000, 3.5)) - 3.5).abs < 0.1
test poisson_large = (mean(poissons(4, 2000, 250.0)) - 250.0).abs < 1.5 and (mean(poissons(4, 300, 1000000.0)) - 1000000.0).abs < 150.0
test poisson_zero = poissons(4, 10, 0.0).all(_ == 0)
test geometric_mean = (mean(geometrics(5, 4000, 0.25)) - 3.0).abs < 0.2 and geometrics(5, 10, 1.0).all(_ == 0)
test gamma_moments = do
  xs = gammas(6, 4000, 3.0, 2.0)
  (fmean(xs) - 6.0).abs < 0.2 and (fvar(xs) - 12.0).abs < 1.2 and xs.all(_ > 0.0)
test gamma_small_shape = (fmean(gammas(9, 4000, 0.5, 1.0)) - 0.5).abs < 0.05
test beta_mean = do
  xs = betas(10, 4000, 2.0, 5.0)
  (fmean(xs) - 2.0 / 7.0).abs < 0.01 and xs.all(x => x >= 0.0 and x <= 1.0)
test weighted_rates = do
  xs = picks(12, 6000, [1.0, 0.0, 3.0])
  xs.all(_ != 1) and (xs.filter(_ == 2).len - 4500).abs < 150
test pure = one_poisson(1, 2.0) == one_poisson(1, 2.0) and one_gamma(2, 1.0, 1.0).1 != 2
test rng_matches_seed_fns = rng(5).int(0, 10).0 == rand_int(5, 0, 10).0 and rng(5).f64.0 == rand_f64(5).0 and rng(5).poisson(9.0).0 == rand_poisson(5, 9.0).0
test rng_dice = do
  (xs, r) = rolls(rng(1), 6000)
  xs.all(x => x >= 1 and x <= 6) and xs.to_set.len == 6 and (mean(xs) - 3.5).abs < 0.1 and r != rng(1)
test rng_mixed = mixed(rng(77)).0 == mixed(rng(77)).0 and mixed(rng(77)).0 != mixed(rng(78)).0
test rng_streams = do
  xs = streams(rng(3), 50)
  xs.to_set.len == 50 and streams(rng(3), 50) == xs
test rng_split = do
  (x, y, z) = split_draws(rng(9))
  x != y and y != z and split_draws(rng(9)) == (x, y, z)
test rng_show = "{rng(1)}" == "Rng\{state: 1, gamma: -7046029254386353131}"
