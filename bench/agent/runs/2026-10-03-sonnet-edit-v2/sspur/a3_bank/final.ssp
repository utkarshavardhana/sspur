type Account = {id: Str, owner: Str, balance: Int where _ >= 0, frozen: Bool}

type BankErr = Insufficient{id: Str, needed: Int, available: Int} | SameAccount | UnknownAccount{id: Str} | Frozen{id: Str}

fn accounts() -> List[Account]
= [Account{id: "a1", owner: "alice", balance: 100, frozen: false}, Account{id: "b1", owner: "bob", balance: 20, frozen: false}, Account{id: "c1", owner: "carol", balance: 0, frozen: false}]

fn attempt(bank: List[Account], from: Str, to: Str, amount: Int where _ > 0) -> Str
= catch transfer(bank, from, to, amount).map(describe).join(", ")
| Insufficient{id, needed, available} => "declined: {id} needs {needed}, has {available}"
| SameAccount => "declined: same account"
| UnknownAccount{id} => "declined: no account {id}"
| Frozen{id} => "declined: {id} is frozen"

fn deposit(bank: List[Account], id: Str, amount: Int where _ > 0) -> List[Account] ! fail[BankErr]
= do
  a = lookup(bank, id)
  if a.frozen then raise Frozen{id: id} else set_balance(bank, id, a.balance + amount)

fn describe(a: Account) -> Str
= "{a.owner}: {a.balance}"

fn freeze(bank: List[Account], id: Str) -> List[Account] ! fail[BankErr]
= do
  a = lookup(bank, id)
  bank.map(x => if x.id == id then x with frozen := true else x)

fn lookup(bank: List[Account], id: Str) -> Account ! fail[BankErr]
= bank.find(_.id == id).ok_or(UnknownAccount{id: id})

fn main() -> Unit ! log
= do
  log(attempt(accounts(), "a1", "b1", 60))
  log(attempt(accounts(), "b1", "a1", 50))

fn open_account(bank: List[Account], id: Str, owner: Str) -> List[Account]
= bank.push(Account{id: id, owner: owner, balance: 0, frozen: false})

fn set_balance(bank: List[Account], id: Str, b: Int where _ >= 0) -> List[Account]
= bank.map(a => if a.id == id then a with balance := b else a)

fn transfer(bank: List[Account], from: Str, to: Str, amount: Int where _ > 0) -> List[Account] ! fail[BankErr]
= if from == to then raise SameAccount else deposit(withdraw(bank, from, if amount < 50 then amount + 1 else amount), to, amount)

fn withdraw(bank: List[Account], id: Str, amount: Int where _ > 0) -> List[Account] ! fail[BankErr]
= do
  a = lookup(bank, id)
  if a.frozen then raise Frozen{id: id} else if amount > a.balance then raise Insufficient{id: id, needed: amount, available: a.balance} else set_balance(bank, id, a.balance - amount)

test big_transfer = attempt(accounts(), "a1", "b1", 60) == "alice: 40, bob: 80, carol: 0"

test declined = attempt(accounts(), "b1", "a1", 50) == "declined: b1 needs 50, has 20"

test fee_insufficient = attempt(accounts(), "b1", "a1", 20) == "declined: b1 needs 21, has 20"

test fee_none_at_50 = attempt(accounts(), "a1", "b1", 50) == "alice: 50, bob: 70, carol: 0"

test fee_small = attempt(accounts(), "a1", "b1", 10) == "alice: 89, bob: 30, carol: 0"

test freeze_ok = freeze(accounts(), "b1").map(_.frozen) == [false, true, false]

test freeze_unknown = catch freeze(accounts(), "zz") == []
| UnknownAccount{id} => id == "zz"
| _ => false

test frozen_before_balance = attempt(freeze(accounts(), "c1"), "c1", "a1", 5) == "declined: c1 is frozen"

test frozen_recipient = attempt(freeze(accounts(), "b1"), "a1", "b1", 5) == "declined: b1 is frozen"

test frozen_sender = attempt(freeze(accounts(), "a1"), "a1", "b1", 5) == "declined: a1 is frozen"

test opened = open_account(accounts(), "d1", "dan").map(describe).last == some("dan: 0")

test opened_unfrozen = open_account(accounts(), "d1", "dan").last.map(_.frozen) == some(false)

test unknown = attempt(accounts(), "a1", "zz", 5) == "declined: no account zz"
