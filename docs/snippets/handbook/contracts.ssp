// ANCHOR: contract
fn find_slot(sorted: List[Int], x: Int, lo: Int, hi: Int) -> Int
  pre 0 <= lo and lo <= hi and hi <= sorted.len
  post r >= lo and r <= hi
= if lo >= hi then lo else do
  m = (lo + hi) / 2
  if sorted[m] < x then find_slot(sorted, x, m + 1, hi) else find_slot(sorted, x, lo, m)
// ANCHOR_END: contract

// ANCHOR: avg
fn average(total: Int, n: Int where _ > 0) -> Int
  post r * n <= total
= total / n
// ANCHOR_END: avg

// ANCHOR: tests
fn slot(sorted: List[Int], x: Int) -> Int
  ex slot([1, 3, 5], 4) == 2
  ex slot([], 7) == 0
= find_slot(sorted, x, 0, sorted.len)

test slot_front = slot([10, 20], 5) == 0
test slot_back = slot([10, 20], 25) == 2
// ANCHOR_END: tests
