fn area(s: Shape) -> F64
= match s
  | Circle{r} => 3.14159 * r * r
  | Rect{w, h} => w * h
  | Square{s} => s * s

fn largest_area(xs: List[Shape]) -> Opt[Shape]
= xs.fold(none, (best, shape) =>
    match best
    | none => some(shape)
    | some(b) => if area(shape) > area(b) then some(shape) else some(b)
  )
