fn light_idx(l: Light) -> Int
= match l
  | Green => 0
  | Yellow => 1
  | Red => 2

fn after(l: Light, n: Int) -> Light
  pre n >= 0
= match (light_idx(l) + n % 3) % 3
  | 0 => Green
  | 1 => Yellow
  | _ => Red

test after_zero = after(Red, 0) == Red
test after_green = after(Green, 1) == Yellow
test after_red = after(Red, 1) == Green
test after_many = after(Yellow, 5) == Green
