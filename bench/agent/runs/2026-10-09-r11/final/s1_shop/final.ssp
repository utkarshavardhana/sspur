= join_lines(xs.map(payslip_line))

fn payslip_restock(x: Payslip, n: Int) -> Payslip
= x with qty := x.qty + n

fn payslip_sample() -> List[Payslip]
= [payslip_new(1, "alpha11", 5, 175, "UK"), payslip_new(2, "beta11", 0, 900, "US"), payslip_new(3, "gamma11", 9, 86, "APAC")]

fn payslip_score(x: Payslip) -> Int
= payslip_value(x) / 7 + (if x.active then 1 else 0)

fn payslip_tax(x: Payslip) -> Int
= pct(payslip_value(x), tax_rate(x.region))

fn payslip_top(xs: List[Payslip], n: Int) -> List[Payslip]
= xs.sort_by(x => -payslip_value(x)).take(n)

fn payslip_total(xs: List[Payslip]) -> Int
= xs.map(payslip_gross).sum

fn payslip_valid(x: Payslip) -> Bool
= x.qty >= 0 and x.price >= 0 and not x.name.is_empty

fn payslip_value(x: Payslip) -> Int
= x.qty * x.price

fn pct(amount: Int, p: Int) -> Int
= amount * p / 100

