// Local functions in one block are emitted together. When a later function captured a variable declared after the first one, native code could not see it and the function fell back to the interpreter.

fn later_var(a: Int) -> Int
= do
  var acc = a
  fn g(k: Int) -> Int
  = acc + k
  var v = acc * 2
  fn h(k: Int) -> Int
  = do
    v := v + k
    v
  h(1) + g(2) + h(3)

fn later_let(a: Int) -> Int
= do
  fn g(k: Int) -> Int
  = k + 1
  x = a % 100
  fn h(k: Int) -> Int
  = x * k
  g(h(3))

fn shadowed(a: Int) -> Int
= do
  x = 1
  fn g(k: Int) -> Int
  = x + k
  x = 5
  fn h(k: Int) -> Int
  = k * 2
  g(0) * 10 + h(x)

test captured = later_var(1) == 3 + 3 + 6 and later_let(4) == 13 and shadowed(0) == 20
