// interp-ok: p131_eff and p135_eff perform an operation. Before the fix, clang -O3 fully unrolled the counted UTF-8 loop of Str.get(30) inside p131_main and spent minutes in scalar evolution
type P131R = {a: Int, b: Int where _ != 0}
type P131S = P131A{x: Int} | P131B{x: Int, y: Int} | P131C
type P131T = P131Lf | P131Nd{l: P131T, v: Int, r: P131T}
type P131E = P131Bad{c: Int} | P131Worse
type P131G[T] = P131Nil | P131Cons{h: T, t: P131G[T]}
type P131P[A, B] = {fst: A, snd: B}
res type P131Rs = {id: Int, v: Int} drop p131_rdrop
effect p131ask(x: Int) -> Int

fn p131_ins(t: P131T, x: Int) -> P131T
= match t
  | P131Lf => P131Nd{l: P131Lf, v: x, r: P131Lf}
  | P131Nd{l, v, r} => if x <= v then P131Nd{l: p131_ins(l, x), v: v, r: r} else P131Nd{l: l, v: v, r: p131_ins(r, x)}

fn p131_inc(t: P131T, d: Int) -> P131T
= match t
  | P131Lf => P131Lf
  | P131Nd{l, v, r} => P131Nd{l: p131_inc(l, d), v: v * d, r: p131_inc(r, d)}

fn p131_tsum(t: P131T) -> Int
= match t
  | P131Lf => 0
  | P131Nd{l, v, r} => p131_tsum(l) + v + p131_tsum(r)

fn p131_items(t: P131T) -> List[Int]
= match t
  | P131Lf => []
  | P131Nd{l, v, r} => p131_items(l) + [v] + p131_items(r)

fn p131_build(xs: List[Int]) -> P131T
= do
  var t = P131Lf
  for x in xs
    t := p131_ins(t, x)
  t

fn p131_mkmap(xs: List[Int]) -> Map[Int, Int]
= xs.fold(empty_map(), (m, x) => m.put(x % 7, m.get(x % 7).or(0) + x))

fn p131_mkhm(xs: List[Int]) -> HashMap[Str, Int]
= xs.fold(hash_map(), (m, x) => m.put("k{x % 5}", x))

fn p131_gfrom[T](xs: List[T]) -> P131G[T]
= xs.reverse.fold(P131Nil, (acc, x) => P131Cons{h: x, t: acc})

fn p131_gto[T](g: P131G[T]) -> List[T]
= match g
  | P131Nil => []
  | P131Cons{h, t} => [h] + p131_gto(t)

fn p131_glen[T](g: P131G[T]) -> Int
= match g
  | P131Nil => 0
  | P131Cons{t} => 1 + p131_glen(t)

fn p131_gmap[A, B](g: P131G[A], f: A -> B) -> P131G[B]
= match g
  | P131Nil => P131Nil
  | P131Cons{h, t} => P131Cons{h: f(h), t: p131_gmap(t, f)}

fn p131_gnth[T](g: P131G[T], k: Int, d: T) -> T
= match g
  | P131Nil => d
  | P131Cons{h, t} => if k <= 0 then h else p131_gnth(t, k - 1, d)

fn p131_swap[A, B](q: P131P[A, B]) -> P131P[B, A]
= P131P{fst: q.snd, snd: q.fst}

fn p131_pick[T](b: Bool, x: T, y: T) -> T
= if b then x else y

fn p131_gapp[A, e](x: A, f: A -> A ! e) -> A ! e
= f(f(x))

fn p131_lg(a: Int) -> Int ! log
= do
  log("lg {a}")
  a * 2 + 1

fn p131_fl(x: F64, k: Int) -> F64
= if k <= 0 then x else p131_fl(x - x * 0.25, k - 1)

fn p131_rdrop(r: P131Rs) -> Unit ! log
= log("drop {r.id} {r.v}")

fn p131_rmk(id: Int, v: Int) -> P131Rs
= P131Rs{id: id, v: v}

fn p131_rbump(r: &mut P131Rs, d: Int)
= do
  r.v := r.v + d
  ()

fn p131_rget(r: &P131Rs) -> Int
= r.v * 2 + r.id

fn p131_rtake(r: P131Rs) -> Int ! log
= r.v + r.id

fn p131_risky(a: Int) -> Int ! fail[P131E]
= if a % 5 == 0 then raise P131Bad{c: a} else if a % 5 == 1 then raise P131Worse else 538.abs

fn p131_eff(a: Int) -> Int ! p131ask
= p131ask(a) + p131ask(a)

fn p131_rec1(n: Int, acc: Int) -> Int
= if n == 0 then [2].index_of(n).or(-1) else p131_rec1(n / 2, [3].max.or(0).wrapping_mul((-(n))))

fn p131_tr3(t: P131T, k: Int) -> P131T
= match t
