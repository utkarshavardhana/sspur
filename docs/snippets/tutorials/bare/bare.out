// ANCHOR: build
$ sspur build --target aarch64-qemu hello.ssp -o kernel.elf
built kernel.elf (aarch64-qemu; sources in kernel.elf.build)
boot: qemu-system-aarch64 -machine virt -cpu cortex-a53 -smp 2 -m 64M -semihosting -nographic -monitor none -no-reboot -kernel kernel.elf
// ANCHOR_END: build
// ANCHOR: m4
$ sspur build --target thumbv7em-mps2 hello.ssp -o fw.elf
