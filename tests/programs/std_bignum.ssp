type Line = {item: Str, qty: Int, price: Dec}

fn factorial(n: Int) -> BigInt
= (1..n + 1).fold(big(1), (acc, k) => acc.mul(big(k)))

fn fib(n: Int) -> BigInt ! div
= do
  var a = big(0)
  var b = big(1)
  var i = 0
  while i < n
    t = a.add(b)
    a := b
    b := t
    i := i + 1
  a

fn digit_sum(x: BigInt) -> Int
= x.str.chars.map(c => c.to_int.or(0)).sum

fn modpow(b: BigInt, e: Int, m: BigInt) -> BigInt ! div
= do
  var result = big(1)
  var base = b.rem(m)
  var k = e
  while k > 0
    if k % 2 == 1 then result := result.mul(base).rem(m)
    base := base.mul(base).rem(m)
    k := k / 2
  result

fn total(lines: List[Line]) -> Dec
= lines.fold(decimal("0").get, (acc, l) => acc.add(l.price.mul(big(l.qty).to_dec)))

fn with_tax(amount: Dec, rate: Str) -> Dec
= amount.add(amount.mul(decimal(rate).get)).round(2)

fn split_bill(amount: Dec, people: Int) -> Dec
= amount.div(big(people).to_dec, 2)

fn arith(a: BigInt, b: BigInt) -> List[Str]
= [a.add(b).str, a.sub(b).str, a.mul(b).str, a.neg.str, a.abs.str, a.sign.str]

fn division(a: BigInt, b: BigInt) -> (BigInt, BigInt)
= a.divmod(b)

fn powers(a: BigInt, e: Int) -> BigInt
= a.pow(e.abs % 40)

fn dec_ops(a: Dec, b: Dec) -> List[Str]
= [a.add(b).str, a.sub(b).str, a.mul(b).str, a.round(1).str, a.round(4).str, a.neg.str, a.scale.str]

fn dec_div(a: Dec, b: Dec, k: Int) -> Dec
= a.div(b, k.abs % 12)

fn parsed(s: Str) -> List[Str]
= [parse_big(s).map(_.str).or("none"), decimal(s).map(_.str).or("none")]

fn conversions(x: BigInt) -> (Opt[Int], F64, Str)
= (x.to_int, x.to_f64, json.encode([x]))

test fact = factorial(25).str == "15511210043330985984000000" and digit_sum(factorial(100)) == 648
test fibonacci = fib(100).str == "354224848179261915075" and fib(1) == big(1)
test rsa_like = modpow(big(4), 13, big(497)) == big(445) and modpow(parse_big("123456789012345678901234567890").get, 65537, parse_big("1000000007").get).str == "921051386"
test divide = division(parse_big("-100000000000000000000007").get, big(10)) == (parse_big("-10000000000000000000000").get, big(-7)) and division(big(7), big(-2)) == (big(-3), big(1))
test big_division = factorial(30).div(factorial(28)) == big(870) and factorial(40).rem(factorial(20).add(big(1))).sign == 1 and factorial(50).divmod(factorial(25).add(big(7))).0.mul(factorial(25).add(big(7))).add(factorial(50).divmod(factorial(25).add(big(7))).1) == factorial(50)
test pow_values = big(2).pow(100).str == "1267650600228229401496703205376" and big(-3).pow(3) == big(-27) and big(-1).pow(10) == big(1) and big(0).pow(0) == big(1)
test ints = big(9223372036854775807).to_int == some(9223372036854775807) and big(-9223372036854775807 - 1).to_int == some(-9223372036854775807 - 1) and big(9223372036854775807).add(big(1)).to_int == none
test order = big(-5) < big(3) and factorial(30) > factorial(29) and [big(3), big(-10), big(0)].sort == [big(-10), big(0), big(3)]
test parsing = parsed(" -00123 ") == ["-123", "-123"] and parsed("12.50") == ["none", "12.50"] and parsed("1e5") == ["none", "none"] and parsed("+7") == ["7", "7"] and parsed(".5") == ["none", "none"] and parsed("5.") == ["none", "none"]
test invoice = total([Line{item: "pen", qty: 3, price: decimal("1.25").get}, Line{item: "pad", qty: 2, price: decimal("0.10").get}]).str == "3.95"
test taxes = with_tax(decimal("19.99").get, "0.0825").str == "21.64" and with_tax(decimal("100").get, "0.07").str == "107.00"
test bankers = [decimal("2.5").get.round(0).str, decimal("3.5").get.round(0).str, decimal("-2.5").get.round(0).str, decimal("2.51").get.round(0).str, decimal("0.125").get.round(2).str] == ["2", "4", "-2", "3", "0.12"]
test split = split_bill(decimal("100.00").get, 3).str == "33.33" and decimal("1").get.div(decimal("8").get, 3).str == "0.125" and decimal("-7").get.div(decimal("2").get, 0).str == "-4"
test dec_compare = decimal("1.50").get != decimal("1.5").get and decimal("1.5").get < decimal("1.50").get and decimal("0.3").get > decimal("0.29").get and decimal("-0.001").get.sign == -1
test small_values = decimal("0.05").get.str == "0.05" and decimal("-0.05").get.mul(decimal("2").get).str == "-0.10" and decimal("123").get.scale == 0
test floats = big(10).pow(30).to_f64 == 1.0e30 and decimal("0.1").get.to_f64 == 0.1 and conversions(big(5)).2 == "[5]"
test json_forms = json.decode[BigInt]("123456789012345678901234567890") == ok(parse_big("123456789012345678901234567890").get) and json.encode(decimal("1.20").get) == "\"1.20\"" and json.decode[Dec]("\"1.20\"") == ok(decimal("1.20").get) and json.decode[Dec]("2.5") == ok(decimal("2.5").get) and json.decode[BigInt]("1.5").is_err
test fuzz_shapes = arith(big(3), big(4)).len == 6 and powers(big(2), 3) == big(8) and dec_ops(decimal("1.25").get, decimal("2").get).len == 7 and dec_div(decimal("1").get, decimal("3").get, 4).str == "0.3333"

fn knuth(a: BigInt, b: BigInt, c: BigInt) -> Str
= do
  n = a.mul(b).mul(c).add(a)
  d = b.mul(c).add(big(3))
  (q, r) = n.divmod(d)
  "{q} {r} {q.mul(d).add(r) == n}"

test knuth_ok = knuth(big(5), big(7), big(9)).ends_with("true")
