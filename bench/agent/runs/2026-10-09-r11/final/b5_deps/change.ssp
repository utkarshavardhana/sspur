type DepErr = Unknown{name: Str} | Missing{pkg: Str, dep: Str} | Cycle{path: List[Str]} | Stuck{names: List[Str]}

fn install_order(reg: List[Pkg], target: Str) -> List[Str] ! fail[DepErr]
= visit(reg, target, [], [])

fn visit(reg: List[Pkg], name: Str, chain: List[Str], done: List[Str]) -> List[Str] ! fail[DepErr]
= if done.contains(name) then done else visit_new(reg, name, chain, done)

fn visit_new(reg: List[Pkg], name: Str, chain: List[Str], done: List[Str]) -> List[Str] ! fail[DepErr]
= do
  p = find_pkg(reg, name)
  if chain.contains(name) then raise Cycle{path: chain.drop(chain.index_of(name).get).push(name)}
  var acc = done
  for d in p.deps
    if reg.any(_.name == d) == false then raise Missing{pkg: name, dep: d}
    acc := visit(reg, d, chain.push(name), acc)
  acc.push(name)

fn plan(reg: List[Pkg], target: Str) -> Str
= catch install_order(reg, target).join(" -> ")
| Unknown{name} => "error: unknown package {name}"
| Missing{pkg, dep} => "error: {pkg} needs missing {dep}"
| Cycle{path} => "error: cycle {path.join(" -> ")}"
| Stuck{names} => "error: stuck {names.join(", ")}"

fn full_order(reg: List[Pkg]) -> List[Str] ! fail[DepErr]
= full_step(reg, [])

fn full_step(reg: List[Pkg], installed: List[Str]) -> List[Str] ! fail[DepErr]
= do
  remaining = reg.filter(p => installed.contains(p.name) == false)
  ready = remaining.filter(p => p.deps.all(d => installed.contains(d))).map(_.name).sort
  if remaining.len == 0 then installed else full_next(reg, installed, remaining.map(_.name).sort, ready)

fn full_next(reg: List[Pkg], installed: List[Str], remaining: List[Str], ready: List[Str]) -> List[Str] ! fail[DepErr]
= if ready.len == 0 then raise Stuck{names: remaining} else full_step(reg, installed.push(ready.first.get))

fn dependents(reg: List[Pkg], name: Str) -> List[Str] ! fail[DepErr]
= do
  find_pkg(reg, name)
  dep_closure(reg, [name]).filter(_ != name).sort

fn dep_closure(reg: List[Pkg], found: List[Str]) -> List[Str]
= do
  next = reg.filter(p => found.contains(p.name) == false && p.deps.any(d => found.contains(d))).map(_.name).unique
  if next.len == 0 then found else dep_closure(reg, next.fold(found, (a, x) => a.push(x)))

fn dreg() -> List[Pkg]
= [Pkg{name: "app", deps: ["web", "db"]}, Pkg{name: "web", deps: ["http", "log"]}, Pkg{name: "db", deps: ["log"]}, Pkg{name: "http", deps: []}, Pkg{name: "log", deps: []}]

test dedup = catch install_order(dreg(), "app") == ["http", "log", "web", "db", "app"]
| _ => false

test missing = catch install_order([Pkg{name: "a", deps: ["x"]}], "a") == []
| Missing{pkg, dep} => pkg == "a" && dep == "x"
| _ => false

test unknown_target = catch install_order(dreg(), "zz") == []
| Unknown{name} => name == "zz"
| _ => false

test cycle3 = catch install_order([Pkg{name: "a", deps: ["b"]}, Pkg{name: "b", deps: ["c"]}, Pkg{name: "c", deps: ["a"]}], "a") == []
| Cycle{path} => path == ["a", "b", "c", "a"]
| _ => false

test cycle_mid = catch install_order([Pkg{name: "r", deps: ["a"]}, Pkg{name: "a", deps: ["b"]}, Pkg{name: "b", deps: ["a"]}], "r") == []
| Cycle{path} => path == ["a", "b", "a"]
| _ => false

test cycle_self = catch install_order([Pkg{name: "a", deps: ["a"]}], "a") == []
| Cycle{path} => path == ["a", "a"]
| _ => false

test plan_missing = plan([Pkg{name: "a", deps: ["x"]}], "a") == "error: a needs missing x"

test plan_cycle = plan([Pkg{name: "a", deps: ["b"]}, Pkg{name: "b", deps: ["a"]}], "a") == "error: cycle a -> b -> a"

test full_ok = catch full_order(dreg()) == ["http", "log", "db", "web", "app"]
| _ => false

test full_stuck = catch full_order([Pkg{name: "z", deps: []}, Pkg{name: "b", deps: ["a"]}, Pkg{name: "a", deps: ["b"]}]) == []
| Stuck{names} => names == ["a", "b"]
| _ => false

test dependents_log = catch dependents(dreg(), "log") == ["app", "db", "web"]
| _ => false

test dependents_none = catch dependents(dreg(), "app") == []
| _ => false

test dependents_unknown = catch dependents(dreg(), "q") == []
| Unknown{name} => name == "q"
| _ => false
