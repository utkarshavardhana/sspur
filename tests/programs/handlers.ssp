type Tree = Leaf | Node{left: Tree, value: Int, right: Tree}

effect ask() -> Int
effect tell(k: Str, v: Int)
effect pick(a: Int, b: Int) -> Int

fn walk(t: Tree) -> Unit ! yield[Int]
= match t
  | Leaf => ()
  | Node{left, value, right} => do
    walk(left)
    yield(value)
    walk(right)

fn each[T](xs: List[T]) -> Unit ! yield[T]
= do
  for x in xs
    yield(x)

fn evens_of(t: Tree) -> Unit ! yield[Int]
= do
  for v in walk(t)
    if v % 2 == 0 then yield(v * 10)

fn build(xs: List[Int]) -> Tree
= xs.fold(Leaf, (t, x) => Node{left: t, value: x, right: Leaf})

fn sum_evens(xs: List[Int]) -> Int
= do
  var s = 0
  for v in evens_of(build(xs))
    s := s + v
  s

fn pairs(xs: List[Int]) -> List[(Int, Str)]
= do
  var out = []
  for (i, s) in each(xs.enumerate.map(p => (p.0, "s{p.1}")))
    out := out.push((i, s))
  out

fn somes(xs: List[Opt[Int]]) -> Int
= do
  var n = 0
  for some(x) in each(xs)
    n := n + x
  n

fn asker(n: Int) -> Int ! ask, tell
= do
  a = ask()
  tell("a", a)
  b = ask() * n
  tell("b", b)
  a + b

fn layered(n: Int) -> (Int, List[Str])
= do
  var log2 = []
  var k = 0
  r = handle handle asker(n) + ask()
      | ask() => do
        k := k + 1
        resume(k * 100 + ask())
    | ask() => resume(7)
    | tell(key, v) => do
      log2 := log2.push("{key}={v}")
      resume()
  (r, log2)

fn args_order() -> Int
= handle pick(1, 2) * 10 + pick(3, 4)
  | pick(b, a) => resume(a - b)

fn with_ret(n: Int) -> Str
= handle asker(n)
  | ask() => resume(n)
  | tell(_, _) => resume()
  | return(r) => "got {r}"

fn inner_gen(n: Int) -> Int
= do
  var total = 0
  for x in each([1, 2, 3])
    for y in each([10, 20])
      total := total + x * y + n
  total

fn local_gen() -> List[Int]
= do
  var out = []
  for x in do
      yield(1)
      yield(2)
      for z in each([3, 4])
        yield(z * 2)
    out := out.push(x)
  out

fn shadow(n: Int) -> Int
= do
  x = 5
  handle do
      x = 100
      ask() + x
    | ask() => resume(x + n)

test a = sum_evens([1, 2, 3, 4]) == 60
test b = pairs([7, 8]) == [(0, "s7"), (1, "s8")]
test c = somes([some(1), none, some(5)]) == 6
test d = layered(2) == (828, ["a=107", "b=414"])
test e = args_order() == 11
test f = with_ret(3) == "got 12"
test g = inner_gen(1) == 186
test h = local_gen() == [1, 2, 6, 8]
test i = shadow(1) == 106
