rename subtotal gross
rename subtotal_sample gross_sample

fn discount(o: Order) -> Int
= if o.coupon == "SAVE10" then gross(o) * 10 / 100 else if o.coupon == "BIG20" and gross(o) >= 10000 then gross(o) * 20 / 100 else 0

fn net(o: Order) -> Int
= gross(o) - discount(o)

fn shipping(o: Order) -> Int
= if net(o) >= 5000 or o.coupon == "FREESHIP" then 0 else 499

fn tax(o: Order) -> Int
= net(o) * 8 / 100

fn total(o: Order) -> Int
= net(o) + shipping(o) + tax(o)

fn invoice(o: Order) -> Str
= "order {o.id}: gross {money(gross(o))}, discount {money(discount(o))}, shipping {money(shipping(o))}, tax {money(tax(o))}, total {money(total(o))}"

fn order_with(c: Str, unit: Int) -> Order
= Order{id: 1, lines: [Line{sku: "x", qty: 1, unit: unit}], coupon: c}

test invoice_sample = invoice(sample_order()) == "order 7: gross 31.50, discount 0.00, shipping 4.99, tax 2.52, total 39.01"

test total_sample = total(sample_order()) == 3150 + 499 + 252

test discount_none = discount(sample_order()) == 0 and discount(order_with("FREESHIP", 10000)) == 0

test discount_save10 = discount(order_with("SAVE10", 3150)) == 315

test discount_big20 = discount(order_with("BIG20", 10000)) == 2000 and discount(order_with("BIG20", 9999)) == 0

test freeship = shipping(order_with("FREESHIP", 1000)) == 0 and shipping(order_with("", 1000)) == 499

test net_threshold = shipping(order_with("SAVE10", 5500)) == 499 and shipping(order_with("SAVE10", 5600)) == 0

test total_save10 = total(order_with("SAVE10", 3150)) == 2835 + 499 + 226
