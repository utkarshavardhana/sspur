type Event = {ts: Int, level: Str, msg: Str}

type EventErr = BadJson{text: Str}

fn count_by_level(evs: List[Event]) -> List[(Str, Int)]
= evs.map(_.level).counts

fn escape_json_str(s: Str) -> Str
= s.replace("\\", "\\\\").replace("\"", "\\\"")

fn from_json(s: Str) -> List[Event] ! fail[EventErr]
= do
  r_result = regex("\\\{\"ts\":(\\d+),\"level\":\"([^\"]*)\",\"msg\":\"([^\"]*)\"\\}")
  match r_result
  | ok(r) => do
    matches = r.find_all(s)
    if matches.len < 1 then raise BadJson{text: s}
    init = []
    result = matches.fold(init, (acc, m) => acc.push(parse_match_to_event(m, r)))
    result
  | err(_) => raise BadJson{text: s}

fn from_json_impl(s: Str) -> List[Event]
= []

fn ingest(lines: List[Str]) -> List[Event] ! log
= do
  var out = []
  for l in lines
    match parse_line(l)
    | some(e) => out := out.push(e)
    | none => log("skip: " + l)
  out

fn main() -> Unit ! log
= log(count_by_level(ingest(sample())).map(p => "{p.0}={p.1}").join(","))

fn parse_line(line: Str) -> Opt[Event]
= do
  r_result = regex("\\[(\\d+)\\] ([A-Z]+): (.*)")
  match r_result
  | ok(r) => do
    caps = r.captures(line)
    match caps
    | some(groups) => do
      ts_str = groups[1]
      level = groups[2]
      msg = groups[3].trim
      match ts_str.to_int
      | some(ts) => some(Event{ts: ts, level: level, msg: msg})
      | none => none
    | none => none
  | err(_) => none

fn parse_match_to_event(m: Str, r: Regex) -> Event
= do
  caps_opt = r.captures(m)
  match caps_opt
  | some(g) => Event{ts: g[1].to_int.get, level: g[2], msg: g[3]}
  | none => Event{ts: 0, level: "", msg: ""}

fn redact(e: Event) -> Event
= do
  r_result = regex("[A-Za-z0-9._-]+@[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+")
  match r_result
  | ok(email_regex) => do
    redacted_msg = email_regex.replace(e.msg, "<email>")
    e with msg := redacted_msg
  | err(_) => e

fn sample() -> List[Str]
= ["[1] INFO: start", "[2] WARN: disk low", "oops", "[3] INFO: done"]

fn skipped(lines: List[Str]) -> List[Str]
= lines.filter(l => parse_line(l).is_none)

fn to_json(evs: List[Event]) -> Str
= do
  items = evs.map(e => "\{\"ts\":" + e.ts.str + ",\"level\":\"" + e.level + "\",\"msg\":\"" + escape_json_str(e.msg) + "\"}")
  "[" + items.join(",") + "]"

test counts = count_by_level([Event{ts: 1, level: "B", msg: ""}, Event{ts: 2, level: "A", msg: ""}, Event{ts: 3, level: "B", msg: ""}]) == [("B", 2), ("A", 1)]

test from_json_bad = catch from_json("not json") == [Event{ts: 0, level: "", msg: ""}]
| BadJson{text} => text == "not json"

test from_json_missing_field = catch from_json("[\{\"ts\":1}]") == [Event{ts: 0, level: "", msg: ""}]
| BadJson{text} => text == "[\{\"ts\":1}]"

test from_json_multiple = from_json("[\{\"ts\":1,\"level\":\"A\",\"msg\":\"x\"},\{\"ts\":2,\"level\":\"B\",\"msg\":\"y\"}]") == [Event{ts: 1, level: "A", msg: "x"}, Event{ts: 2, level: "B", msg: "y"}]

test from_json_simple = from_json("[\{\"ts\":1,\"level\":\"INFO\",\"msg\":\"up\"}]") == [Event{ts: 1, level: "INFO", msg: "up"}]

test parse_bad = parse_line("x|INFO|up").is_none

test parse_empty_msg = parse_line("[20] DEBUG: ") == some(Event{ts: 20, level: "DEBUG", msg: ""})

test parse_new_format = parse_line("[10] ERROR: problem") == some(Event{ts: 10, level: "ERROR", msg: "problem"})

test parse_ok = parse_line("[5] INFO: up") == some(Event{ts: 5, level: "INFO", msg: "up"})

test redact_multiple = redact(Event{ts: 1, level: "INFO", msg: "a@b.com and x@y.org"}) == Event{ts: 1, level: "INFO", msg: "<email> and <email>"}

test redact_no_email = redact(Event{ts: 1, level: "INFO", msg: "hello world"}) == Event{ts: 1, level: "INFO", msg: "hello world"}

test redact_simple = redact(Event{ts: 1, level: "INFO", msg: "contact user@example.com"}) == Event{ts: 1, level: "INFO", msg: "contact <email>"}

test skipped_all_valid = skipped(["[1] INFO: start", "[2] INFO: end"]) == []

test skipped_mixed = skipped(["[1] INFO: start", "bad line", "[2] INFO: end"]) == ["bad line"]

test skipped_multiple = skipped(["bad1", "[1] INFO: ok", "bad2"]) == ["bad1", "bad2"]

test to_json_empty = to_json([]) == "[]"

test to_json_simple = to_json([Event{ts: 1, level: "INFO", msg: "up"}]) == "[\{\"ts\":1,\"level\":\"INFO\",\"msg\":\"up\"}]"
