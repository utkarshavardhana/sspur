type CalcErr = BadChar{ch: Str} | DivByZero | BadSyntax

fn calc(s: Str) -> Int ! fail[CalcErr], div
= do
  toks = tokenize(s)
  r = parse_expr(toks, 0)
  if r.1 != toks.len then raise BadSyntax
  r.0

remove eval_tokens

fn op_of(t: Tok) -> Str
= match t
| Op{c} => c
| _ => ""

fn op_at(toks: List[Tok], i: Int) -> Str
= if i >= toks.len then "" else op_of(toks[i])

fn parse_expr(toks: List[Tok], i: Int) -> (Int, Int) ! fail[CalcErr], div
= do
  first = parse_term(toks, i)
  var acc = first.0
  var pos = first.1
  var go = true
  while go
    c = op_at(toks, pos)
    if c == "+" or c == "-" then do
      r = parse_term(toks, pos + 1)
      acc := if c == "+" then acc + r.0 else acc - r.0
      pos := r.1
    else go := false
  (acc, pos)

fn parse_term(toks: List[Tok], i: Int) -> (Int, Int) ! fail[CalcErr], div
= do
  first = parse_factor(toks, i)
  var acc = first.0
  var pos = first.1
  var go = true
  while go
    c = op_at(toks, pos)
    if c == "*" or c == "/" then do
      r = parse_factor(toks, pos + 1)
      if c == "/" and r.0 == 0 then raise DivByZero
      acc := if c == "*" then acc * r.0 else acc / r.0
      pos := r.1
    else go := false
  (acc, pos)

fn parse_factor(toks: List[Tok], i: Int) -> (Int, Int) ! fail[CalcErr], div
= if i >= toks.len then raise BadSyntax else factor_tok(toks[i], toks, i)

fn factor_tok(t: Tok, toks: List[Tok], i: Int) -> (Int, Int) ! fail[CalcErr], div
= match t
| Num{v} => (v, i + 1)
| Op{c} => factor_op(c, toks, i)

fn factor_op(c: Str, toks: List[Tok], i: Int) -> (Int, Int) ! fail[CalcErr], div
= if c == "-" then do
  r = parse_factor(toks, i + 1)
  (0 - r.0, r.1)
else if c == "(" then do
  r = parse_expr(toks, i + 1)
  if op_at(toks, r.1) != ")" then raise BadSyntax
  (r.0, r.1 + 1)
else raise BadSyntax

fn show_result(s: Str) -> Str ! div
= catch "{s} = {calc(s)}"
| BadChar{ch} => "{s} = error: bad character {ch}"
| DivByZero => "{s} = error: division by zero"
| BadSyntax => "{s} = error: syntax"

fn tokenize(s: Str) -> List[Tok] ! fail[CalcErr]
= do
  var toks = []
  var num = ""
  for ch in s.chars
    if is_digit(ch) then num := num + ch else do
      if not num.is_empty then do
        toks := toks.push(Num{v: num.to_int.or(0)})
        num := ""
      if "+-*/()".contains(ch) then toks := toks.push(Op{c: ch}) else if ch != " " then raise BadChar{ch: ch}
  if not num.is_empty then toks := toks.push(Num{v: num.to_int.or(0)})
  toks

test prec = catch calc("2 + 3 * 4") == 14
| _ => false

test prec2 = catch calc("2 * 3 + 4") == 10
| _ => false

test div_trunc = catch calc("7 / 2") == 3
| _ => false

test div_neg = catch calc("-7 / 2") == -3
| _ => false

test left_assoc = catch calc("100 / 5 / 2 - 4 - 3") == 3
| _ => false

test div_zero = catch calc("1 / 0") == 0
| DivByZero => true
| _ => false

test parens = catch calc("(2 + 3) * 4") == 20
| _ => false

test nested = catch calc("((1 + 2) * (3 - 1))") == 6
| _ => false

test unary = catch calc("2 * -3") == -6
| _ => false

test unary_paren = catch calc("-(1 + 2)") == -3
| _ => false

test unary_start = catch calc("-3") == -3
| _ => false

test syn_empty = catch calc("   ") == 0
| BadSyntax => true
| _ => false

test syn_missing = catch calc("1 +") == 0
| BadSyntax => true
| _ => false

test syn_lead = catch calc("* 2") == 0
| BadSyntax => true
| _ => false

test syn_two = catch calc("1 2") == 0
| BadSyntax => true
| _ => false

test syn_open = catch calc("(1 + 2") == 0
| BadSyntax => true
| _ => false

test syn_close = catch calc("1 + 2)") == 0
| BadSyntax => true
| _ => false

test syn_empty_paren = catch calc("()") == 0
| BadSyntax => true
| _ => false

test show_div = show_result("1 / 0") == "1 / 0 = error: division by zero"

test show_syn = show_result("1 +") == "1 + = error: syntax"

test show_ok = show_result("2 * (3 + 4)") == "2 * (3 + 4) = 14"
