type Event = {ts: Int, level: Str, msg: Str}

type EventErr = BadJson{text: Str}

fn build_event(g: List[Str]) -> Opt[Event]
= match g[1].to_int
| some(ts) => some(Event{ts: ts, level: g[2], msg: g[3].trim})
| none => none

fn count_by_level(evs: List[Event]) -> List[(Str, Int)]
= evs.map(_.level).counts

fn from_json(s: Str) -> List[Event] ! fail[EventErr]
= match json.decode[List[Event]](s)
| ok(evs) => evs
| err(_) => raise BadJson{text: s}

fn ingest(lines: List[Str]) -> List[Event] ! log
= do
  var out = []
  for l in lines
    match parse_line(l)
    | some(e) => out := out.push(e)
    | none => log("skip: " + l)
  out

fn main() -> Unit ! log
= log(count_by_level(ingest(sample())).map(p => "{p.0}={p.1}").join(","))

fn parse_line(line: Str) -> Opt[Event]
= match regex("^\\[(\\d+)\\] ([A-Z]+):(.*)$")
| ok(re) => parse_with(re, line)
| err(_) => none

fn parse_with(re: Regex, line: Str) -> Opt[Event]
= match re.captures(line)
| some(g) => build_event(g)
| none => none

fn redact(e: Event) -> Event
= match regex("[A-Za-z0-9._-]+@[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+")
| ok(re) => e with msg := re.replace(e.msg, "<email>")
| err(_) => e

fn sample() -> List[Str]
= ["[1] INFO: start", "[2] WARN: disk low", "oops", "3|INFO|done", "[3] INFO: done"]

fn skipped(lines: List[Str]) -> List[Str]
= lines.filter(l => parse_line(l).is_none)

fn to_json(evs: List[Event]) -> Str
= json.encode(evs)

test counts = count_by_level([Event{ts: 1, level: "B", msg: ""}, Event{ts: 2, level: "A", msg: ""}, Event{ts: 3, level: "B", msg: ""}]) == [("B", 2), ("A", 1)]

test ingest_sample = ingest(sample()).len == 3

test json_bad = catch from_json("nope") == []
| BadJson{text} => text == "nope"

test json_empty = to_json([]) == "[]"

test json_float_ts = catch from_json("[\{\"ts\":1.5,\"level\":\"INFO\",\"msg\":\"x\"}]") == []
| BadJson{text} => true

test json_missing = catch from_json("[\{\"ts\":1,\"level\":\"INFO\"}]") == []
| BadJson{text} => true

test json_not_array = catch from_json("\{\"ts\":1,\"level\":\"INFO\",\"msg\":\"x\"}") == []
| BadJson{text} => true

test json_null_msg = catch from_json("[\{\"ts\":1,\"level\":\"INFO\",\"msg\":null}]") == []
| BadJson{text} => true

test json_out = to_json([Event{ts: 1, level: "INFO", msg: "up"}]) == "[\{\"ts\":1,\"level\":\"INFO\",\"msg\":\"up\"}]"

test json_roundtrip = do
  evs = [Event{ts: 1, level: "INFO", msg: "a \"q\""}, Event{ts: 2, level: "WARN", msg: ""}]
  catch from_json(to_json(evs)) == evs
  | BadJson{text} => false

test json_wrong_type = catch from_json("[\{\"ts\":\"1\",\"level\":\"INFO\",\"msg\":\"x\"}]") == []
| BadJson{text} => true

test parse_bad = parse_line("x|INFO|up").is_none

test parse_empty_msg = parse_line("[7] ERROR:   ") == some(Event{ts: 7, level: "ERROR", msg: ""})

test parse_lower_level = parse_line("[1] info: x").is_none

test parse_neg_ts = parse_line("[-1] INFO: x").is_none

test parse_no_ts = parse_line("[] INFO: x").is_none

test parse_ok = parse_line("[5] INFO: up") == some(Event{ts: 5, level: "INFO", msg: "up"})

test parse_old_rejected = parse_line("5|INFO|up").is_none

test parse_trim = parse_line("[7] WARN:   a b  ") == some(Event{ts: 7, level: "WARN", msg: "a b"})

test redact_many = redact(Event{ts: 1, level: "INFO", msg: "x@y.z, p@q.r"}).msg == "<email>, <email>"

test redact_none = redact(Event{ts: 1, level: "INFO", msg: "user@localhost"}).msg == "user@localhost"

test redact_one = redact(Event{ts: 1, level: "INFO", msg: "mail a.b_c-d@ex-1.co.uk now"}).msg == "mail <email> now"

test skipped_lines = skipped(sample()) == ["oops", "3|INFO|done"]
