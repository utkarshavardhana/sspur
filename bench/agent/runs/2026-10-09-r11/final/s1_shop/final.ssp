= x with active := false

fn exam_discounted(x: Exam, p: Int) -> Exam
= x with price := x.price - pct(x.price, clamp(p, 0, 100))

fn exam_find(xs: List[Exam], id: Int) -> Opt[Exam]
= xs.find(_.id == id)

fn exam_gross(x: Exam) -> Int
= exam_value(x) + exam_tax(x)

fn exam_in_region(xs: List[Exam], r: Str) -> List[Exam]
= xs.filter(_.region == r)

fn exam_label(x: Exam) -> Str
= label_of(x.name, x.id)

fn exam_line(x: Exam) -> Str
= exam_label(x) + ": " + money(exam_gross(x))

fn exam_names(xs: List[Exam]) -> List[Str]
= xs.map(_.name).sort

fn exam_new(id: Int, name: Str, qty: Int, price: Int, region: Str) -> Exam
= Exam{id: id, name: name, qty: qty, price: price, region: region, active: true}

fn exam_report(xs: List[Exam]) -> Str
= join_lines(xs.map(exam_line))

fn exam_restock(x: Exam, n: Int) -> Exam
= x with qty := x.qty + n

fn exam_sample() -> List[Exam]
= [exam_new(1, "alpha36", 2, 300, "US"), exam_new(2, "beta36", 0, 900, "APAC"), exam_new(3, "gamma36", 7, 111, "UK")]

fn exam_score(x: Exam) -> Int
= exam_value(x) / 4 + (if x.active then 1 else 0)

fn exam_tax(x: Exam) -> Int
= pct(exam_value(x), tax_rate(x.region))

fn exam_top(xs: List[Exam], n: Int) -> List[Exam]
= xs.sort_by(x => -exam_value(x)).take(n)

fn exam_total(xs: List[Exam]) -> Int
= xs.map(exam_gross).sum

fn exam_valid(x: Exam) -> Bool
= x.qty >= 0 and x.price >= 0 and not x.name.is_empty

fn exam_value(x: Exam) -> Int
= x.qty * x.price

