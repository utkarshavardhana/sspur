type Item = {sku: Str, qty: Int where _ > 0, price: Money[USD]}
type Order = {id: OrderId, items: List[Item] where _.len > 0}
type OrderErr = OutOfStock{sku: Str}

fn total(items: List[Item]) -> Money[USD]
= items.map(_.price * _.qty).sum

fn place(o: Order) -> Order ! db.read[Stock], db.write[Orders], fail[OrderErr]
= do
  for i in o.items
    if db.get(Stock, i.sku).or(0) < i.qty then raise OutOfStock{sku: i.sku}
  db.put(Orders, o.id, o)
  o
