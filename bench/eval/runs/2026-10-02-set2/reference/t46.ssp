fn exec(stack: List[Int], cmd: Str) -> List[Int] ! fail[CmdErr]
= do
  words = cmd.split(" ")
  op = words[0]
  if op == "push" then do
    n = words.get(1).or("").to_int.ok_or(MissingArg{cmd: "push"})
    stack.push(n)
  else if op == "pop" then
    if stack.is_empty then raise MissingArg{cmd: "pop"} else stack.take(stack.len - 1)
  else if op == "add" then
    if stack.len < 2 then raise MissingArg{cmd: "add"} else stack.take(stack.len - 2).push(stack[stack.len - 2] + stack[stack.len - 1])
  else raise Unknown{cmd: op}
