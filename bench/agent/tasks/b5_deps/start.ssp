type Pkg = {name: Str, deps: List[Str]}
type DepErr = Unknown{name: Str}

fn registry() -> List[Pkg]
= [Pkg{name: "app", deps: ["web", "db"]}, Pkg{name: "web", deps: ["http", "log"]}, Pkg{name: "db", deps: ["log"]}, Pkg{name: "http", deps: []}, Pkg{name: "log", deps: []}]

fn find_pkg(reg: List[Pkg], name: Str) -> Pkg ! fail[DepErr]
= reg.find(_.name == name).ok_or(Unknown{name})

fn install_order(reg: List[Pkg], target: Str) -> List[Str] ! fail[DepErr]
= do
  p = find_pkg(reg, target)
  p.deps.flat_map(d => install_order(reg, d)).push(target)

fn plan(reg: List[Pkg], target: Str) -> Str
= catch install_order(reg, target).join(" -> ")
  | Unknown{name} => "error: unknown package {name}"

fn main() -> Unit ! log
= log(plan(registry(), "app"))

test leaf = catch install_order(registry(), "http") == ["http"]
  | _ => false

test db_first_log = catch install_order(registry(), "db") == ["log", "db"]
  | _ => false

test unknown = plan(registry(), "nope") == "error: unknown package nope"
