fn exec(stack: List[Int], cmd: Str) -> List[Int] ! fail[CmdErr]
= do
  parts = cmd.split(" ")
  first_word = parts.first.or("")
  match first_word
  | "push" =>
    if parts.len < 2 then raise MissingArg{cmd: "push"}
    else catch parts.get(1).or("").to_int
      | _ =>
        num = (parts.get(1).or("")).to_int
        if (parts.get(1).or("")).to_int == 0 and (parts.get(1).or("")) != "0" then raise MissingArg{cmd: "push"} else stack.push((parts.get(1).or("")).to_int)
  | "pop" =>
    if stack.is_empty then raise MissingArg{cmd: "pop"}
    else stack.take(stack.len - 1)
  | "add" =>
    if stack.len < 2 then raise MissingArg{cmd: "add"}
    else do
      a = stack.get(stack.len - 1).or(0)
      b = stack.get(stack.len - 2).or(0)
      stack.take(stack.len - 2).push(a + b)
  | _ => raise Unknown{cmd: first_word}
