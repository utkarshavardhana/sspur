type Tree = Leaf | Node{left: Tree, value: Int, right: Tree}
type ParseErr = BadNum{text: Str}

fn insert(t: Tree, v: Int) -> Tree
= match t
  | Leaf => Node{left: Leaf, value: v, right: Leaf}
  | Node{left, value, right} => if v < value then Node{left: insert(left, v), value, right} else Node{left, value, right: insert(right, v)}

fn walk(t: Tree) -> Unit ! yield[Int]
= match t
  | Leaf => ()
  | Node{left, value, right} => do
    walk(left)
    yield(value)
    walk(right)

fn each[T](xs: List[T]) -> Unit ! yield[T]
= do
  for x in xs
    yield(x)

fn naturals() -> Unit ! yield[Int], div
= do
  var i = 0
  while true
    yield(i)
    i := i + 1

fn fib_upto(limit: Int) -> Unit ! yield[Int], div
= do
  var (a, b) = (0, 1)
  while a <= limit
    yield(a)
    (a2, b2) = (b, a + b)
    a := a2
    b := b2

fn squares_of_odds(xs: List[Int]) -> Unit ! yield[Int]
= do
  for x in each(xs)
    if x % 2 == 1 then yield(x * x)

fn sorted(xs: List[Int]) -> List[Int]
= do
  var out = []
  for v in walk(xs.fold(Leaf, insert))
    out := out.push(v)
  out

fn first_square_over(n: Int) -> Int ! div
= do
  for i in naturals()
    if i * i > n then return i
  -1

fn take[T, e](n: Int, gen: () -> Unit ! yield[T], e) -> List[T] ! e
= do
  var out = []
  handle gen()
    | yield(x) => do
      out := out.push(x)
      if out.len >= n then () else resume()
  out

fn parse_all(xs: List[Str]) -> Unit ! yield[Int], fail[ParseErr]
= do
  for s in xs
    match s.to_int
    | some(n) => yield(n)
    | none => raise BadNum{text: s}

fn total(xs: List[Str]) -> Str
= do
  var sum = 0
  r = catch do
      for n in parse_all(xs)
        sum := sum + n
      "sum {sum}"
    | BadNum{text} => "bad {text} after {sum}"
  r

fn traced_count(xs: List[Int]) -> Int ! log
= do
  var n = 0
  for x in each(xs)
    log("got {x}")
    n := n + 1
  n

fn main() -> Unit ! log, div
= do
  log("sorted {sorted([5, 2, 8, 1, 9])}")
  log("odd squares {take(3, () => squares_of_odds([1, 2, 3, 4, 5, 6, 7]))}")
  log("fib {take(10, () => fib_upto(1000))}")
  log("first {first_square_over(50)}")
  log(total(["1", "2", "3"]))
  log(total(["1", "x", "3"]))
  log("count {traced_count([7, 8])}")

test tree_order = sorted([5, 2, 8, 1, 9]) == [1, 2, 5, 8, 9]
test generic_each = take(2, () => each(["a", "b", "c"])) == ["a", "b"]
test filtered = take(5, () => squares_of_odds([1, 2, 3, 4, 5])) == [1, 9, 25]
test infinite = take(4, naturals) == [0, 1, 2, 3]
test early_return = first_square_over(50) == 8
test fib = take(100, () => fib_upto(30)) == [0, 1, 1, 2, 3, 5, 8, 13, 21]
test errors_escape = total(["1", "x", "3"]) == "bad x after 1"
test sums = total(["1", "2", "3"]) == "sum 6"
test body_effects = traced_count([7, 8]) == 2
