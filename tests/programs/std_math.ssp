type Pt = {x: F64, y: F64}

fn dist(a: Pt, b: Pt) -> F64
= (a.x - b.x).hypot(a.y - b.y)

fn angle_deg(p: Pt) -> Int
= (p.y.atan2(p.x) * 180.0 / 3.141592653589793).round

fn compound(principal: F64, rate: F64, years: Int) -> Str
= (principal * (1.0 + rate).pow(years.to_f64)).fmt(2)

fn half_life(n0: F64, k: F64, t: F64) -> F64
= n0 * (0.0 - k * t).exp

fn trig_ok(x: F64) -> Bool
= ((x.sin.pow(2.0) + x.cos.pow(2.0)) - 1.0).abs < 0.000000001 and (x.tan - x.sin / x.cos).abs < 0.000001

fn logs() -> List[Int]
= [1024.0.log2.round, 1000.0.log10.round, 1.0.exp.ln.round, 2.7.ceil, -2.7.ceil, -2.7.trunc, 0.5.asin.cos.fmt(4).len]

fn fraction(a: Int, b: Int) -> (Int, Int)
= do
  g = a.gcd(b)
  (a / g, b / g)

fn lcm_all(xs: List[Int]) -> Int
= xs.fold(1, (acc, x) => acc.lcm(x))

fn hash(s: Str) -> Int
= s.bytes.fold(-3750763034362895579, (h, b) => h.bxor(b).wrapping_mul(1099511628211))

fn safe_mul(a: Int, b: Int) -> Opt[Int]
= a.checked_mul(b)

fn bits(n: Int) -> List[Int]
= [n.popcount, n.clz, n.ctz, n.bnot, n.band(255), n.shr(4)]

fn clamps() -> List[Int]
= [clamp(15, 0, 10), clamp(-3, 0, 10), clamp(5, 0, 10), max(2, 9), min(2, 9)]

fn dice(seed: Int, n: Int) -> List[Int] ! div
= do
  var s = seed
  var out = []
  while out.len < n
    (v, next) = rand_int(s, 1, 7)
    out := out.push(v)
    s := next
  out

fn mean_rand(seed: Int, n: Int) -> F64
= do
  pick = (0..n).fold((0.0, seed), (acc, k) => do
    (v, s) = rand_f64(acc.1)
    (acc.0 + v, s))
  pick.0 / n.to_f64

test euclid = dist(Pt{x: 0.0, y: 0.0}, Pt{x: 3.0, y: 4.0}) == 5.0
test angles = [Pt{x: 1.0, y: 1.0}, Pt{x: -1.0, y: 0.0}, Pt{x: 0.0, y: -2.0}].map(angle_deg) == [45, 180, -90]
test interest = compound(1000.0, 0.05, 10) == "1628.89"
test decay = (half_life(100.0, 0.693147, 1.0) - 50.0).abs < 0.001
test trig = [0.1, 0.7, 1.3, 2.9].all(trig_ok)
test log_values = logs() == [10, 3, 1, 3, -3, -2, 6]
test nan_checks = (0.0 / 0.0).is_nan and not (1.0 / 0.0).is_finite and 1.5.is_finite
test reduce = fraction(84, 36) == (7, 3)
test lcm_list = lcm_all([4, 6, 10]) == 60
test fnv = hash("sspur") == hash("sspur") and hash("a") != hash("b")
test wrap = 9223372036854775807.wrapping_add(1) == -9223372036854775807 - 1 and 0.wrapping_sub(1) == -1
test checked = safe_mul(4611686018427387904, 2) == none and safe_mul(3, 4) == some(12) and 7.checked_div(0) == none and 7.checked_add(1) == some(8)
test bit_ops = bits(1000) == [6, 54, 3, -1001, 232, 62]
test zero_bits = [0.clz, 0.ctz, (0 - 1).popcount, (0.0 - 2.7).ceil] == [64, 64, 64, -2]
test clamp_values = clamps() == [10, 0, 5, 9, 2]
test dice_range = dice(42, 200).all(d => d >= 1 and d <= 6) and dice(42, 20) == dice(42, 20) and dice(42, 20) != dice(43, 20)
test dice_cover = dice(7, 300).to_set.len == 6
test uniform = (mean_rand(1, 4000) - 0.5).abs < 0.05
test rand_pure = rand(5) == rand(5) and rand(5).1 != 5
