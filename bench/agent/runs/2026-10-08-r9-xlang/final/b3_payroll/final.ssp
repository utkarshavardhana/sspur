type CsvErr = BadRow{line: Int} | BadNumber{line: Int, field: Str}

type Row = {name: Str, rate: Int, hours: Int}

fn is_data(i: Int, line: Str) -> Bool
= not line.trim.is_empty and not (i == 0 and line.trim == "name,rate,hours")

fn main() -> Unit ! log, fail[CsvErr]
= log(report(parse(sample())))

fn nat(s: Str) -> Opt[Int]
= match s.to_int
| some(n) => if n >= 0 then some(n) else none
| none => none

fn parse(text: Str) -> List[Row] ! fail[CsvErr]
= do
  var out = []
  for p in text.split("\n").enumerate
    if is_data(p.0, p.1) then out := out.push(row_of(p.0 + 1, p.1))
  out

fn parse_row(line: Str) -> Row
= do
  f = line.split(",")
  Row{name: f[0], rate: f[1].to_int.or(0), hours: f[2].to_int.or(0)}

fn pay(r: Row) -> Int
= if r.hours > 40 then r.rate * 40 + r.rate * 3 * (r.hours - 40) / 2 else r.rate * r.hours

fn problem(n: Int, line: Str) -> Str
= catch "".repeat(row_of(n, line).rate * 0)
| BadRow{line: l} => "line {l}: expected 3 fields"
| BadNumber{line: l, field: f} => "line {l}: bad {f}"

fn report(rows: List[Row]) -> Str
= do
  sorted = rows.sort_by(r => (-pay(r), r.name))
  lines = sorted.map(r => "{r.name}: {pay(r)}")
  (lines + ["total: {rows.map(pay).sum}"]).join("\n")

fn row_of(n: Int, line: Str) -> Row ! fail[CsvErr]
= do
  f = line.split(",").map(_.trim)
  if f.len != 3 then raise BadRow{line: n}
  rate = nat(f[1]).ok_or(BadNumber{line: n, field: "rate"})
  hours = nat(f[2]).ok_or(BadNumber{line: n, field: "hours"})
  Row{name: f[0], rate: rate, hours: hours}

fn sample() -> Str
= "Beth,400,0\nDan,375,0\nKathy,400,10\nMark,500,20\nMary,550,22\nSusie,425,18"

fn validate(text: Str) -> List[Str]
= text.split("\n").enumerate.filter(p => is_data(p.0, p.1)).map(p => problem(p.0 + 1, p.1)).filter(m => not m.is_empty)

test paid = pay(Row{name: "Mark", rate: 500, hours: 20}) == 10000

test parsed = parse(sample()).len == 6 and parse(sample())[2] == Row{name: "Kathy", rate: 400, hours: 10}

test reported = report(parse("Beth,400,0\nKathy,400,10")) == "Kathy: 4000\nBeth: 0\ntotal: 4000"

test t_hdr = parse("name,rate,hours\n\n a , 5 ,2 \n").len == 1 and parse(" name,rate,hours \nA,1,1")[0].name == "A"

test t_hdr_late = catch parse("A,1,1\nname,rate,hours") == []
| BadRow{line} => false
| BadNumber{line, field} => line == 2 and field == "rate"

test t_num = catch parse("A,1,1\nB,x,2") == []
| BadNumber{line, field} => line == 2 and field == "rate"
| _ => false

test t_num2 = catch parse("A,1,-1") == []
| BadNumber{line, field} => line == 1 and field == "hours"
| _ => false

test t_ot = pay(Row{name: "a", rate: 10, hours: 50}) == 550 and pay(Row{name: "a", rate: 10, hours: 40}) == 400

test t_rep = report(parse("b,10,1\na,10,1\nc,20,1")) == "c: 20\na: 10\nb: 10\ntotal: 40"

test t_rep0 = report([]) == "total: 0"

test t_row = catch parse("name,rate,hours\n\nA,1") == []
| BadRow{line} => line == 3
| _ => false

test t_val = validate("name,rate,hours\nA,1\nB,x,1\n\nC,1,y\nD,1,1") == ["line 2: expected 3 fields", "line 3: bad rate", "line 5: bad hours"]

test t_val_ok = validate("A,1,1") == []
