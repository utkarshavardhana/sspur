fn is_balanced(s: Str) -> Bool
= do
  var stack = []
  for c in s.chars do
    if c == "(" or c == "[" or c == "{" then
      stack := stack.push(c)
    else if c == ")" then
      if stack.is_empty or stack.last.get != "(" then
        return false
      stack := stack.drop(stack.len - 1)
    else if c == "]" then
      if stack.is_empty or stack.last.get != "[" then
        return false
      stack := stack.drop(stack.len - 1)
    else if c == "}" then
      if stack.is_empty or stack.last.get != "{" then
        return false
      stack := stack.drop(stack.len - 1)
  stack.is_empty
