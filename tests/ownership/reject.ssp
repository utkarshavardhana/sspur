test t = alloc(1, 0).is_null == false

// case unsafe_load E_UNSAFE
profile sys

fn peek(p: Ptr[Int]) -> Int
= p.load(0)

// case use_after_move E_USE_MOVED
profile sys

res type File = {fd: Int} drop close

fn close(f: File)
= ()

fn open(fd: Int) -> File
= File{fd}

fn consume(f: File) -> Int
= f.fd

fn size(f: &File) -> Int
= f.fd

fn bump(f: &mut File)
= do
  f.fd := f.fd + 1
  ()

fn twice() -> Int
= do
  a = open(1)
  x = consume(a)
  x + consume(a)

// case send_then_use E_USE_MOVED
profile sys

res type File = {fd: Int} drop close
res type Tok = {id: Int}

fn close(f: File)
= ()

fn open(fd: Int) -> File
= File{fd}

fn consume(f: File) -> Int
= f.fd

fn eat(t: Tok) -> Int
= do
  Tok{id} = t
  id

fn size(f: &File) -> Int
= f.fd

fn bump(f: &mut File)
= do
  f.fd := f.fd + 1
  ()

fn f() -> Int ! conc
= do
  c = chan()
  a = open(1)
  c.send(a)
  c.close
  size(&a)

// case send_in_loop E_USE_MOVED
profile sys

res type File = {fd: Int} drop close
res type Tok = {id: Int}

fn close(f: File)
= ()

fn open(fd: Int) -> File
= File{fd}

fn consume(f: File) -> Int
= f.fd

fn eat(t: Tok) -> Int
= do
  Tok{id} = t
  id

fn size(f: &File) -> Int
= f.fd

fn bump(f: &mut File)
= do
  f.fd := f.fd + 1
  ()

fn f() -> Int ! conc
= do
  c = chan()
  a = open(1)
  for i in 0..2
    c.send(a)
  c.close
  0

// case move_in_match_arm E_USE_MOVED
profile sys

res type File = {fd: Int} drop close
res type Tok = {id: Int}

fn close(f: File)
= ()

fn open(fd: Int) -> File
= File{fd}

fn consume(f: File) -> Int
= f.fd

fn eat(t: Tok) -> Int
= do
  Tok{id} = t
  id

fn size(f: &File) -> Int
= f.fd

fn bump(f: &mut File)
= do
  f.fd := f.fd + 1
  ()

type S = X | Y
fn f(s: S) -> Int
= do
  a = open(1)
  n = match s
    | X => consume(a)
    | Y => 0
  n + size(&a)

// case move_in_catch E_USE_MOVED
profile sys

res type File = {fd: Int} drop close
res type Tok = {id: Int}

fn close(f: File)
= ()

fn open(fd: Int) -> File
= File{fd}

fn consume(f: File) -> Int
= f.fd

fn eat(t: Tok) -> Int
= do
  Tok{id} = t
  id

fn size(f: &File) -> Int
= f.fd

fn bump(f: &mut File)
= do
  f.fd := f.fd + 1
  ()

type E = Bad
fn r(x: Int) -> Int ! fail[E]
= if x > 0 then raise Bad else x
fn f(x: Int) -> Int
= do
  a = open(1)
  n = catch consume(a) + r(x)
    | Bad => 0
  n + size(&a)

// case nested_par_move E_PAR_SHARE
profile sys

res type File = {fd: Int} drop close
res type Tok = {id: Int}

fn close(f: File)
= ()

fn open(fd: Int) -> File
= File{fd}

fn consume(f: File) -> Int
= f.fd

fn eat(t: Tok) -> Int
= do
  Tok{id} = t
  id

fn size(f: &File) -> Int
= f.fd

fn bump(f: &mut File)
= do
  f.fd := f.fd + 1
  ()

fn f() -> Int
= do
  a = open(1)
  ((x, y), z) = par(par(consume(a), 1), 2)
  x + y + z

