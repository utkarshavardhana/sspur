type Cache = {cap: Int, entries: List[Entry], hits: Int, misses: Int}

type CacheErr = BadCapacity{cap: Int}

type Entry = {key: Str, value: Int}

fn describe(c: Cache) -> Str
= "cap={c.cap} [" + c.entries.map(e => "{e.key}={e.value}").join(", ") + "]"

fn get_or(c: Cache, key: Str, default: Int) -> (Int, Cache)
= do
  (r, c2) = lookup(c, key)
  (r.or(default), c2)

fn keys(c: Cache) -> List[Str]
= c.entries.map(_.key)

fn lookup(c: Cache, key: Str) -> (Opt[Int], Cache)
= match c.entries.find(_.key == key)
| some(e) => (some(e.value), c with entries := touch(c.entries, e), hits := c.hits + 1)
| none => (none, c with misses := c.misses + 1)

fn main() -> Unit ! log
= log(describe(put(put(mk(2, []), "a", 1), "b", 2)))

fn mk(cap: Int, ks: List[Str]) -> Cache
= ks.fold(Cache{cap: cap, entries: [], hits: 0, misses: 0}, (acc, k) => put(acc, k, k.len))

fn new_cache(cap: Int) -> Cache ! fail[CacheErr]
= do
  if cap < 1 then raise BadCapacity{cap: cap}
  Cache{cap: cap, entries: [], hits: 0, misses: 0}

fn peek(c: Cache, key: Str) -> Opt[Int]
= c.entries.find(_.key == key).map(_.value)

fn put(c: Cache, key: Str, value: Int) -> Cache
= c with entries := trim(touch(c.entries, Entry{key: key, value: value}), c.cap)

fn resize(c: Cache, cap: Int) -> Cache ! fail[CacheErr]
= do
  if cap < 1 then raise BadCapacity{cap: cap}
  c with cap := cap, entries := trim(c.entries, cap)

fn size(c: Cache) -> Int
= c.entries.len

fn touch(entries: List[Entry], e: Entry) -> List[Entry]
= entries.filter(_.key != e.key).push(e)

fn trim(entries: List[Entry], cap: Int) -> List[Entry]
= if entries.len > cap then entries.drop(entries.len - cap) else entries

test described = describe(put(new_cache(3), "x", 7)) == "cap=3 [x=7]"

test evict_lru = keys(mk(2, ["a", "bb", "ccc"])) == ["bb", "ccc"]

test get_or_hit = do
  (v, c) = get_or(mk(2, ["a", "bb"]), "a", -1)
  v == 1 and keys(c) == ["bb", "a"] and c.hits == 1

test get_or_miss = do
  (v, c) = get_or(mk(2, ["a", "bb"]), "z", -1)
  v == -1 and c.misses == 1 and keys(c) == ["a", "bb"]

test lookup_hit = do
  (v, c) = lookup(mk(3, ["a", "bb", "ccc"]), "a")
  v == some(1) and keys(c) == ["bb", "ccc", "a"] and c.hits == 1 and c.misses == 0

test lookup_miss = do
  (v, c) = lookup(mk(2, ["a", "bb"]), "z")
  v == none and keys(c) == ["a", "bb"] and c.hits == 0 and c.misses == 1

test new_bad = catch new_cache(0).cap == 0
| BadCapacity{cap} => cap == 0

test new_ok = catch new_cache(2).cap == 2 and new_cache(2).hits == 0
| _ => false

test peek_pure = do
  c = mk(2, ["a", "bb"])
  peek(c, "a") == some(1) and peek(c, "z") == none and keys(c) == ["a", "bb"] and c.hits == 0 and c.misses == 0

test put_existing = keys(put(mk(2, ["a", "bb"]), "a", 9)) == ["bb", "a"]

test put_existing_value = peek(put(mk(2, ["a", "bb"]), "a", 9), "a") == some(9)

test put_two = keys(put(put(new_cache(2), "a", 1), "b", 2)) == ["a", "b"]

test resize_bad = catch resize(mk(2, ["a"]), 0).cap == 0
| BadCapacity{cap} => cap == 0

test resize_grows = do
  c = resize(mk(2, ["a", "bb"]), 5)
  c.cap == 5 and keys(c) == ["a", "bb"]

test resize_shrinks = do
  c = resize(mk(3, ["a", "bb", "ccc"]), 1)
  c.cap == 1 and keys(c) == ["ccc"]
