fn words_of(text: Str, stop: List[Str]) -> List[Str]
= text.lower.words.filter(w => not stop.contains(w))

fn word_freq(text: Str, stop: List[Str]) -> List[(Str, Int)]
= words_of(text, stop).counts

fn top_k(text: Str, k: Int where _ >= 0, stop: List[Str]) -> List[(Str, Int)]
= word_freq(text, stop).sort_by(p => (-p.1, p.0)).take(k)

fn top_line(text: Str, k: Int where _ >= 0, stop: List[Str]) -> Str
= top_k(text, k, stop).map(fmt_pair).join(" ")

fn summary(text: Str, stop: List[Str]) -> Str
= do
  n = words_of(text, stop).len
  d = word_freq(text, stop).len
  "{n} words, {d} distinct, top: {top_line(text, 3, stop)}"

fn main() -> Unit ! log
= log(summary("The cat and the hat. The end!", []))

fn longest_word(text: Str) -> Opt[Str]
= do
  ws = words_of(text, [])
  if ws.len == 0 then none else some(ws.fold(ws[0], (a, w) => if w.len > a.len then w else a))

test freq_basic = word_freq("a b a", []) == [("a", 2), ("b", 1)]

test summary_basic = summary("b a b", []) == "3 words, 2 distinct, top: b=2 a=1"

test top_one = top_k("x y y z", 1, []) == [("y", 2)]

test tie_alpha = top_k("d c b a", 4, []) == [("a", 1), ("b", 1), ("c", 1), ("d", 1)]

test tie_mixed = top_k("z z b a a c", 3, []) == [("a", 2), ("z", 2), ("b", 1)]

test stop_words = words_of("The cat and THE hat", ["the", "and"]) == ["cat", "hat"]

test stop_freq = word_freq("a b a c", ["a"]) == [("b", 1), ("c", 1)]

test stop_summary = summary("the a the b", ["the"]) == "2 words, 2 distinct, top: a=1 b=1"

test stop_line = top_line("x y y z", 2, ["y"]) == "x=1 z=1"

test longest_basic = longest_word("a Bcd ef") == some("bcd")

test longest_tie = longest_word("ab cd e") == some("ab")

test longest_none = longest_word("") == none
