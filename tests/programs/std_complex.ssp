fn near(a: Complex, b: Complex) -> Bool
= a.sub(b).abs < 0.000000001

fn close(x: F64, y: F64) -> Bool
= (x - y).abs < 0.000000001

fn i() -> Complex
= complex(0.0, 1.0)

fn root_of_unity(n: Int, k: Int) -> Complex
= polar(1.0, 2.0 * pi() * k.to_f64 / n.to_f64)

fn dft(xs: List[F64]) -> List[Complex]
= do
  n = xs.len
  (0..n).map(k => (0..n).fold(complex(0.0, 0.0), (acc, j) => acc.add(root_of_unity(n, -(j * k)).scale(xs[j]))))

fn horner(cs: List[Complex], z: Complex) -> Complex
= cs.fold(complex(0.0, 0.0), (acc, c) => acc.mul(z).add(c))

fn mandel(c: Complex, limit: Int) -> Int ! div
= do
  var z = complex(0.0, 0.0)
  var n = 0
  while n < limit and z.norm <= 4.0
    z := z.mul(z).add(c)
    n := n + 1
  n

fn all_unary(z: Complex) -> List[Complex]
= [z.neg, z.conj, z.exp, z.ln, z.sqrt, z.sin, z.cos, z.tan, z.sinh, z.cosh, z.tanh, z.asin, z.acos, z.atan, z.asinh, z.acosh, z.atanh]

fn all_binary(z: Complex, w: Complex) -> List[Complex]
= [z.add(w), z.sub(w), z.mul(w), z.div(w), z.pow(w), z.scale(w.re)]

fn reals(z: Complex) -> (F64, F64, F64)
= (z.abs, z.arg, z.norm)

test arithmetic = complex(1.0, 2.0).mul(complex(3.0, -1.0)) == complex(5.0, 5.0) and near(complex(5.0, 5.0).div(complex(3.0, -1.0)), complex(1.0, 2.0)) and complex(4.0, 2.0).div(complex(2.0, 0.0)) == complex(2.0, 1.0) and complex(1.0, 2.0).add(complex(1.0, 1.0)).re == 2.0
test i_squared = i().mul(i()) == complex(-1.0, 0.0) and i().pow(complex(2.0, 0.0)).sub(complex(-1.0, 0.0)).abs < 0.000000000001
test euler = near(i().scale(pi()).exp, complex(-1.0, 0.0))
test polar_form = close(polar(2.0, 0.5).abs, 2.0) and close(polar(2.0, 0.5).arg, 0.5) and complex(3.0, 4.0).abs == 5.0 and complex(3.0, 4.0).norm == 25.0
test sqrt_branch = complex(-4.0, 0.0).sqrt == complex(0.0, 2.0) and complex(-4.0, -0.0).sqrt.im == -2.0 and near(complex(3.0, 4.0).sqrt, complex(2.0, 1.0))
test ln_exp = near(complex(1.5, -0.7).exp.ln, complex(1.5, -0.7))
test trig_identity = do
  z = complex(0.3, 0.8)
  near(z.sin.mul(z.sin).add(z.cos.mul(z.cos)), complex(1.0, 0.0)) and near(z.sin.asin, z) and near(z.cos.acos, z) and near(z.tan.atan, z)
test hyperbolic = do
  z = complex(0.4, -0.2)
  near(z.cosh.mul(z.cosh).sub(z.sinh.mul(z.sinh)), complex(1.0, 0.0)) and near(z.sinh.asinh, z) and near(z.cosh.acosh, z) and near(z.tanh.atanh, z)
test transform = do
  f = dft([1.0, 0.0, 0.0, 0.0])
  f.all(c => near(c, complex(1.0, 0.0))) and near(dft([1.0, 2.0, 3.0, 4.0])[0], complex(10.0, 0.0))
test polynomial = horner([complex(1.0, 0.0), complex(0.0, 0.0), complex(1.0, 0.0)], i()).abs < 0.000000000001
test fractal = mandel(complex(0.0, 0.0), 50) == 50 and mandel(complex(1.0, 1.0), 50) < 5
test show = "{complex(1.5, -2.0)}" == "Complex\{re: 1.5, im: -2.0}" and complex(0.0, 0.0).pow(complex(0.0, 0.0)) == complex(1.0, 0.0)
test fields = complex(1.0, 2.0).conj.im == -2.0 and complex(1.0, 2.0).neg.re == -1.0 and reals(complex(0.0, -1.0)).1 == -pi() / 2.0
test json_round = json.decode[Complex](json.encode(complex(1.25, -3.0))) == ok(complex(1.25, -3.0))
