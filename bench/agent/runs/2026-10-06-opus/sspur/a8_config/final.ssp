type CfgErr = Missing{key: Str} | NotInt{key: Str, value: Str} | NotBool{key: Str, value: Str}

type Entry = {key: Str, value: Str}

fn get_bool(cfg: List[Entry], key: Str, default: Bool) -> Bool ! fail[CfgErr]
= match lookup(cfg, key)
| none => default
| some(v) => match v.lower
| "true" => true
| "yes" => true
| "1" => true
| "false" => false
| "no" => false
| "0" => false
| _ => raise NotBool{key: key, value: v}

fn get_int(cfg: List[Entry], key: Str) -> Int ! fail[CfgErr]
= do
  v = get_str(cfg, key)
  if not is_int_text(v) then raise NotInt{key: key, value: v}
  match v.to_int
  | some(n) => n
  | none => raise NotInt{key: key, value: v}

fn get_str(cfg: List[Entry], key: Str) -> Str ! fail[CfgErr]
= lookup(cfg, key).ok_or(Missing{key: key})

fn is_int_text(s: Str) -> Bool
= do
  cs = s.chars
  body = if cs.len > 0 and cs[0] == "-" then cs.drop(1) else cs
  not body.is_empty and body.all(c => "0123456789".contains(c))

fn keys(cfg: List[Entry]) -> List[Str]
= cfg.map(_.key).unique

fn lookup(cfg: List[Entry], key: Str) -> Opt[Str]
= cfg.filter(_.key == key).last.map(_.value)

fn main() -> Unit ! log
= log(keys(parse(sample_text())).join(","))

fn parse(text: Str) -> List[Entry]
= text.split(";").map(parse_line).filter(_.is_some).map(_.get)

fn parse_line(line: Str) -> Opt[Entry]
= do
  t = line.trim
  if t.starts_with("#") then return none
  parts = t.split("=")
  if parts.len < 2 then return none
  k = parts[0].trim
  if k.is_empty then return none
  v = parts.drop(1).join("=").trim
  some(Entry{key: k, value: v})

fn sample_text() -> Str
= "host=localhost;port=8080;debug=true"

test bool_bad = catch get_bool(parse("a=maybe"), "a", true) == true
| NotBool{key, value} => key == "a" and value == "maybe"
| _ => false

test bool_default = get_bool(parse("a=1"), "z", true) and not get_bool(parse("a=1"), "z", false)

test bool_vals = get_bool(parse("a=TRUE"), "a", false) and get_bool(parse("b=yes"), "b", false) and get_bool(parse("c=1"), "c", false) and not get_bool(parse("d=False"), "d", true) and not get_bool(parse("e=NO"), "e", true) and not get_bool(parse("f=0"), "f", true)

test comments = keys(parse("# c=1; #x;a=2")) == ["a"]

test first_eq = lookup(parse("url=a=b"), "url") == some("a=b")

test int_bad = catch get_int(parse("p=12x"), "p") == 0
| NotInt{key, value} => key == "p" and value == "12x"
| _ => false

test int_dash = catch get_int(parse("p=-"), "p") == 0
| NotInt{key, value} => value == "-"
| _ => false

test int_missing = catch get_int(parse("p=1"), "q") == 0
| Missing{key} => key == "q"
| _ => false

test int_ok = get_int(parse("p=8080"), "p") == 8080 and get_int(parse("n=-12"), "n") == -12

test keys_order = keys(parse("a=1;b=2;a=3")) == ["a", "b"]

test last_wins = lookup(parse("a=1;b=2;a=3"), "a") == some("3")

test lookup_host = lookup(parse(sample_text()), "host") == some("localhost")

test missing = catch get_str(parse(sample_text()), "nope") == ""
| Missing{key} => key == "nope"

test parse_sample = parse(sample_text()).len == 3

test skip_bad = keys(parse("novalue; =x;  = y ;a=1;")) == ["a"]

test trim_ws = lookup(parse("  host = example.com  ; port=1"), "host") == some("example.com")
