type Game = {room: Str, rooms: List[Room], inventory: List[Str], moves: Int}

type Room = {name: Str, exits: List[(Str, Str)], items: List[Str], locked: List[Str]}

fn current(g: Game) -> Room
= g.rooms.find(_.name == g.room).get

fn dispatch(g: Game, w: List[Str]) -> (Game, Str)
= if w.len == 1 and w[0] == "look" then (g, look(g)) else if w.len == 1 and w[0] == "inventory" then (g, inventory_text(g)) else if w.len == 2 and w[0] == "go" then go(g, w[1]) else if w.len == 2 and w[0] == "take" then take_item(g, w[1]) else if w.len == 2 and w[0] == "drop" then drop_item(g, w[1]) else (g, "I don't understand.")

fn drop_item(g: Game, item: Str) -> (Game, Str)
= if g.inventory.contains(item) then do
    g2 = g with rooms := set_room_items(g, current(g).items.push(item)), inventory := g.inventory.filter(_ != item)
    (g2, "Dropped.")
  else (g, "You don't have {item}.")

fn go(g: Game, dir: Str) -> (Game, Str)
= match current(g).exits.find(_.0 == dir)
| some(e) => if current(g).locked.contains(dir) and not g.inventory.contains("key") then (g, "The door is locked.") else do
  g2 = g with room := e.1, moves := g.moves + 1
  (g2, look(g2))
| none => (g, "You can't go that way.")

fn inventory_text(g: Game) -> Str
= if g.inventory.len == 0 then "You carry nothing." else "You carry: " + g.inventory.sort.join(", ") + "."

fn look(g: Game) -> Str
= do
  r = current(g)
  base = "You are in the {r.name}. Exits: " + r.exits.map(_.0).sort.join(", ") + "."
  if r.items.len == 0 then base else base + " Items: " + r.items.sort.join(", ") + "."

fn main() -> Unit ! log
= do
  for line in play(["look", "go east", "go west"])
    log(line)

fn new_game() -> Game
= Game{room: "hall", rooms: world(), inventory: [], moves: 0}

fn play(cmds: List[Str]) -> List[Str]
= run(cmds).1

fn run(cmds: List[Str]) -> (Game, List[Str])
= do
  var g = new_game()
  var out = []
  for c in cmds
    (g2, msg) = step(g, c)
    g := g2
    out := out.push(msg)
  (g, out)

fn score(g: Game) -> Int
= g.inventory.len * 10 + (if g.room == "vault" then 25 else 0)

fn set_room_items(g: Game, items: List[Str]) -> List[Room]
= g.rooms.map(r => if r.name == g.room then r with items := items else r)

fn step(g: Game, cmd: Str) -> (Game, Str)
= do
  w = cmd.trim.lower.split(" ").filter(_.len > 0)
  dispatch(g, w)

fn take_item(g: Game, item: Str) -> (Game, Str)
= if current(g).items.contains(item) then do
    g2 = g with rooms := set_room_items(g, current(g).items.filter(_ != item)), inventory := g.inventory.push(item)
    (g2, "Taken.")
  else (g, "There is no {item} here.")

fn world() -> List[Room]
= [Room{name: "hall", exits: [("north", "vault"), ("east", "kitchen")], items: [], locked: ["north"]}, Room{name: "kitchen", exits: [("west", "hall")], items: ["key", "bread"], locked: []}, Room{name: "vault", exits: [("south", "hall")], items: ["gold"], locked: []}]

test blocked = play(["go up"]) == ["You can't go that way."]

test counts_moves = run(["go east", "go west"]).0.moves == 2

test empty_cmd = play(["", "   ", "dance", "go", "take"]) == ["I don't understand.", "I don't understand.", "I don't understand.", "I don't understand.", "I don't understand."]

test forgiving = play(["  GO   East "]) == ["You are in the kitchen. Exits: west. Items: bread, key."]

test inventory_cmd = play(["inventory", "go east", "take key", "TAKE bread", "inventory"]) == ["You carry nothing.", "You are in the kitchen. Exits: west. Items: bread, key.", "Taken.", "Taken.", "You carry: bread, key."]

test locked_door = run(["go north"]) == (new_game(), ["The door is locked."])

test locked_no_move = run(["go north"]).0.moves == 0

test look_items = play(["go east", "look"]).last == some("You are in the kitchen. Exits: west. Items: bread, key.")

test score_items = score(run(["go east", "take key", "take bread"]).0) == 20

test score_start = score(new_game()) == 0

test score_vault = score(run(["go east", "take key", "go west", "go north"]).0) == 35

test starts_in_hall = play(["look"]) == ["You are in the hall. Exits: east, north."]

test take_drop = play(["go east", "take key", "look", "drop key", "look"]) == ["You are in the kitchen. Exits: west. Items: bread, key.", "Taken.", "You are in the kitchen. Exits: west. Items: bread.", "Dropped.", "You are in the kitchen. Exits: west. Items: bread, key."]

test take_missing = play(["take key", "drop key"]) == ["There is no key here.", "You don't have key."]

test unlocked = play(["go east", "take key", "go west", "go north"]).last == some("You are in the vault. Exits: south. Items: gold.")

test walks = play(["go east", "go west"]).last == some("You are in the hall. Exits: east, north.")
