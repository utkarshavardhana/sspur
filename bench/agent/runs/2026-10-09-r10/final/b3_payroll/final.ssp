type CsvErr = BadRow{line: Int} | BadNumber{line: Int, field: Str}

type Row = {name: Str, rate: Int, hours: Int}

fn data_lines(text: Str) -> List[(Int, Str)]
= text.split("\n").enumerate.filter(p => p.1.trim != "" and not (p.0 == 0 and p.1.trim == "name,rate,hours")).map(p => (p.0 + 1, p.1.trim))

fn err_msg(e: CsvErr) -> Str
= match e
| BadRow{line} => "line {line}: expected 3 fields"
| BadNumber{line, field} => "line {line}: bad {field}"

fn fields(line: Str) -> List[Str]
= line.split(",").map(s => s.trim)

fn is_num(s: Str) -> Bool
= match s.to_int
| some(n) => n >= 0
| none => false

fn line_err(n: Int, line: Str) -> Opt[CsvErr]
= do
  f = fields(line)
  if f.len != 3 then some(BadRow{line: n}) else if not is_num(f[1]) then some(BadNumber{line: n, field: "rate"}) else if not is_num(f[2]) then some(BadNumber{line: n, field: "hours"}) else none

fn main() -> Unit ! log
= log(catch report(parse(sample()))
| _ => "error")

fn mk_row(n: Int, line: Str) -> Row ! fail[CsvErr]
= do
  match line_err(n, line)
  | some(e) => raise e
  | none => 0
  f = fields(line)
  Row{name: f[0], rate: f[1].to_int.or(0), hours: f[2].to_int.or(0)}

fn parse(text: Str) -> List[Row] ! fail[CsvErr]
= do
  var rows = []
  for p in data_lines(text)
    rows := rows.push(mk_row(p.0, p.1))
  rows

fn parse_row(line: Str) -> Row
= do
  f = line.split(",")
  Row{name: f[0], rate: f[1].to_int.or(0), hours: f[2].to_int.or(0)}

fn pay(r: Row) -> Int
= if r.hours > 40 then r.rate * 40 + r.rate * 3 * (r.hours - 40) / 2 else r.rate * r.hours

fn report(rows: List[Row]) -> Str
= do
  sorted = rows.sort_by(r => (-pay(r), r.name))
  lines = sorted.map(r => "{r.name}: {pay(r)}")
  lines.push("total: {rows.map(pay).sum}").join("\n")

fn sample() -> Str
= "Beth,400,0\nDan,375,0\nKathy,400,10\nMark,500,20\nMary,550,22\nSusie,425,18"

fn validate(text: Str) -> List[Str]
= data_lines(text).map(p => line_err(p.0, p.1)).filter(o => o.is_some).map(o => err_msg(o.get))

test paid = pay(Row{name: "Mark", rate: 500, hours: 20}) == 10000

test paid_40 = pay(Row{name: "A", rate: 10, hours: 40}) == 400

test paid_ot = pay(Row{name: "A", rate: 10, hours: 50}) == 550

test paid_ot_odd = pay(Row{name: "A", rate: 5, hours: 41}) == 207

test parse_badhours = catch parse("a,1,-1") == []
| BadNumber{line, field} => line == 1 and field == "hours"
| _ => false

test parse_badrate = catch parse("a,1,1\n\nb,x,1") == []
| BadNumber{line, field} => line == 3 and field == "rate"
| _ => false

test parse_badrow = catch parse("name,rate,hours\na,1\n") == []
| BadRow{line} => line == 2
| _ => false

test parse_header_blank = parse(" name,rate,hours \n\n a , 5 , 2 \n   \nb,1,1") == [Row{name: "a", rate: 5, hours: 2}, Row{name: "b", rate: 1, hours: 1}]

test parsed = parse(sample()).len == 6 and parse(sample())[2] == Row{name: "Kathy", rate: 400, hours: 10}

test report_empty = report([]) == "total: 0"

test report_sorted = report(parse("b,10,1\na,10,1\nc,20,1")) == "c: 20\na: 10\nb: 10\ntotal: 40"

test reported = report(parse("Beth,400,0\nKathy,400,10")) == "Kathy: 4000\nBeth: 0\ntotal: 4000"

test validate_all = validate("name,rate,hours\na,1\nb,x,1\nc,1,1\nd,1,y") == ["line 2: expected 3 fields", "line 3: bad rate", "line 5: bad hours"]

test validate_ok = validate("a,1,1\n\nb,2,2") == []
