profile sys

res type File = {fd: Int} drop close
res type Tok = {id: Int}

fn close(f: File)
= ()

fn open(fd: Int) -> File
= File{fd}

fn consume(f: File) -> Int
= f.fd

fn eat(t: Tok) -> Int
= do
  Tok{id} = t
  id

fn size(f: &File) -> Int
= f.fd

fn bump(f: &mut File)
= do
  f.fd := f.fd + 1
  ()

type E = Bad
fn r(x: Int) -> Int ! fail[E]
= if x > 0 then raise Bad else x
fn f(x: Int) -> Int
= do
  a = open(1)
  n = catch consume(a) + r(x)
    | Bad => 0
  n + size(&a)
