type Ledger = {accounts: List[Str], txns: List[Txn]}

type LedgerErr = UnknownAccount{name: Str} | Unbalanced{id: Int, diff: Int} | TooFewPostings{id: Int} | DuplicateId{id: Int} | Overdrawn{account: Str, balance: Int} | UnknownTxn{id: Int}

type Posting = {account: Str, amount: Int}

type Txn = {id: Int, memo: Str, postings: List[Posting]}

fn add_txn(l: Ledger, t: Txn) -> Ledger ! fail[LedgerErr]
= do
  if t.postings.len < 2 then raise TooFewPostings{id: t.id}
  for x in t.postings
    if not l.accounts.contains(x.account) then raise UnknownAccount{name: x.account}
  diff = t.postings.map(_.amount).sum
  if diff != 0 then raise Unbalanced{id: t.id, diff: diff}
  if l.txns.any(x => x.id == t.id) then raise DuplicateId{id: t.id}
  for x in t.postings
    if x.account.starts_with("assets:") then do
      b = balance(l, x.account) + t.postings.filter(y => y.account == x.account).map(_.amount).sum
      if b < 0 then raise Overdrawn{account: x.account, balance: b}
  l with txns := l.txns.push(t)

fn balance(l: Ledger, account: Str) -> Int
= l.txns.flat_map(_.postings).filter(_.account == account).map(_.amount).sum

fn chart() -> List[Str]
= ["income:salary", "assets:bank", "expenses:food", "assets:cash", "equity:owner"]

fn history(l: Ledger, account: Str) -> List[(Int, Int)]
= do
  var bal = 0
  var out = []
  for t in l.txns
    mine = t.postings.filter(x => x.account == account)
    if not mine.is_empty then do
      bal := bal + mine.map(_.amount).sum
      out := out.push((t.id, bal))
  out

fn main() -> Unit ! log
= log(catch trial_balance(sample()).map(e => "{e.0} {e.1}").join("\n")
| _ => "error")

fn new_ledger() -> Ledger
= Ledger{accounts: chart(), txns: []}

fn p(account: Str, amount: Int) -> Posting
= Posting{account: account, amount: amount}

fn reverse(l: Ledger, id: Int, new_id: Int) -> Ledger ! fail[LedgerErr]
= do
  t = l.txns.find(x => x.id == id).ok_or(UnknownTxn{id: id})
  add_txn(l, Txn{id: new_id, memo: "reverse {id}", postings: t.postings.map(x => p(x.account, -x.amount))})

fn sample() -> Ledger ! fail[LedgerErr]
= add_txn(add_txn(new_ledger(), Txn{id: 1, memo: "open", postings: [p("assets:bank", 1000), p("equity:owner", -1000)]}), Txn{id: 2, memo: "lunch", postings: [p("expenses:food", 30), p("assets:bank", -30)]})

fn trial_balance(l: Ledger) -> List[(Str, Int)]
= l.accounts.map(a => (a, balance(l, a))).filter(e => e.1 != 0).sort_by(_.0)

test bank = catch balance(sample(), "assets:bank") == 970
| _ => false

test dup = catch add_txn(sample(), Txn{id: 1, memo: "x", postings: [p("assets:bank", 5), p("equity:owner", -5)]}).txns.len == 0
| DuplicateId{id} => id == 1
| _ => false

test few = catch add_txn(new_ledger(), Txn{id: 1, memo: "x", postings: [p("assets:bank", 0)]}).txns.len == 0
| TooFewPostings{id} => id == 1
| _ => false

test few_before_unknown = catch add_txn(new_ledger(), Txn{id: 4, memo: "x", postings: [p("nope", 5)]}).txns.len == 0
| TooFewPostings{id} => id == 4
| _ => false

test hist = catch history(sample(), "assets:bank") == [(1, 1000), (2, 970)]
| _ => false

test hist_none = catch history(sample(), "assets:cash") == []
| _ => false

test overdrawn = catch add_txn(sample(), Txn{id: 3, memo: "x", postings: [p("expenses:food", 2000), p("assets:bank", -2000)]}).txns.len == 0
| Overdrawn{account, balance} => account == "assets:bank" and balance == -1030
| _ => false

test rev = catch reverse(sample(), 2, 9).txns.last.get.memo == "reverse 2"
| _ => false

test rev_dup = catch reverse(sample(), 2, 1).txns.len == 0
| DuplicateId{id} => id == 1
| _ => false

test rev_overdrawn = catch reverse(sample(), 1, 9).txns.len == 0
| Overdrawn{account, balance} => account == "assets:bank" and balance == -30
| _ => false

test rev_unknown = catch reverse(sample(), 7, 9).txns.len == 0
| UnknownTxn{id} => id == 7
| _ => false

test tb = catch trial_balance(sample()) == [("assets:bank", 970), ("equity:owner", -1000), ("expenses:food", 30)]
| _ => false

test tb_hides_zero = catch trial_balance(reverse(sample(), 2, 3)) == [("assets:bank", 1000), ("equity:owner", -1000)]
| _ => false

test trial_sums_to_zero = catch trial_balance(sample()).map(_.1).sum == 0
| _ => false

test unbal = catch add_txn(new_ledger(), Txn{id: 2, memo: "x", postings: [p("equity:owner", -7), p("assets:bank", 5)]}).txns.len == 0
| Unbalanced{id, diff} => id == 2 and diff == -2
| _ => false

test unknown = catch add_txn(new_ledger(), Txn{id: 1, memo: "x", postings: [p("assets:gold", 5), p("equity:owner", -5)]}).txns.len == 0
| UnknownAccount{name} => name == "assets:gold"
