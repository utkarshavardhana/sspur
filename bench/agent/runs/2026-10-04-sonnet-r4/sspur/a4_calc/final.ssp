type CalcErr = Unbound{name: Str} | DivByZero

type Expr = Num{v: Int} | Var{name: Str} | Add{a: Expr, b: Expr} | Mul{a: Expr, b: Expr} | Sub{a: Expr, b: Expr} | Div{a: Expr, b: Expr}

fn collect_vars(e: Expr, acc: List[Str]) -> List[Str]
= match e
| Num{v} => acc
| Var{name} => if acc.find(_ == name).is_some then acc else acc + [name]
| Add{a, b} => collect_vars(b, collect_vars(a, acc))
| Mul{a, b} => collect_vars(b, collect_vars(a, acc))
| Sub{a, b} => collect_vars(b, collect_vars(a, acc))
| Div{a, b} => collect_vars(b, collect_vars(a, acc))

fn eval(e: Expr, env: List[(Str, Int)]) -> Int ! fail[CalcErr]
= match e
| Num{v} => v
| Var{name} => lookup(env, name).ok_or(Unbound{name: name})
| Add{a, b} => eval(a, env) + eval(b, env)
| Mul{a, b} => eval(a, env) * eval(b, env)
| Sub{a, b} => eval(a, env) - eval(b, env)
| Div{a, b} => do
  x = eval(a, env)
  y = eval(b, env)
  if y == 0 then raise DivByZero
  x / y

fn lookup(env: List[(Str, Int)], name: Str) -> Opt[Int]
= env.find(_.0 == name).map(_.1)

fn main() -> Unit ! log
= log(run(Add{a: Num{v: 2}, b: Mul{a: Var{name: "x"}, b: Num{v: 4}}}, [("x", 3)]))

fn run(e: Expr, env: List[(Str, Int)]) -> Str
= catch "{show(e)} = {eval(e, env)}"
| Unbound{name} => "{show(e)} = error: unbound {name}"
| DivByZero => "{show(e)} = error: division by zero"

fn show(e: Expr) -> Str
= match e
| Num{v} => v.str
| Var{name} => name
| Add{a, b} => "({show(a)} + {show(b)})"
| Mul{a, b} => "{show(a)} * {show(b)}"
| Sub{a, b} => "({show(a)} - {show(b)})"
| Div{a, b} => "{show(a)} / {show(b)}"

fn simplify(e: Expr) -> Expr
= match e
| Add{a: Num{v: 0}, b} => simplify(b)
| Add{a, b: Num{v: 0}} => simplify(a)
| Mul{a: Num{v: 1}, b} => simplify(b)
| Mul{a, b: Num{v: 1}} => simplify(a)
| Sub{a, b: Num{v: 0}} => simplify(a)
| Div{a, b: Num{v: 1}} => simplify(a)
| Add{a, b} => Add{a: simplify(a), b: simplify(b)}
| Mul{a, b} => Mul{a: simplify(a), b: simplify(b)}
| Sub{a, b} => Sub{a: simplify(a), b: simplify(b)}
| Div{a, b} => Div{a: simplify(a), b: simplify(b)}
| _ => e

fn var_names(e: Expr) -> List[Str]
= collect_vars(e, [])

test run_div = run(Div{a: Num{v: 7}, b: Num{v: 2}}, []) == "7 / 2 = 3"

test run_divzero = run(Div{a: Num{v: 7}, b: Sub{a: Num{v: 2}, b: Num{v: 2}}}, []) == "7 / (2 - 2) = error: division by zero"

test run_ok = run(Add{a: Num{v: 2}, b: Mul{a: Var{name: "x"}, b: Num{v: 4}}}, [("x", 3)]) == "(2 + x * 4) = 14"

test run_sub = run(Sub{a: Num{v: 7}, b: Var{name: "x"}}, [("x", 3)]) == "(7 - x) = 4"

test run_unbound = run(Var{name: "y"}, []) == "y = error: unbound y"

test simplify_children = show(simplify(Sub{a: Add{a: Num{v: 0}, b: Var{name: "p"}}, b: Div{a: Var{name: "q"}, b: Num{v: 1}}})) == "(p - q)"

test simplify_ok = show(simplify(Add{a: Num{v: 0}, b: Mul{a: Num{v: 1}, b: Var{name: "z"}}})) == "z"

test simplify_sub_div = show(simplify(Div{a: Sub{a: Var{name: "q"}, b: Num{v: 0}}, b: Num{v: 1}})) == "q"

test var_names_none = var_names(Num{v: 1}) == []

test var_names_order = var_names(Add{a: Mul{a: Var{name: "b"}, b: Var{name: "a"}}, b: Div{a: Var{name: "b"}, b: Sub{a: Num{v: 1}, b: Var{name: "c"}}}}) == ["b", "a", "c"]
