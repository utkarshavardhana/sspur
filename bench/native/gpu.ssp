kernel fn saxpy(a: F32, x: &[F32], y: &mut [F32]) @grid(y.len, 256)
= y[gid] := a * x[gid] + y[gid]

kernel fn partial_sums(x: &[F32], out: &mut [F32]) @grid(out.len, 256)
= do
  var acc = 0.0
  for k in 0..x.len / out.len
    acc := acc + x[gid + k * out.len]
  out[gid] := acc

kernel fn matmul(a: &[F32], b: &[F32], c: &mut [F32], n: Int) @grid(n * n, 64)
= do
  row = gid / n
  col = gid % n
  var acc = 0.0
  for k in 0..n
    acc := acc + a[row * n + k] * b[k * n + col]
  c[gid] := acc

kernel fn tree_sum(x: &[F32], out: &mut [F32]) @grid(x.len / 8, 256)
  pre out.len * 2048 == x.len
= do
  sh = shared[F32](256)
  base = group_id * 2048 + lid
  var acc = x[base]
  for j in 1..8
    acc := acc + x[base + j * 256]
  sh[lid] := acc
  barrier()
  for k in 0..8
    s = 128.shr(k)
    if lid < s then sh[lid] := sh[lid] + sh[lid + s]
    barrier()
  if lid == 0 then out[group_id] := sh[0]

kernel fn tiled(a: &[F32], b: &[F32], c: &mut [F32], n: Int) @grid2(n, n, 16, 16)
= do
  ta = shared[F32](256)
  tb = shared[F32](256)
  var acc = 0.0
  for t in 0..n / 16
    ta[lid.y * 16 + lid.x] := a[gid.y * n + t * 16 + lid.x]
    tb[lid.y * 16 + lid.x] := b[(t * 16 + lid.y) * n + gid.x]
    barrier()
    for k in 0..16
      acc := acc + ta[lid.y * 16 + k] * tb[k * 16 + lid.x]
    barrier()
  c[gid.y * n + gid.x] := acc

kernel fn histogram(x: &[I32], h: &mut [I32]) @grid(x.len, 256)
  pre h.len == 256
= do
  local = shared[I32](256)
  local.atomic_add(x[gid].to_int % 256, 1)
  barrier()
  h.atomic_add(lid, local[lid])

fn main() ! dev, log, io, time
= do
  n = 4194304
  t0 = mono_ns()
  x = dev_f32((0..n).map(i => (i % 1000).to_f64 * 0.001))
  y = dev_f32((0..n).map(i => (i % 7).to_f64))
  t1 = mono_ns()
  for r in 0..100
    saxpy(0.5, &x, &mut y)
  log("saxpy {y.to_list.sum}")
  t2 = mono_ns()
  parts = dev_f32((0..65536).map(i => 0.0))
  var total = 0.0
  for r in 0..100
    partial_sums(&y, &mut parts)
    total := total + parts.to_list.sum
  log("reduce {total}")
  t3 = mono_ns()
  m = 512
  a = dev_f32((0..m * m).map(i => (i % 17).to_f64 * 0.125 - 1.0))
  b = dev_f32((0..m * m).map(i => (i % 13).to_f64 * 0.25 - 1.5))
  c = dev_f32((0..m * m).map(i => 0.0))
  for r in 0..20
    matmul(&a, &b, &mut c, m)
  cs = c.to_list
  log("matmul {cs.sum} {cs[0]} {cs[m * m - 1]}")
  t4 = mono_ns()
  sums = dev_f32((0..n / 2048).map(i => 0.0))
  var tree = 0.0
  for r in 0..100
    tree_sum(&y, &mut sums)
    tree := tree + sums.to_list.sum
  log("tree {tree}")
  t5 = mono_ns()
  ct = dev_f32((0..m * m).map(i => 0.0))
  for r in 0..20
    tiled(&a, &b, &mut ct, m)
  ts = ct.to_list
  log("tiled {ts.sum} {ts[0]} {ts[m * m - 1]} {ts == cs}")
  t6 = mono_ns()
  xs = dev_i32((0..n).map(i => (i * 7919) % 1000003))
  hist = dev_i32((0..256).map(i => 0))
  t7 = mono_ns()
  for r in 0..20
    histogram(&xs, &mut hist)
  hs = hist.to_list
  log("hist {hs.sum} {hs[0]} {hs[17]} {hs[255]}")
  t8 = mono_ns()
  eprint("setup {(t1 - t0) / 1000000} ms, saxpy {(t2 - t1) / 1000000} ms, reduce {(t3 - t2) / 1000000} ms, matmul {(t4 - t3) / 1000000} ms, tree {(t5 - t4) / 1000000} ms, tiled {(t6 - t5) / 1000000} ms, hist {(t8 - t7) / 1000000} ms (+{(t7 - t6) / 1000000} ms setup)")
