fn hyper(x: F64) -> List[F64]
= [x.sinh, x.cosh, x.tanh, x.asinh, x.acosh, x.atanh, x.cbrt, x.exp2, x.expm1, x.log1p]

fn special(x: F64) -> List[F64]
= [x.erf, x.erfc, x.gamma, x.lgamma]

fn pairs(x: F64, y: F64) -> List[F64]
= [x.fmod(y), x.remainder(y), x.copysign(y), x.nextafter(y), x.fdim(y), x.fma(y, 1.0)]

fn int_bits(a: Int, k: Int) -> List[Int]
= [a.rotl(k), a.rotr(k), a.byteswap, a.saturating_add(k), a.saturating_sub(k), a.saturating_mul(k)]

fn close(a: F64, b: F64) -> Bool
= (a - b).abs < 0.000000001

fn normal_pdf(x: F64) -> F64
= (0.0 - x * x / 2.0).exp / (2.0 * pi()).sqrt

fn std_normal_cdf(x: F64) -> F64
= 0.5 * (1.0 + (x / 2.0.sqrt).erf)

fn factorial(n: Int) -> Int
= (n.to_f64 + 1.0).gamma.round

fn angle_wrap(deg: F64) -> F64
= deg.remainder(360.0)

test hyperbolic = close(1.0.sinh, 1.1752011936438014) and close(0.0.cosh, 1.0) and close(0.5.tanh.atanh, 0.5) and close(2.0.asinh.sinh, 2.0) and close(3.0.acosh.cosh, 3.0)
test roots = 27.0.cbrt == 3.0 and (0.0 - 8.0).cbrt == -2.0 and 10.0.exp2 == 1024.0
test small = close(0.000001.expm1, 0.0000010000005) and close(0.000001.log1p, 0.0000009999995)
test gamma_values = [1, 2, 3, 4, 5, 6].map(factorial) == [1, 2, 6, 24, 120, 720] and close(0.5.gamma, pi().sqrt) and close(10.0.lgamma, 362880.0.ln)
test cdf = close(std_normal_cdf(0.0), 0.5) and std_normal_cdf(1.96) > 0.975 and std_normal_cdf(1.96) < 0.9751 and close(normal_pdf(0.0), 0.3989422804014327)
test erfs = close(0.5.erf + 0.5.erfc, 1.0) and 0.0.erf == 0.0
test modulo = 7.5.fmod(2.0) == 1.5 and (0.0 - 7.5).fmod(2.0) == -1.5 and angle_wrap(370.0) == 10.0 and angle_wrap(190.0) == -170.0
test signs = 3.0.copysign(0.0 - 1.0) == -3.0 and 5.0.fdim(3.0) == 2.0 and 3.0.fdim(5.0) == 0.0
test next_up = 1.0.nextafter(2.0) > 1.0 and 1.0.nextafter(2.0) - 1.0 < 0.000000000000001
test fused = 2.0.fma(3.0, 4.0) == 10.0
test constants = close(pi(), 3.141592653589793) and close(euler().ln, 1.0) and inf().is_inf and nan().is_nan and not 1.0.is_inf and (0.0 - inf()) < 0.0
test rotations = 1.rotl(1) == 2 and 1.rotr(1) == -9223372036854775807 - 1 and 1.rotl(64) == 1 and 1.rotl(-1) == -9223372036854775807 - 1
test swap = 1.byteswap == 72057594037927936 and 72057594037927936.byteswap == 1
test saturate = 9223372036854775807.saturating_add(1) == 9223372036854775807 and (-9223372036854775807 - 1).saturating_sub(1) == -9223372036854775807 - 1 and 4611686018427387904.saturating_mul(-4) == -9223372036854775807 - 1 and 5.saturating_mul(6) == 30
test listed = int_bits(255, 8).len == 6 and hyper(0.5).len == 10 and special(1.5).len == 4 and pairs(5.0, 3.0).len == 6
