type TaskErr = NotFound{id: Int} | AlreadyDone{id: Int}

fn complete(ts: List[Task], id: Int) -> List[Task] ! fail[TaskErr]
= do
  t = ts.find(_.id == id).ok_or(NotFound{id})
  if t.done then raise AlreadyDone{id}
  ts.map(x => if x.id == id then x with done := true else x)

fn retitle(ts: List[Task], id: Int, title: Str) -> List[Task] ! fail[TaskErr]
= do
  t = ts.find(_.id == id).ok_or(NotFound{id})
  ts.map(x => if x.id == id then x with title := title else x)

fn label(p: Priority) -> Str
= match p
  | Low => "low"
  | Med => "med"
  | High => "high"

fn rank(p: Priority) -> Int
= match p
  | High => 0
  | Med => 1
  | Low => 2

fn by_priority(ts: List[Task]) -> List[Task]
= pending(ts).sort_by(t => rank(t.pri) * 1000000 + t.id)

fn clear_done(ts: List[Task]) -> List[Task]
= pending(ts)

fn render(t: Task) -> Str
= "{box(t)} #{t.id} ({label(t.pri)}) {t.title}"

fn main() -> Unit ! log
= log(render_all(catch complete(demo(), 1)
  | _ => demo()))

test complete_one = pending(complete(demo(), 2)).map(_.id) == [1, 3, 4]

test render_one = render(Task{id: 5, title: "nap", done: true, pri: Low}) == "[x] #5 (low) nap"

test render_high = render(Task{id: 2, title: "write report", done: false, pri: High}) == "[ ] #2 (high) write report"

test complete_missing = catch complete(demo(), 9) == []
  | NotFound{id} => id == 9
  | _ => false

test complete_twice = catch complete(complete(demo(), 1), 1) == []
  | AlreadyDone{id} => id == 1
  | _ => false

test by_pri = by_priority(demo()).map(_.id) == [2, 4, 3, 1]

test by_pri_skips_done = by_priority(complete(demo(), 2)).map(_.id) == [4, 3, 1]

test clear = clear_done(complete(demo(), 2)).map(_.id) == [1, 3, 4]

test retitle_ok = retitle(demo(), 3, "call al")[2].title == "call al"

test retitle_missing = catch retitle(demo(), 7, "x") == []
  | NotFound{id} => id == 7
  | _ => false
