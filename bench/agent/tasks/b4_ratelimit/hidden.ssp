fn h_drained(capacity: Int, rate: Int) -> Bucket ! fail[LimitErr]
= take(new_bucket(capacity, rate, 0), 0, capacity).1

fn h_keys(steps: List[(Str, Int)]) -> List[Bool] ! fail[LimitErr]
= do
  var k = new_keyed(2, 1)
  var out = []
  for s in steps
    (ok, k2) = take_key(k, s.0, s.1)
    out := out.push(ok)
    k := k2
  out

test hidden_window_limit = catch run_requests(new_window(2, 10), [0, 1, 2]) == [true, true, false]
  | _ => false

test hidden_window_reset = catch run_requests(new_window(2, 10), [0, 1, 2, 10, 11, 12]) == [true, true, false, true, true, false]
  | _ => false

test hidden_window_skew = catch run_requests(new_window(2, 10), [10, 3]) == []
  | ClockSkew{last, now} => last == 10 and now == 3
  | _ => false

test hidden_bucket_full = new_bucket(5, 1, 100).tokens == 5 and new_bucket(5, 1, 100).last == 100 and new_bucket(5, 1, 100).capacity == 5 and new_bucket(5, 1, 100).rate == 1

test hidden_take_ok = catch take(new_bucket(5, 1, 0), 0, 3).0 and take(new_bucket(5, 1, 0), 0, 3).1.tokens == 2
  | _ => false

test hidden_take_short = catch not take(take(new_bucket(5, 1, 0), 0, 3).1, 0, 3).0 and take(take(new_bucket(5, 1, 0), 0, 3).1, 0, 3).1.tokens == 2
  | _ => false

test hidden_refill = catch take(h_drained(5, 2), 2, 3).0 and take(h_drained(5, 2), 2, 3).1.tokens == 1 and take(h_drained(5, 2), 2, 3).1.last == 2
  | _ => false

test hidden_refill_cap = catch take(new_bucket(5, 2, 0), 100, 1).1.tokens == 4
  | _ => false

test hidden_failed_take_refills = catch not take(h_drained(5, 1), 3, 4).0 and take(h_drained(5, 1), 3, 4).1.tokens == 3 and take(h_drained(5, 1), 3, 4).1.last == 3
  | _ => false

test hidden_take_skew = catch take(new_bucket(5, 1, 10), 9, 1).0
  | ClockSkew{last, now} => last == 10 and now == 9
  | _ => false

test hidden_retry_now = catch retry_after(new_bucket(5, 1, 0), 0, 3) == 0
  | _ => false

test hidden_retry_wait = catch retry_after(h_drained(5, 2), 0, 3) == 2 and retry_after(h_drained(5, 2), 1, 3) == 1 and retry_after(h_drained(5, 2), 0, 4) == 2
  | _ => false

test hidden_retry_too_large = catch retry_after(new_bucket(5, 1, 0), 0, 6) == -1
  | TooLarge{n, capacity} => n == 6 and capacity == 5
  | _ => false

test hidden_retry_skew = catch retry_after(new_bucket(5, 1, 10), 4, 1) == -1
  | ClockSkew{last, now} => last == 10 and now == 4
  | _ => false

test hidden_keyed = catch h_keys([("x", 0), ("x", 0), ("x", 0), ("y", 0)]) == [true, true, false, true]
  | _ => false

test hidden_keyed_refill = catch h_keys([("x", 0), ("x", 0), ("x", 0), ("x", 3)]) == [true, true, false, true]
  | _ => false

test hidden_keyed_buckets = catch take_key(take_key(new_keyed(2, 1), "x", 0).1, "y", 5).1.buckets.len == 2 and new_keyed(3, 2).buckets == [] and new_keyed(3, 2).capacity == 3
  | _ => false
