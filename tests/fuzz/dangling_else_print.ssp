// The printer wrote `if a then (if b then x) else y` as `if a then if b then x else y`, so the else moved to the inner if.
// The optimizer prints and re-parses every module, so native code ran the wrong branch.

fn pick(a: Bool, b: Bool) -> Int ! log
= do
  var v = 0
  if a then do
    if b then v := 1
  else do
    log("outer else")
    v := 2
  v

fn always(n: Int) -> Int ! log
= do
  var hits = 0
  for i in 0..n % 5
    if [i].all(e => e == e) then do
      if i > 100 then hits := hits + 100
    else do
      log("never {i}")
  hits

test dangling = pick(true, false) == 0 and pick(false, true) == 2 and pick(true, true) == 1 and always(4) == 0
