// ANCHOR: curl
$ curl -s -w ' %{http_code}\n' -X POST localhost:8080/todos -d '{"id":"milk","title":"buy milk","done":false}'
{"id":"milk","title":"buy milk","done":false} 201
$ curl -s -w ' %{http_code}\n' localhost:8080/todos/milk
{"id":"milk","title":"buy milk","done":false} 200
$ curl -s -w ' %{http_code}\n' -X PUT localhost:8080/todos/milk -d '{"title":"buy oat milk","done":true}'
{"id":"milk","title":"buy oat milk","done":true} 200
$ curl -s -w ' %{http_code}\n' -X POST localhost:8080/todos -d '{"id":"milk","title":"again","done":false}'
{"error":{"tag":"Exists","id":"milk"}} 409
$ curl -s -w ' %{http_code}\n' -X POST localhost:8080/todos -d '{"id":"tea","title":"","done":false}'
{"error":"invalid request","detail":"contract violated: field 'title' of Todo where _.len > 0"} 400
$ curl -s -w ' %{http_code}\n' localhost:8080/todos
[{"id":"milk","title":"buy oat milk","done":true}] 200
$ curl -s -w ' %{http_code}\n' -X DELETE localhost:8080/todos/milk
 204
$ curl -s -w ' %{http_code}\n' localhost:8080/todos/milk
{"error":"not found"} 404
// ANCHOR_END: curl
