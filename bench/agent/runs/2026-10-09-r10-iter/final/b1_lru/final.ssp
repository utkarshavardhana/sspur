type Cache = {cap: Int, hits: Int, misses: Int, entries: List[Entry]}

type CacheErr = BadCapacity{cap: Int}

type Entry = {key: Str, value: Int}

fn describe(c: Cache) -> Str
= "cap={c.cap} [" + c.entries.map(e => "{e.key}={e.value}").join(", ") + "]"

fn get_or(c: Cache, key: Str, default: Int) -> (Int, Cache)
= do
  r = lookup(c, key)
  (r.0.or(default), r.1)

fn keys(c: Cache) -> List[Str]
= c.entries.map(_.key)

fn lookup(c: Cache, key: Str) -> (Opt[Int], Cache)
= match c.entries.find(_.key == key)
| some(e) => (some(e.value), touch(c, e))
| none => (none, c with misses := c.misses + 1)

fn main() -> Unit ! log, fail[CacheErr]
= log(describe(put(put(new_cache(2), "a", 1), "b", 2)))

fn new_cache(cap: Int) -> Cache ! fail[CacheErr]
= do
  if cap < 1 then raise BadCapacity{cap: cap}
  Cache{cap: cap, hits: 0, misses: 0, entries: []}

fn peek(c: Cache, key: Str) -> Opt[Int]
= c.entries.find(_.key == key).map(_.value)

fn put(c: Cache, key: Str, value: Int) -> Cache
= c with entries := trim_to(c.entries.filter(_.key != key).push(Entry{key: key, value: value}), c.cap)

fn resize(c: Cache, cap: Int) -> Cache ! fail[CacheErr]
= do
  if cap < 1 then raise BadCapacity{cap: cap}
  c with cap := cap, entries := trim_to(c.entries, cap)

fn size(c: Cache) -> Int
= c.entries.len

fn touch(c: Cache, e: Entry) -> Cache
= c with entries := c.entries.filter(_.key != e.key).push(e), hits := c.hits + 1

fn trim_to(entries: List[Entry], cap: Int) -> List[Entry]
= if entries.len > cap then entries.drop(entries.len - cap) else entries

test described = describe(put(new_cache(3), "x", 7)) == "cap=3 [x=7]"

test get_or_counters = do
  c = put(new_cache(2), "a", 1)
  r = get_or(c, "z", 0)
  r2 = get_or(r.1, "a", 0)
  r2.1.hits == 1 and r2.1.misses == 1 and r2.0 == 1

test get_or_hit = get_or(put(new_cache(2), "a", 5), "a", -1).0 == 5

test lookup_counters = do
  c = put(new_cache(2), "a", 1)
  r = lookup(c, "a")
  r2 = lookup(r.1, "z")
  r2.1.hits == 1 and r2.1.misses == 1

test lookup_evict_order = keys(put(lookup(put(put(new_cache(2), "a", 1), "b", 2), "a").1, "c", 3)) == ["a", "c"]

test lookup_hit = lookup(put(new_cache(2), "a", 1), "a").0 == some(1)

test lookup_miss = get_or(new_cache(2), "z", -1).0 == -1

test lookup_miss_order = keys(lookup(put(put(new_cache(2), "a", 1), "b", 2), "z").1) == ["a", "b"]

test lookup_recency = keys(lookup(put(put(new_cache(2), "a", 1), "b", 2), "a").1) == ["b", "a"]

test new_bad = catch new_cache(0).cap == 1
| BadCapacity{cap} => cap == 0
| _ => false

test new_counters = new_cache(2).hits == 0 and new_cache(2).misses == 0

test peek_no_change = do
  c = put(put(new_cache(2), "a", 1), "b", 2)
  p = peek(c, "a")
  keys(c) == ["a", "b"] and c.hits == 0 and c.misses == 0

test peek_pure = do
  c = put(put(new_cache(2), "a", 1), "b", 2)
  peek(c, "a") == some(1) and peek(c, "z") == none

test put_evicts = keys(put(put(put(new_cache(2), "a", 1), "b", 2), "c", 3)) == ["b", "c"]

test put_no_counters = do
  c = put(put(new_cache(2), "a", 1), "a", 2)
  c.hits == 0 and c.misses == 0

test put_replace = keys(put(put(put(new_cache(2), "a", 1), "b", 2), "a", 9)) == ["b", "a"]

test put_replace_value = peek(put(put(new_cache(2), "a", 1), "a", 9), "a") == some(9)

test put_two = keys(put(put(new_cache(2), "a", 1), "b", 2)) == ["a", "b"]

test resize_bad = catch resize(new_cache(2), 0).cap == 1
| BadCapacity{cap} => cap == 0
| _ => false

test resize_cap = resize(new_cache(3), 5).cap == 5

test resize_grow_keeps = keys(resize(put(put(new_cache(2), "a", 1), "b", 2), 4)) == ["a", "b"]

test resize_shrink = keys(resize(put(put(put(new_cache(3), "a", 1), "b", 2), "c", 3), 1)) == ["c"]
