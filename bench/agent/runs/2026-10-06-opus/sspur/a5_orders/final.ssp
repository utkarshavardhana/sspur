type Line = {sku: Str, qty: Int where _ > 0, unit: Int where _ >= 0}

type Order = {id: Int, lines: List[Line], coupon: Str}

fn big_order(c: Str) -> Order
= Order{id: 9, lines: [Line{sku: "desk", qty: 1, unit: 20000}], coupon: c}

fn discount(o: Order) -> Int
= do
  g = gross(o)
  if o.coupon == "SAVE10" then g * 10 / 100 else if o.coupon == "BIG20" and g >= 10000 then g * 20 / 100 else 0

fn gross(o: Order) -> Int
= o.lines.map(_.qty * _.unit).sum

fn invoice(o: Order) -> Str
= "order {o.id}: gross {money(gross(o))}, discount {money(discount(o))}, shipping {money(shipping(o))}, tax {money(tax(o))}, total {money(total(o))}"

fn main() -> Unit ! log
= log(invoice(sample_order()))

fn money(cents: Int where _ >= 0) -> Str
= "{cents / 100}.{pad2(cents % 100)}"

fn net(o: Order) -> Int
= gross(o) - discount(o)

fn pad2(n: Int) -> Str
= if n < 10 then "0{n}" else n.str

fn sample_order() -> Order
= Order{id: 7, lines: [Line{sku: "pen", qty: 3, unit: 250}, Line{sku: "pad", qty: 2, unit: 1200}], coupon: ""}

fn shipping(o: Order) -> Int
= if net(o) >= 5000 or o.coupon == "FREESHIP" then 0 else 499

fn tax(o: Order) -> Int
= net(o) * 8 / 100

fn total(o: Order) -> Int
= net(o) + shipping(o) + tax(o)

fn with_coupon(c: Str) -> Order
= sample_order() with coupon := c

test discount_big20 = discount(big_order("BIG20")) == 4000 and shipping(big_order("BIG20")) == 0 and tax(big_order("BIG20")) == 1280 and total(big_order("BIG20")) == 17280

test discount_big20_boundary = discount(Order{id: 1, lines: [Line{sku: "a", qty: 1, unit: 10000}], coupon: "BIG20"}) == 2000

test discount_big20_small = discount(with_coupon("BIG20")) == 0

test discount_none = discount(sample_order()) == 0

test discount_other = discount(with_coupon("FREESHIP")) == 0 and discount(with_coupon("XYZ")) == 0

test discount_save10 = discount(with_coupon("SAVE10")) == 315 and tax(with_coupon("SAVE10")) == 226 and total(with_coupon("SAVE10")) == 2835 + 499 + 226

test freeship = shipping(with_coupon("FREESHIP")) == 0 and total(with_coupon("FREESHIP")) == 3150 + 252

test gross_sample = gross(sample_order()) == 3150

test invoice_sample = invoice(sample_order()) == "order 7: gross 31.50, discount 0.00, shipping 4.99, tax 2.52, total 39.01"

test invoice_save10 = invoice(with_coupon("SAVE10")) == "order 7: gross 31.50, discount 3.15, shipping 4.99, tax 2.26, total 35.60"

test money_pad = money(1205) == "12.05"

test shipping_uses_net = shipping(Order{id: 2, lines: [Line{sku: "a", qty: 1, unit: 5500}], coupon: "SAVE10"}) == 499

test total_sample = total(sample_order()) == 3150 + 499 + 252
