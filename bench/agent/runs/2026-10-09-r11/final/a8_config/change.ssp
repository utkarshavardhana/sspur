type CfgErr = Missing{key: Str} | NotInt{key: Str, value: Str} | NotBool{key: Str, value: Str}

fn lookup(cfg: List[Entry], key: Str) -> Opt[Str]
= cfg.filter(_.key == key).last.map(_.value)

fn parse_line(line: Str) -> Opt[Entry]
= do
  t = line.trim
  parts = t.split("=")
  if t.starts_with("#") || parts.len < 2 then none else make_entry(parts[0].trim, parts.drop(1).join("=").trim)

fn make_entry(key: Str, value: Str) -> Opt[Entry]
= if key.len == 0 then none else some(Entry{key: key, value: value})

fn is_int(s: Str) -> Bool
= do
  body = if s.starts_with("-") then s.drop(1) else s
  body.len > 0 && body.chars.all(c => "0123456789".contains(c))

fn get_int(cfg: List[Entry], key: Str) -> Int ! fail[CfgErr]
= do
  v = get_str(cfg, key)
  if !is_int(v) then raise NotInt{key: key, value: v}
  v.to_int.get

fn get_bool(cfg: List[Entry], key: Str, default: Bool) -> Bool ! fail[CfgErr]
= match lookup(cfg, key)
  | some(v) => parse_bool(key, v)
  | none => default

fn parse_bool(key: Str, v: Str) -> Bool ! fail[CfgErr]
= do
  l = v.lower
  if ["true", "yes", "1"].contains(l) then true
  else if ["false", "no", "0"].contains(l) then false
  else raise NotBool{key: key, value: v}

test trim_all = parse(" a = b ; c=d ").len == 2 && lookup(parse(" a = b "), "a") == some("b")

test skip_bad = parse("noeq; =x; ;a=1").len == 1

test first_eq = lookup(parse("url=a=b"), "url") == some("a=b")

test comments = parse("#x=1; # y=2;a=1").len == 1

test last_wins = lookup(parse("a=1;a=2"), "a") == some("2")

test keys_distinct = keys(parse("a=1;b=2;a=3")) == ["a", "b"]

test int_ok = catch get_int(parse("n=-42"), "n") == -42
| _ => false

test int_bad = catch get_int(parse("n=4x"), "n") == 0
| NotInt{key, value} => key == "n" && value == "4x"
| _ => false

test int_missing = catch get_int(parse("n=1"), "m") == 0
| Missing{key} => key == "m"
| _ => false

test int_dash = catch get_int(parse("n=-"), "n") == 0
| NotInt{key, value} => value == "-"
| _ => false

test bool_ok = catch get_bool(parse("a=YES;b=No;c=1"), "a", false) && !get_bool(parse("a=YES;b=No;c=1"), "b", true) && get_bool(parse("c=1"), "c", false)
| _ => false

test bool_default = catch get_bool(parse("a=1"), "z", true)
| _ => false

test bool_bad = catch get_bool(parse("a=maybe"), "a", true)
| NotBool{key, value} => value == "maybe"
| _ => false
