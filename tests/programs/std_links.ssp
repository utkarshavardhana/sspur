fn scratch(tag: Str) -> Str ! fs, env, time
= do
  root = "{trim_end_slash(env_var("TMPDIR").or("/tmp"))}/sspur_links_{tag}_{mono_ns()}"
  made = mkdir_all(root)
  root

fn trim_end_slash(p: Str) -> Str
= if p.ends_with("/") then p.take(p.len - 1) else p

fn why[T](r: Res[T, Str]) -> Str
= match r
  | ok(_) => "ok"
  | err(e) => e.split_once(": ").map(p => p.1).or(e)

fn cleanup(root: Str, names: List[Str]) -> Bool ! fs
= do
  gone = names.map(n => remove_file(root + "/" + n))
  remove_dir(root).is_ok

fn copying(tag: Str) -> List[Str] ! fs, env, time
= do
  d = scratch(tag)
  w = write_file(d + "/a.txt", "héllo\nworld\n")
  m = set_mode(d + "/a.txt", 416)
  c = copy_file(d + "/a.txt", d + "/b.txt")
  text = read_file(d + "/b.txt").or("?")
  mode = file_mode(d + "/b.txt").or(-1)
  over = write_file(d + "/c.txt", "a much longer previous content")
  c2 = copy_file(d + "/a.txt", d + "/c.txt")
  same = copy_file(d + "/a.txt", d + "/a.txt")
  missing = copy_file(d + "/nope", d + "/x.txt")
  dir = copy_file(d, d + "/y.txt")
  into = copy_file(d + "/a.txt", d + "/no/such/dir")
  res = [why(c), "{text == "héllo\nworld\n"}", "{mode}", why(c2), "{read_file(d + "/c.txt").or("?").len}", why(same), why(missing), why(dir), "{exists(d + "/y.txt")}", why(into)]
  ok = cleanup(d, ["a.txt", "b.txt", "c.txt"])
  res.push("{ok}")

fn linking(tag: Str) -> List[Str] ! fs, env, time
= do
  d = scratch(tag)
  w = write_file(d + "/t.txt", "target")
  l = symlink("t.txt", d + "/l")
  dangling = symlink("missing.txt", d + "/dang")
  again = symlink("t.txt", d + "/l")
  res = [why(l), why(again), read_link(d + "/l").or("?"), "{is_symlink(d + "/l")} {is_symlink(d + "/t.txt")} {is_symlink(d + "/nope")} {is_symlink(d + "/dang")}", "{exists(d + "/dang")} {exists(d + "/l")}", read_file(d + "/l").or("?"), why(read_link(d + "/t.txt")), why(read_link(d + "/nope")), read_link(d + "/dang").or("?"), "{file_mode(d + "/l") == file_mode(d + "/t.txt")}"]
  ok = cleanup(d, ["t.txt", "l", "dang"])
  res.push("{ok}")

fn modes(tag: Str) -> List[Str] ! fs, env, time
= do
  d = scratch(tag)
  p = d + "/m.sh"
  w = write_file(p, "#!/bin/sh\n")
  a = set_mode(p, 493)
  m1 = file_mode(p).or(-1)
  b = set_mode(p, 256)
  m2 = file_mode(p).or(-1)
  bad = set_mode(p, 4096 * 2)
  neg = set_mode(p, -1)
  gone = set_mode(d + "/none", 420)
  nul = set_mode(from_codes([97, 0, 98]).or(""), 420)
  res = [why(a), "{m1.format("o")}", "{m2.format("o")}", why(bad), why(neg), why(gone), why(nul), why(file_mode(d + "/none"))]
  ok = cleanup(d, ["m.sh"])
  res.push("{ok}")

test copy_files = copying("cp") == ["ok", "true", "416", "ok", "12", "same file", "not found", "is a directory", "false", "not found", "true"]
test symlinks = linking("ln") == ["ok", "already exists", "t.txt", "true false false true", "false true", "target", "not a symlink", "not found", "missing.txt", "true", "true"]
test permissions = modes("mode") == ["ok", "755", "400", "mode out of range", "mode out of range", "not found", "invalid path", "not found", "true"]
