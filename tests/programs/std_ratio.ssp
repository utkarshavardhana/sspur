fn r(n: Int, d: Int) -> Ratio
= ratio(n, d)

fn harmonic(n: Int) -> Ratio
= (1..n + 1).fold(ratio(0, 1), (acc, k) => acc.add(ratio(1, k)))

fn egyptian(x: Ratio, limit: Int) -> List[Int] ! div
= do
  var rest = x
  var out = []
  var k = 0
  while rest.sign > 0 and k < limit
    d = rest.inv.ceil
    out := out.push(d.to_int.or(0))
    rest := rest.sub(ratio_big(big(1), d))
    k := k + 1
  out

fn continued(x: Ratio, limit: Int) -> List[Int] ! div
= do
  var v = x
  var out = []
  var k = 0
  while k < limit
    f = v.floor
    out := out.push(f.to_int.or(0))
    frac = v.sub(ratio_big(f, big(1)))
    if frac.sign == 0 then k := limit else do
      v := frac.inv
      k := k + 1
  out

fn rounding(x: Ratio) -> (Int, Int, Int, Int)
= (x.floor.to_int.or(0), x.ceil.to_int.or(0), x.trunc.to_int.or(0), x.round.to_int.or(0))

fn show_all(xs: List[Ratio]) -> Str
= xs.map(x => x.str).join(" ")

test normalized = r(6, -8) == r(-3, 4) and r(6, -8).num == big(-3) and r(6, -8).den == big(4) and r(0, -5) == r(0, 1) and r(0, -5).den == big(1)
test arithmetic = r(1, 2).add(r(1, 3)) == r(5, 6) and r(1, 2).sub(r(3, 4)) == r(-1, 4) and r(2, 3).mul(r(9, 4)) == r(3, 2) and r(2, 3).div(r(4, 9)) == r(3, 2)
test unary = r(-3, 4).neg == r(3, 4) and r(-3, 4).abs == r(3, 4) and r(-3, 4).inv == r(-4, 3) and r(-3, 4).sign == -1 and r(0, 1).sign == 0 and r(8, 4).is_int and not r(1, 4).is_int
test powers = r(2, 3).pow(3) == r(8, 27) and r(-2, 3).pow(-3) == r(-27, 8) and r(5, 7).pow(0) == r(1, 1) and r(-1, 1).pow(-9223372036854775807 - 1) == r(1, 1)
test ordering = r(1, 3) < r(1, 2) and r(-1, 2) < r(-1, 3) and r(2, 4) <= r(1, 2) and r(7, 3) > r(2, 1) and [r(1, 2), r(1, 3), r(-1, 5), r(2, 3)].sort == [r(-1, 5), r(1, 3), r(1, 2), r(2, 3)] and min(r(1, 7), r(1, 8)) == r(1, 8)
test round_modes = rounding(r(7, 2)) == (3, 4, 3, 4) and rounding(r(5, 2)) == (2, 3, 2, 2) and rounding(r(-5, 2)) == (-3, -2, -2, -2) and rounding(r(-7, 3)) == (-3, -2, -2, -2) and rounding(r(4, 1)) == (4, 4, 4, 4)
test harmonic_sum = harmonic(10) == r(7381, 2520) and harmonic(30).den.str == "2329089562800"
test egyptian_fractions = egyptian(r(4, 13), 10) == [4, 18, 468] and egyptian(r(5, 121), 4) == [25, 757, 763309, 873960180913]
test continued_fraction = continued(r(415, 93), 10) == [4, 2, 6, 7] and continued(r(-7, 3), 10) == [-3, 1, 2]
test floats = r(1, 3).to_f64 == 1.0 / 3.0 and r(-2, 3).to_f64 == -2.0 / 3.0 and r(1, 10).to_f64 == 0.1 and r(0, 1).to_f64 == 0.0 and ratio_big(big(10).pow(400), big(3)).to_f64 == inf() and ratio_big(big(1), big(10).pow(400)).to_f64 == 0.0 and ratio_big(big(10).pow(300), big(7).pow(200)).to_f64 > 0.0
test decimals = r(1, 3).to_dec(5).str == "0.33333" and r(-5, 8).to_dec(2).str == "-0.62" and r(7, 1).to_dec(0).str == "7"
test display = show_all([r(3, 4), r(-6, 3), r(0, 9), r(10, -4)]) == "3/4 -2 0 -5/2" and "{r(1, 2)}" == "1/2" and [r(1, 2)].str == "[1/2]"
test parsing = parse_ratio(" -6/8 ") == some(r(-3, 4)) and parse_ratio("+12") == some(r(12, 1)) and parse_ratio("1/0") == none and parse_ratio("1/-2") == none and parse_ratio("a/2") == none and parse_ratio("") == none and parse_ratio("3/") == none and parse_ratio("1/2/3") == none
test collections = [r(1, 2), r(2, 4), r(1, 3)].to_set.len == 2 and empty_map().put(r(1, 2), "half").get(r(2, 4)) == some("half") and [r(1, 2), r(2, 4)].unique.len == 1
test encode = json.encode(r(-3, 4)) == "\{\"num\":-3,\"den\":4}"
test big_parts = ratio_big(big(10).pow(30), big(10).pow(28)) == r(100, 1) and ratio_big(big(2).pow(70), big(6)).num.str == "590295810358705651712"
