type Student = {name: Str, scores: List[Int]}

fn average(s: Student) -> Int
= if s.scores.len == 0 then 0 else s.scores.sum / s.scores.len

fn curve(ss: List[Student], pts: Int) -> List[Student]
= ss.map(s => s with scores := s.scores.map(score => min(100, score + pts)))

fn drop_lowest(s: Student) -> Student
= if s.scores.len < 2 then s else do
  min_val = s.scores.min.get
  min_idx = s.scores.index_of(min_val).get
  new_scores = s.scores.take(min_idx) + s.scores.drop(min_idx + 1)
  s with scores := new_scores

fn grade(s: Student) -> Str
= letter(average(s))

fn honor_roll(ss: List[Student]) -> List[Str]
= ss.filter(s => grade(drop_lowest(s)) == "A").map(_.name).sort

fn letter(avg: Int) -> Str
= if avg >= 90 then "A" else if avg >= 80 then "B" else if avg >= 70 then "C" else if avg >= 60 then "D" else "F"

fn main() -> Unit ! log
= log(roster().map(report_card).join("\n"))

fn ranking(ss: List[Student]) -> List[Str]
= ss.sort_by(s => (-average(s), s.name)).map(_.name)

fn report_card(s: Student) -> Str
= "{s.name}: {average(s)} ({grade(s)})"

fn roster() -> List[Student]
= [Student{name: "mia", scores: [88, 92, 95]}, Student{name: "ali", scores: [70, 65, 80]}, Student{name: "zed", scores: [95, 90, 50]}, Student{name: "bo", scores: [100, 92, 89]}]

test avg_no_scores = average(Student{name: "x", scores: []}) == 0

test card = report_card(Student{name: "x", scores: [50, 60]}) == "x: 55 (F)"

test curve_adds_points = curve([Student{name: "x", scores: [80, 90]}], 10)[0].scores == [90, 100]

test curve_caps_at_100 = curve([Student{name: "x", scores: [95, 99]}], 10)[0].scores == [100, 100]

test drop_lowest_empty = drop_lowest(Student{name: "x", scores: []}).scores == []

test drop_lowest_one = drop_lowest(Student{name: "x", scores: [10, 20, 30]}).scores == [20, 30]

test drop_lowest_single = drop_lowest(Student{name: "x", scores: [50]}).scores == [50]

test honor_roll_empty = honor_roll([]) == []

test honor_roll_with_a = honor_roll([Student{name: "alice", scores: [95, 90, 92]}, Student{name: "bob", scores: [85, 80]}]) == ["alice"]

test letter_b = letter(85) == "B"

test letter_thresholds_a = letter(90) == "A"

test letter_thresholds_b = letter(80) == "B"

test letter_thresholds_c = letter(70) == "C"

test letter_thresholds_d = letter(60) == "D"

test letter_thresholds_f = letter(59) == "F"

test rank_order = ranking(roster()).take(2) == ["bo", "mia"]

test ranking_tie = ranking([Student{name: "zed", scores: [80, 80]}, Student{name: "alice", scores: [80, 80]}]) == ["alice", "zed"]
