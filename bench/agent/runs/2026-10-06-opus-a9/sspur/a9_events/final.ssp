type Event = {ts: Int, level: Str, msg: Str}

type EventErr = BadJson{text: Str}

fn count_by_level(evs: List[Event]) -> List[(Str, Int)]
= evs.map(_.level).counts

fn from_json(s: Str) -> List[Event] ! fail[EventErr]
= match json.decode[List[Event]](s)
| ok(evs) => evs
| err(_) => raise BadJson{text: s}

fn ingest(lines: List[Str]) -> List[Event] ! log
= do
  var out = []
  for l in lines
    match parse_line(l)
    | some(e) => out := out.push(e)
    | none => log("skip: " + l)
  out

fn main() -> Unit ! log
= log(count_by_level(ingest(sample())).map(p => "{p.0}={p.1}").join(","))

fn parse_line(line: Str) -> Opt[Event]
= match regex("^\\[(\\d+)\\] ([A-Z]+):([\\s\\S]*)$")
| err(_) => none
| ok(re) => match re.captures(line)
| none => none
| some(g) => match g[1].to_int
| some(ts) => some(Event{ts: ts, level: g[2], msg: g[3].trim})
| none => none

fn redact(e: Event) -> Event
= match regex("[A-Za-z0-9._-]+@[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+")
| err(_) => e
| ok(re) => e with msg := re.replace(e.msg, "<email>")

fn sample() -> List[Str]
= ["[1] INFO: start", "[2] WARN: disk low", "oops", "3|INFO|done", "[3] INFO: done"]

fn skipped(lines: List[Str]) -> List[Str]
= lines.filter(l => parse_line(l).is_none)

fn to_json(evs: List[Event]) -> Str
= json.encode(evs)

test counts = count_by_level([Event{ts: 1, level: "B", msg: ""}, Event{ts: 2, level: "A", msg: ""}, Event{ts: 3, level: "B", msg: ""}]) == [("B", 2), ("A", 1)]

test ingest_sample = ingest(sample()).len == 3

test json_bad = catch from_json("nope") == []
| BadJson{text} => text == "nope"

test json_bad_shape = ["\{\"ts\":1,\"level\":\"INFO\",\"msg\":\"up\"}", "[\{\"ts\":\"1\",\"level\":\"INFO\",\"msg\":\"up\"}]", "[\{\"ts\":1.5,\"level\":\"INFO\",\"msg\":\"up\"}]", "[\{\"ts\":1,\"level\":\"INFO\"}]", "[\{\"ts\":1,\"level\":2,\"msg\":\"up\"}]"].all(s => catch from_json(s) == [Event{ts: 0, level: "", msg: ""}]
| BadJson{text} => text == s)

test json_empty = to_json([]) == "[]"

test json_out = to_json([Event{ts: 1, level: "INFO", msg: "up"}, Event{ts: 2, level: "WARN", msg: "a \"b\""}]) == "[\{\"ts\":1,\"level\":\"INFO\",\"msg\":\"up\"},\{\"ts\":2,\"level\":\"WARN\",\"msg\":\"a \\\"b\\\"\"}]"

test json_roundtrip = do
  evs = [Event{ts: 1, level: "INFO", msg: "up"}, Event{ts: 2, level: "WARN", msg: "x"}]
  from_json(to_json(evs)) == evs

test parse_bad = parse_line("x|INFO|up").is_none

test parse_empty_msg = parse_line("[7] ERROR:") == some(Event{ts: 7, level: "ERROR", msg: ""})

test parse_ok = parse_line("[5] INFO: up") == some(Event{ts: 5, level: "INFO", msg: "up"})

test parse_old = parse_line("5|INFO|up").is_none

test parse_rejects = [parse_line("[] INFO: x"), parse_line("[1] info: x"), parse_line("[a] INFO: x"), parse_line("[1] INFO x"), parse_line("x[1] INFO: y")].all(_.is_none)

test parse_trim = parse_line("[12] WARN:   disk low  ") == some(Event{ts: 12, level: "WARN", msg: "disk low"})

test redact_emails = redact(Event{ts: 1, level: "INFO", msg: "mail a.b_c-d@ex-1.co.uk and x@y.z now"}) == Event{ts: 1, level: "INFO", msg: "mail <email> and <email> now"}

test redact_none = redact(Event{ts: 1, level: "INFO", msg: "a@b and @c.d"}).msg == "a@b and @c.d"

test skipped_lines = skipped(sample()) == ["oops", "3|INFO|done"]
