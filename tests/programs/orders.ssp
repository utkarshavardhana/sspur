type Item = {sku: Str, qty: Int where _ > 0, price: Int where _ >= 0}
type Order = {id: Str, items: List[Item] where _.len > 0}
type OrderErr = OutOfStock{sku: Str, wanted: Int, have: Int} | Unknown{sku: Str}

fn total(items: List[Item]) -> Int
  post r >= 0
= items.map(_.price * _.qty).sum

fn check_stock(stock: Map[Str, Int], i: Item) -> Unit ! fail[OrderErr]
= match stock.get(i.sku)
  | none => raise Unknown{sku: i.sku}
  | some(have) if have < i.qty => raise OutOfStock{sku: i.sku, wanted: i.qty, have}
  | some(_) => ()

fn place(stock: Map[Str, Int], o: Order) -> Map[Str, Int] ! fail[OrderErr]
= do
  for i in o.items
    check_stock(stock, i)
  o.items.fold(stock, (s, i) => s.put(i.sku, s.get(i.sku).or(0) - i.qty))

fn summary(left: Map[Str, Int], o: Order) -> Str
= "placed {o.id} for {total(o.items)}, stock now {left.items}"

fn try_place(stock: Map[Str, Int], o: Order) -> Str
= catch summary(place(stock, o), o)
  | OutOfStock{sku, wanted, have} => "short on {sku}: wanted {wanted}, have {have}"
  | Unknown{sku} => "unknown sku {sku}"

fn stock() -> Map[Str, Int]
= empty_map().put("apple", 5).put("pear", 1)

fn main() -> Unit ! log
= do
  log(try_place(stock(), Order{id: "o1", items: [Item{sku: "apple", qty: 2, price: 3}]}))
  log(try_place(stock(), Order{id: "o2", items: [Item{sku: "pear", qty: 3, price: 1}]}))
  log(try_place(stock(), Order{id: "o3", items: [Item{sku: "kiwi", qty: 1, price: 1}]}))

test total_ok = total([Item{sku: "a", qty: 2, price: 3}, Item{sku: "b", qty: 1, price: 4}]) == 10
test short = try_place(stock(), Order{id: "o2", items: [Item{sku: "pear", qty: 3, price: 1}]}) == "short on pear: wanted 3, have 1"
test unknown = try_place(stock(), Order{id: "o3", items: [Item{sku: "kiwi", qty: 1, price: 1}]}) == "unknown sku kiwi"
test stock_drops = catch place(stock(), Order{id: "o1", items: [Item{sku: "apple", qty: 2, price: 1}]}).get("apple") == some(3)
  | _ => false
