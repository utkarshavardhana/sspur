type CsvErr = BadRow{line: Int} | BadNumber{line: Int, field: Str}

type Row = {name: Str, rate: Int, hours: Int}

fn bad(n: Int, line: Str) -> Opt[CsvErr]
= do
  f = fields(line)
  if f.len != 3 then some(BadRow{line: n}) else if not nonneg(f[1]) then some(BadNumber{line: n, field: "rate"}) else if not nonneg(f[2]) then some(BadNumber{line: n, field: "hours"}) else none

fn describe(e: CsvErr) -> Str
= match e
| BadRow{line} => "line {line}: expected 3 fields"
| BadNumber{line, field} => "line {line}: bad {field}"

fn entries(text: Str) -> List[(Int, Str)]
= text.split("\n").enumerate.map(p => (p.0 + 1, p.1.trim)).filter(p => p.1 != "" and not (p.0 == 1 and p.1 == "name,rate,hours"))

fn fields(line: Str) -> List[Str]
= line.split(",").map(_.trim)

fn main() -> Unit ! log, fail[CsvErr]
= log(report(parse(sample())))

fn msg_of(n: Int, line: Str) -> List[Str]
= match bad(n, line)
| some(e) => [describe(e)]
| none => []

fn nonneg(s: Str) -> Bool
= s.to_int.map(_ >= 0).or(false)

fn parse(text: Str) -> List[Row] ! fail[CsvErr]
= entries(text).map(p => parse_row(p.0, p.1))

fn parse_row(n: Int, line: Str) -> Row ! fail[CsvErr]
= do
  match bad(n, line)
  | some(e) => raise e
  | none => 0
  f = fields(line)
  Row{name: f[0], rate: f[1].to_int.or(0), hours: f[2].to_int.or(0)}

fn pay(r: Row) -> Int
= if r.hours > 40 then r.rate * 40 + r.rate * 3 * (r.hours - 40) / 2 else r.rate * r.hours

fn report(rows: List[Row]) -> Str
= do
  sorted = rows.sort_by(r => (-pay(r), r.name))
  lines = sorted.map(r => "{r.name}: {pay(r)}")
  lines.push("total: {rows.map(pay).sum}").join("\n")

fn sample() -> Str
= "Beth,400,0\nDan,375,0\nKathy,400,10\nMark,500,20\nMary,550,22\nSusie,425,18"

fn validate(text: Str) -> List[Str]
= entries(text).flat_map(p => msg_of(p.0, p.1))

test bad_hours = catch parse("Beth,400,10\nDan,5,-1") == []
| BadNumber{line, field} => line == 2 and field == "hours"
| _ => false

test bad_rate = catch parse("name,rate,hours\n\nBeth,x,y") == []
| BadNumber{line, field} => line == 3 and field == "rate"
| _ => false

test bad_row = catch parse("name,rate,hours\nBeth,400") == []
| BadRow{line} => line == 2
| _ => false

test hdr_blank = parse("name,rate,hours\n\n Beth , 400 , 10 \n\n").len == 1 and parse("name,rate,hours\nBeth,400,10")[0] == Row{name: "Beth", rate: 400, hours: 10}

test no_hdr = parse("Beth,400,10")[0].hours == 10

test ot = pay(Row{name: "a", rate: 10, hours: 40}) == 400 and pay(Row{name: "a", rate: 10, hours: 50}) == 550 and pay(Row{name: "a", rate: 5, hours: 41}) == 207

test paid = pay(Row{name: "Mark", rate: 500, hours: 20}) == 10000

test parsed = parse(sample()).len == 6 and parse(sample())[2] == Row{name: "Kathy", rate: 400, hours: 10}

test rep = report(parse("Beth,400,0\nKathy,400,10\nAmy,400,10\nZed,500,10")) == "Zed: 5000\nAmy: 4000\nKathy: 4000\nBeth: 0\ntotal: 13000"

test rep_empty = report([]) == "total: 0"

test reported = report(parse("Beth,400,0\nKathy,400,10")) == "Kathy: 4000\nBeth: 0\ntotal: 4000"

test val = validate("name,rate,hours\nA,1\nB,x,2\n\nC,1,y\nD,1,2") == ["line 2: expected 3 fields", "line 3: bad rate", "line 5: bad hours"]

test val_ok = validate(sample()) == []
