fn withdraw_one(a: Account, amt: Int) -> Account ! fail[TxErr]
= do
  if amt <= 0 then raise Invalid
  if amt > a.balance then raise Insufficient{short: amt - a.balance}
  Account{id: a.id, balance: a.balance - amt}

fn apply_all(a: Account, amts: List[Int]) -> Account ! fail[TxErr]
= do
  var cur = a
  for amt in amts
    cur := withdraw_one(cur, amt)
  cur

test t17_ok = catch apply_all({id: "a", balance: 10}, [1, 2, 3]) == Account{id: "a", balance: 4}
  | _ => false
test t17_empty = catch apply_all({id: "a", balance: 10}, []) == Account{id: "a", balance: 10}
  | _ => false
test t17_short = catch apply_all({id: "a", balance: 10}, [5, 8, -1]) == Account{id: "a", balance: 0}
  | Invalid => false
  | Insufficient{short} => short == 3
test t17_inv = catch apply_all({id: "a", balance: 10}, [5, 0, 100]) == Account{id: "a", balance: 0}
  | Invalid => true
  | Insufficient{short: _} => false
