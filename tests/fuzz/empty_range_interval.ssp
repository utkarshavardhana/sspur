// An empty range gives its element the empty interval [0, -1]. The interval prover divided by the bound 0 and the compiler panicked.

fn plain(a: Int) -> Int
= (0..0).map(e => e / e).sum

fn guarded(a: Int) -> Int
= do
  var v = (if a > 3 then (0..0).map(e => e / e).sum else a - 1)
  v

test empty_range = plain(5) == 0 and guarded(5) == 0 and guarded(1) == 0
